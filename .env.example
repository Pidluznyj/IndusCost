# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INVENTORY_COLLECTOR_PUBLIC_BASE_URL: base publica do Stock Collector.
# Usada para montar o QR GERAL DE SETOR (deep-link /collector/sector/raw-material),
# lido pela camera NATIVA do tablet. Precisa ser a URL HTTPS absoluta que o tablet
# alcanca pelo Tailscale. Tem precedencia sobre APP_URL; sem base valida o servidor
# recusa gerar o QR (nunca emite path relativo). http:// so e aceito em localhost.
INVENTORY_COLLECTOR_PUBLIC_BASE_URL="https://MY_COLLECTOR_HOST"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Bootstrap Admin (acesso temporário para /settings)
BOOTSTRAP_ADMIN_ENABLED="false"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="trocar_em_producao"
BOOTSTRAP_ADMIN_SESSION_SECRET="trocar_por_um_segredo_longo"

# Nomus Sync V1 (propostas)
NOMUS_BASE_URL="https://seu-nomus.exemplo.com"
# Opcional: Authorization: Bearer <token>
NOMUS_TOKEN=""
# Opcional: cabeçalho customizado de autenticação, se necessário
NOMUS_AUTH_HEADER_NAME=""
NOMUS_AUTH_HEADER_VALUE=""
NOMUS_PAGE_SIZE="100"
NOMUS_MAX_RETRIES="10"
NOMUS_RETRY_BASE_MS="700"
# Timeout por tentativa HTTP Nomus (ms) — aplicado a toda chamada via
# fetchNomusJson (AR, AP, NF-e, pedidos, Documentos de Saída, Propostas).
# Sem opção de desligar: ausente/inválido cai no padrão (60000ms), nunca fica
# sem timeout. Limites: mínimo 1000ms, máximo 300000ms (5min); fora da faixa
# é ajustado (clamp) para o limite mais próximo, com aviso no log.
NOMUS_HTTP_TIMEOUT_MS="60000"

# SYNC-02 — Kill switches de reconciliação de ausências (fail-closed; default off).
# CREATE/UPDATE dos syncers NÃO dependem destas flags.
# NOMUS_SOURCE_RECONCILE_SALES_ORDERS_ENABLED="false"
# NOMUS_SOURCE_RECONCILE_AR_ENABLED="false"
# NOMUS_SOURCE_RECONCILE_AP_ENABLED="false"

# SYNC-07 — Excluir MISSING_CONFIRMED das visões operacionais (fail-closed; default off).
# Lifecycle continua sendo registrado mesmo com flags desligadas.
# NOMUS_OPS_EXCLUDE_MISSING_SALES_ORDERS_ENABLED="false"
# NOMUS_OPS_EXCLUDE_MISSING_AR_ENABLED="false"
# NOMUS_OPS_EXCLUDE_MISSING_AP_ENABLED="false"

# SYNC-08 — Backfill / reconcile histórico (locks e limite de páginas).
# NOMUS_LIFECYCLE_BACKFILL_LOCK_FILE="/tmp/induscost-nomus-lifecycle-backfill.lock"
# NOMUS_RECONCILE_MAX_PAGES="500"

# Sync financeiro Nomus (Contas a Pagar / Receber) — alinhado à chamada do Power BI.
# Tamanho de página financeiro (default 1000). Prioridade: NOMUS_FINANCIAL_PAGE_SIZE > NOMUS_PAGE_SIZE > 1000
NOMUS_FINANCIAL_PAGE_SIZE="1000"
# Janela de datas em dd/MM/yyyy (defaults: 01/01/2020 a 31/12/2030)
NOMUS_FINANCIAL_START_DATE="01/01/2020"
NOMUS_FINANCIAL_END_DATE="31/12/2030"
# apenasPendentes=false traz pagos e em aberto; ordenacao por dataVencimento
NOMUS_FINANCIAL_ONLY_PENDING="false"
NOMUS_FINANCIAL_ORDER_BY="dataVencimento"

# IndusCost local API used by Nomus sync scripts
INDUSCOST_BASE_URL="http://127.0.0.1:3000"

# Inteligência de Mercado — uploads de anexos de cotação (default: ./data/uploads)
# APP_UPLOADS_DIR="/var/lib/induscost/uploads"

# Coleta automática Brent (Yahoo Finance, sem API key). Default: habilitada.
# Desabilitar no servidor com false|0|off|no
# BRENT_COMMODITY_SCHEDULER_ENABLED="true"

# Coleta automática PTAX (BCB). Default: habilitada.
# Desabilitar no servidor com false|0|off|no
# PTAX_SNAPSHOT_SCHEDULER_ENABLED="true"

# Espelho assíncrono IndusCost → planilha online de matéria-prima (Power Automate).
# Default off. Unidirecional: planilha NÃO escreve no IndusCost.
# MATERIAL_STOCK_SPREADSHEET_MIRROR_ENABLED="false"
# MATERIAL_STOCK_SPREADSHEET_WEBHOOK_URL="https://prod-xx.westus.logic.azure.com/workflows/..."
# MATERIAL_STOCK_SPREADSHEET_WEBHOOK_SECRET=""
# Hosts permitidos (CSV). Default: logic.azure.com,api.powerautomate.com
# MATERIAL_STOCK_SPREADSHEET_ALLOWED_HOSTS="logic.azure.com,api.powerautomate.com"
# MATERIAL_STOCK_SPREADSHEET_HTTP_TIMEOUT_MS="15000"
# MATERIAL_STOCK_SPREADSHEET_MAX_ATTEMPTS="5"
# MATERIAL_STOCK_SPREADSHEET_WORKER_INTERVAL_MS="5000"
# MATERIAL_STOCK_SPREADSHEET_WORKER_BATCH_SIZE="5"

# ─── Cadeia de Suprimentos — Desempenho de Fornecedores (OP-26) ──────────────
# Avaliação do Pedido de Compra (4 critérios de 0 a 10) + consolidado derivado
# do fornecedor. Fail closed: ausente ou valor inválido = DESLIGADA.
# Com a flag OFF: nenhuma aba/menu/card novo, nenhuma chamada de API pelo
# frontend e as rotas novas respondem 404. Permissão ≠ feature flag: mesmo
# ligada, o backend continua exigindo operations.purchases (view/update) e,
# no consolidado, também finance.suppliers:view.
# Aceita: 1 | true | yes | on | enabled
# SUPPLY_CHAIN_SUPPLIER_PERFORMANCE_ENABLED="false"

# Central de Tesouraria — flags do catálogo (opt-in).
# Mestra AUSENTE = OFF. Ativar explicitamente:
# TREASURY_MODULE_ENABLED=1
# Ou manter desligada:
TREASURY_MODULE_ENABLED=0
# Subflags: com mestra ON e env ausente = ON; opt-out = 0|false|off|no
# Valores desconhecidos = fail-closed (OFF). Flag ID desconhecida = sempre OFF.
# Restart do processo é obrigatório após alterar estas variáveis.
# TREASURY_ACCOUNTS_ENABLED="1"
# TREASURY_BALANCES_ENABLED="1"
# TREASURY_DASHBOARD_ENABLED="1"
# TREASURY_RECEIVABLES_ENABLED="1"
# TREASURY_PAYABLES_ENABLED="1"
# TREASURY_PROJECTION_ENABLED="1"
# TREASURY_PROMISES_ENABLED="1"
# TREASURY_PAYABLES_PROGRAMMING_ENABLED="1"
# TREASURY_TRANSFERS_ENABLED="1"
# TREASURY_EXCEPTIONS_ENABLED="1"
# TREASURY_DAILY_CLOSING_ENABLED="1"
# TREASURY_RECONCILIATION_ENABLED="1"
# TREASURY_OFX_IMPORT_ENABLED="1"
# TREASURY_REPORTS_ENABLED="1"

# Nomus proposal sync controls
NOMUS_PROPOSAL_START_DATE="2025-01-01"
NOMUS_MAX_PAGES="200"
NOMUS_PRODUCTS_MAX_PAGES="200"
# Pós-sync: recálculo de margem comercial das propostas (tabela vigente na data).
# off | dry-run (default se omitido no código) | apply
# PROPOSAL_COMMERCIAL_MARGIN_RECALC_AFTER_SYNC="dry-run"
# Apply exige o token abaixo (mesmo do script standalone):
# PROPOSAL_COMMERCIAL_MARGIN_RECALC_CONFIRM="RECALCULATE_PROPOSAL_MARGINS"

# SYNC-07: sync horário de propostas (37 * * * *) — reusa o mesmo serviço do
# sync diário (02:00). Sem segredo aqui, só caminhos/flags de lock.
# NOMUS_PROPOSALS_SYNC_LOCK_FILE="/tmp/induscost-nomus-proposals.lock"
# 1 (default) = verifica o lock global diário/pedidos antes de rodar; 0 = não
# verifica (usado internamente por runNomusDailySync.sh, que já detém o lock).
# NOMUS_PROPOSALS_RESPECT_GLOBAL_LOCK="1"

# ─── Comercial > Satisfação de Clientes ──────────────────────────────────────
# Hostname(s) da superfície pública, separados por vírgula, SEM porta.
# Quando a requisição chega por um destes hosts, o guard do Node só aceita
# /r, /assets/*, /favicon.ico, /robots.txt e /api/public/satisfaction/* —
# todo o resto responde 404, inclusive a SPA administrativa.
# Vazio = guard inativo (o app interno segue normal). Fail-closed só vale
# depois de configurado; o gateway externo é a primeira barreira.
SATISFACTION_PUBLIC_HOSTS=""

# Base usada para montar o link enviado ao cliente (o token vai no fragmento).
# Ex.: https://satisfacao.seudominio.com.br
SATISFACTION_PUBLIC_BASE_URL=""

# Header dedicado que o gateway pode definir para marcar a superfície pública.
# Só é considerado quando configurado; headers genéricos (XFF, X-Real-IP)
# NUNCA participam desta decisão.
# SATISFACTION_PUBLIC_SURFACE_HEADER="x-induscost-public-surface"

# Confiar no X-Forwarded-For para a chave de rate limit (só com proxy próprio
# na frente). "1" liga; ausente/0 usa o IP do socket.
# SATISFACTION_TRUST_PROXY="0"

# Cloudflare Turnstile — validação SEMPRE server-side.
# Com o secret preenchido a proteção passa a ser OBRIGATÓRIA (fail-closed).
SATISFACTION_TURNSTILE_SITE_KEY=""
SATISFACTION_TURNSTILE_SECRET_KEY=""
# "disabled" desliga explicitamente (homologação sem site key).
# SATISFACTION_TURNSTILE_MODE=""
# Bypass APENAS de desenvolvimento — ignorado quando NODE_ENV=production.
# SATISFACTION_TURNSTILE_DEV_BYPASS="0"
