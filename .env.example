# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"

# Bootstrap Admin (acesso temporário para /settings)
BOOTSTRAP_ADMIN_ENABLED="false"
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="trocar_em_producao"
BOOTSTRAP_ADMIN_SESSION_SECRET="trocar_por_um_segredo_longo"

# Nomus Sync V1 (propostas)
NOMUS_BASE_URL="https://seu-nomus.exemplo.com"
# Opcional: Authorization: Bearer <token>
NOMUS_TOKEN=""
# Opcional: cabeçalho customizado de autenticação, se necessário
NOMUS_AUTH_HEADER_NAME=""
NOMUS_AUTH_HEADER_VALUE=""
NOMUS_PAGE_SIZE="100"
NOMUS_MAX_RETRIES="10"
NOMUS_RETRY_BASE_MS="700"
# Timeout por tentativa HTTP Nomus (ms). 0 = desligado. Cliente OP usa 60000 se omitido.
NOMUS_HTTP_TIMEOUT_MS="60000"

# Sync financeiro Nomus (Contas a Pagar / Receber) — alinhado à chamada do Power BI.
# Tamanho de página financeiro (default 1000). Prioridade: NOMUS_FINANCIAL_PAGE_SIZE > NOMUS_PAGE_SIZE > 1000
NOMUS_FINANCIAL_PAGE_SIZE="1000"
# Janela de datas em dd/MM/yyyy (defaults: 01/01/2020 a 31/12/2030)
NOMUS_FINANCIAL_START_DATE="01/01/2020"
NOMUS_FINANCIAL_END_DATE="31/12/2030"
# apenasPendentes=false traz pagos e em aberto; ordenacao por dataVencimento
NOMUS_FINANCIAL_ONLY_PENDING="false"
NOMUS_FINANCIAL_ORDER_BY="dataVencimento"

# IndusCost local API used by Nomus sync scripts
INDUSCOST_BASE_URL="http://127.0.0.1:3000"

# Inteligência de Mercado — uploads de anexos de cotação (default: ./data/uploads)
# APP_UPLOADS_DIR="/var/lib/induscost/uploads"

# Coleta automática Brent (Yahoo Finance, sem API key). Default: habilitada.
# Desabilitar no servidor com false|0|off|no
# BRENT_COMMODITY_SCHEDULER_ENABLED="true"

# Coleta automática PTAX (BCB). Default: habilitada.
# Desabilitar no servidor com false|0|off|no
# PTAX_SNAPSHOT_SCHEDULER_ENABLED="true"

# Nomus proposal sync controls
NOMUS_PROPOSAL_START_DATE="2025-01-01"
NOMUS_MAX_PAGES="200"
NOMUS_PRODUCTS_MAX_PAGES="200"
