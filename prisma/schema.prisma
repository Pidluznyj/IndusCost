  componentCode        String
  componentDescription String?
  status               String                @default("PLANNED")
  reason               String?
  createdAt            DateTime              @default(now())
  run                  NomusProductImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([componentCode])
  @@index([actionType])
}

enum EngineeringSyncRunMode {
  ONE_PRODUCT
  ALL_NOMUS_PRODUCTS
}

enum EngineeringSyncRunStatus {
  PREVIEWED
  APPLIED
  FAILED
  PARTIAL
}

/// Cabeçalho de execuções do botão "Atualizar engenharia pelo Nomus" (preview/apply).
model EngineeringSyncRun {
  id               String                   @id @default(uuid())
  mode             EngineeringSyncRunMode   @default(ONE_PRODUCT)
  status           EngineeringSyncRunStatus @default(PREVIEWED)
  parentCode       String?
  planHash         String
  confirmationText String?
  approvedBy       String?
  startedAt        DateTime?
  finishedAt       DateTime?
  summaryJson      Json?
  warningsJson     Json?
  errorsJson       Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @default(now()) @updatedAt
  changes          EngineeringChangeLog[]

  @@index([parentCode])
  @@index([status])
  @@index([planHash])
  @@index([createdAt])
}

enum EngineeringChangeEntityType {
  PRODUCT
  PRODUCT_BOM
  MATERIAL
  ROUTING
  PRICE_INPUT
}

enum EngineeringChangeOrigin {
  NOMUS_SYNC
  NOMUS_ENGINEERING_APPLY
  MANUAL_EDIT
  LOCAL_EXCEPTION
}

/// Log antes/depois de cada alteração de engenharia (produto, linha BOM, etc.).
model EngineeringChangeLog {
  id            String                       @id @default(uuid())
  entityType    EngineeringChangeEntityType
  entityId      String?
  productId     String?                      @db.Uuid
  productSku    String?
  sourceSystem  String?
  changeOrigin  EngineeringChangeOrigin
  fieldName     String?
  oldValue      String?
  newValue      String?
  oldValueJson  Json?
  newValueJson  Json?
  changedBy     String?
  changedAt     DateTime                     @default(now())
  runId         String?
  planHash      String?
  reason        String?
  createdAt     DateTime                     @default(now())
  run           EngineeringSyncRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productSku])
  @@index([entityType])
  @@index([changeOrigin])
  @@index([changedAt])
  @@index([runId])
}
