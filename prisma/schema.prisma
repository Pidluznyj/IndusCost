model SupplierServiceTerminationCommissionLink {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  terminationId        String   @db.Uuid
  commissionReportKey  String
  commissionPersonId   String?
  commissionPersonName String?
  periodLabel          String?
  orderCode            String?
  commissionAmount     Decimal  @db.Decimal(20, 2)
  source               String?
  statusLabel          String?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  termination SupplierServiceTermination @relation(fields: [terminationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([terminationId])
  @@index([commissionReportKey])
}

/// Fragmentos de identidade Nomus vinculados ao fornecedor consolidado.
model FinancialSupplierAlias {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId         String                  @db.Uuid
  source             FinancialSupplierSource @default(AUTO_SYNC)
  externalSupplierId Int?
  originalName       String?
  originalDocument   String?
  normalizedName     String?
  normalizedDocument String?
  firstSeenAt        DateTime?               @db.Timestamptz(6)
  lastSeenAt         DateTime?               @db.Timestamptz(6)
  titlesCount        Int                     @default(0)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  supplier FinancialSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([supplierId])
  @@index([externalSupplierId])
  @@index([normalizedDocument])
  @@index([normalizedName])
}

/// Centro de custo financeiro — separado de CostCenter (Compras).
model FinancialCostCenter {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                    @unique
  name              String
  description       String?
  parentId          String?                   @db.Uuid
  responsibleUserId String?
  responsibleName   String?
  status            FinancialCostCenterStatus @default(ACTIVE)
  color             String?
  icon              String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)

  parent                      FinancialCostCenter?                      @relation("FinancialCostCenterTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children                    FinancialCostCenter[]                     @relation("FinancialCostCenterTree")
  costCenterRules             SupplierCostCenterRule[]
  allocations                 AccountsPayableCostCenterAllocation[]
  reclassificationRulesTarget FinancialCostCenterReclassificationRule[]
  classificationRules         FinancialCostCenterClassificationRule[]
  employees                   Employee[]

  @@index([status])
  @@index([parentId])
}

/// Regra gerencial de reclassificação de centro de custo (ex.: descrição AP → subcentro).
model FinancialCostCenterReclassificationRule {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  description          String?
  priority             Int      @default(100)
  isActive             Boolean  @default(true)
  sourceCostCenterName String?
  sourceParentName     String?
  targetCostCenterId   String   @db.Uuid
  matchFields          Json
  keywords             Json
  matchMode            String   @default("CONTAINS_ANY")
  applyToSources       Json
  skipManual           Boolean  @default(true)
  notes                String?
  createdByUserId      String?
  createdByName        String?
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  targetCostCenter FinancialCostCenter @relation(fields: [targetCostCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([isActive])
  @@index([priority])
  @@index([targetCostCenterId])
}

/// Regra gerencial de classificação AP → centro de custo (fornecedor opcional).
model FinancialCostCenterClassificationRule {
  id                  String                                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String
  ruleType            FinancialCostCenterClassificationRuleType
  costCenterId        String                                    @db.Uuid
  percentage          Decimal                                   @default(100) @db.Decimal(5, 2)
  priority            Int                                       @default(100)
  isActive            Boolean                                   @default(true)
  autoApply           Boolean                                   @default(false)
  supplierId          String?                                   @db.Uuid
  nomusClassification String?
  descriptionContains String?
  documentContains    String?
  keywords            Json?
  financialNature     String?
  company             String?
  minAmount           Decimal?                                  @db.Decimal(20, 2)
  maxAmount           Decimal?                                  @db.Decimal(20, 2)
  titleStatus         String?
  accountsPayableId   Int?
  notes               String?
  createdByUserId     String?
  createdByName       String?
  createdAt           DateTime                                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                                  @default(now()) @updatedAt @db.Timestamptz(6)

  costCenter  FinancialCostCenter                   @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  supplier    FinancialSupplier?                    @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  allocations AccountsPayableCostCenterAllocation[]

  @@index([ruleType, isActive])
  @@index([supplierId])
  @@index([costCenterId])
  @@index([priority])
  @@index([accountsPayableId])
  @@index([company])
}

/// Regra fornecedor → centro de custo (classificação automática futura).
model SupplierCostCenterRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String   @db.Uuid
  costCenterId    String   @db.Uuid
  percentage      Decimal  @default(100) @db.Decimal(5, 2)
  priority        Int      @default(100)
  autoApply       Boolean  @default(true)
  isActive        Boolean  @default(true)
  company         String?
  notes           String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  supplier    FinancialSupplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  costCenter  FinancialCostCenter                   @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations AccountsPayableCostCenterAllocation[]

  @@index([supplierId, isActive])
  @@index([costCenterId])
  @@index([company])
  @@index([priority])
}

/// Alocação gerencial de centro de custo por título AP (accountsPayableId = NomusAccountsPayable.externalId).
model AccountsPayableCostCenterAllocation {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountsPayableId        Int
  supplierId               String?                    @db.Uuid
  costCenterId             String                     @db.Uuid
  amount                   Decimal?                   @db.Decimal(20, 2)
  percentage               Decimal                    @default(100) @db.Decimal(5, 2)
  source                   CostCenterAllocationSource
  confidence               Decimal?                   @db.Decimal(5, 2)
  lockedManual             Boolean                    @default(false)
  ruleId                   String?                    @db.Uuid
  classificationRuleId     String?                    @db.Uuid
  classificationRuleType   String?
  classificationRuleName   String?
  classificationRuleReason String?
  notes                    String?
  createdByUserId          String?
  createdByName            String?
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  supplier           FinancialSupplier?                     @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  costCenter         FinancialCostCenter                    @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rule               SupplierCostCenterRule?                @relation(fields: [ruleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  classificationRule FinancialCostCenterClassificationRule? @relation(fields: [classificationRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([accountsPayableId, costCenterId])
  @@index([accountsPayableId])
  @@index([supplierId])
  @@index([costCenterId])
  @@index([source])
  @@index([lockedManual])
}

/// Auditoria de mutações em fornecedores, centros de custo, regras e alocações.
model FinancialCostCenterAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// —— Estoque / Almoxarifado (módulo independente Fase 1) ——

enum InventoryItemType {
  FINISHED_PRODUCT
  SEMI_FINISHED
  COMPONENT
  RAW_MATERIAL
  PACKAGING
  PRODUCTION_SUPPLY
  ADMINISTRATIVE_SUPPLY
  MAINTENANCE
  PPE
  TOOLING
  OTHER
}

enum InventoryItemStatus {
  ACTIVE
  INACTIVE
}

enum InventoryWarehouseStatus {
  ACTIVE
  INACTIVE
}

enum InventoryLocationStatus {
  ACTIVE
  INACTIVE
}

/// Tipo operacional do local interno do almoxarifado.
enum InventoryLocationType {
  PHYSICAL
  QUARANTINE
  PRODUCTION
}

enum InventoryMovementType {
  MANUAL_ENTRY
  PURCHASE_ENTRY
  PRODUCTION_ENTRY
  MANUAL_EXIT
  REQUISITION_EXIT
  PRODUCTION_EXIT
  TRANSFER
  POSITIVE_ADJUSTMENT
  NEGATIVE_ADJUSTMENT
  BLOCK
  UNBLOCK
  RESERVE
  CANCEL_RESERVATION
  LOSS
  SCRAP
  RETURN
  REVERSAL
  /// Implantação inicial de estoque (saldo de abertura auditável).
  INITIAL_BALANCE
  /// Entrada em quarentena (reduz disponível; não altera físico).
  QUARANTINE_IN
  /// Saída de quarentena (libera disponível; não altera físico).
  QUARANTINE_OUT
}

enum InventoryMovementOriginType {
  MANUAL
  PURCHASE
  SALES_ORDER
  PRODUCTION_ORDER
  COUNT_SESSION
  REVERSAL
  INTEGRATION
  OTHER
}

enum InventoryReservationType {
  SALES_ORDER
  PRODUCTION_ORDER
  INTERNAL_REQUISITION
  MAINTENANCE
  QUALITY
  MANUAL
}

enum InventoryReservationStatus {
  ACTIVE
  CANCELED
  CONSUMED
}

enum InventoryBlockStatus {
  ACTIVE
  RELEASED
}

enum InventoryBlockReasonType {
  QUALITY
  QUARANTINE
  DAMAGE
  AUDIT
  MANUAL
  OTHER
}

enum InventoryStockSnapshotSource {
  MANUAL
  RECALCULATION
  SYSTEM
  COUNT_SESSION
}

enum InventoryCountSessionStatus {
  OPEN
  COUNTING
  WAITING_APPROVAL
  APPROVED
  ADJUSTED
  CANCELED
}

model InventoryItem {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String              @unique
  description           String
  itemType              InventoryItemType
  /// Unidade oficial operacional do item logístico (espelha Material.unit quando materialId estiver vinculado).
  unit                  String
  family                String?
  group                 String?
  status                InventoryItemStatus @default(ACTIVE)
  controlsLot           Boolean             @default(false)
  controlsExpiration    Boolean             @default(false)
  controlsLocation      Boolean             @default(false)
  controlsQuality       Boolean             @default(false)
  /// Controla saldo físico no ledger local.
  controlsStock         Boolean             @default(true)
  allowsReservation     Boolean             @default(true)
  allowsBlock           Boolean             @default(true)
  minimumStock          Decimal?            @db.Decimal(20, 6)
  /// Estoque de segurança (alerta operacional).
  safetyStock           Decimal?            @db.Decimal(20, 6)
  maximumStock          Decimal?            @db.Decimal(20, 6)
  reorderPoint          Decimal?            @db.Decimal(20, 6)
  preferredSupplierName String?
  averageCost           Decimal?            @db.Decimal(20, 6)
  lastKnownCost         Decimal?            @db.Decimal(20, 6)
  productId             String?             @db.Uuid
  /// Vínculo ao cadastro oficial de matéria-prima (sem duplicar MP).
  materialId            String?             @db.Uuid
  /// Snapshots históricos do cadastro oficial no momento do vínculo/atualização logística.
  materialCodeSnapshot        String?
  materialDescriptionSnapshot String?
  materialUnitSnapshot        String?
  materialCategorySnapshot    String?
  defaultWarehouseId    String?             @db.Uuid
  defaultLocationId     String?             @db.Uuid
  nomusProductCode      String?
  nomusProductId        String?
  notes                 String?
  createdAt             DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  createdByUserId       String?
  updatedByUserId       String?

  Product           Product?                     @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  Material          Material?                    @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  defaultWarehouse  InventoryWarehouse?          @relation("InventoryItemDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  defaultLocation   InventoryLocation?           @relation("InventoryItemDefaultLocation", fields: [defaultLocationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  balances          InventoryBalance[]
  movements         InventoryMovement[]
  reservations      InventoryReservation[]
  blocks            InventoryBlock[]
  countLines        InventoryCountLine[]
  stockSnapshotLines InventoryStockSnapshotLine[]

  @@index([itemType])
  @@index([status])
  @@index([productId])
  @@index([materialId])
  @@index([defaultWarehouseId])
  @@index([defaultLocationId])
  @@index([nomusProductCode])
  @@index([controlsStock])
}

model InventoryWarehouse {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String                   @unique
  name            String
  description     String?
  status          InventoryWarehouseStatus @default(ACTIVE)
  allowsMovements Boolean                  @default(true)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  createdByUserId String?
  updatedByUserId String?

  locations            InventoryLocation[]
  balances             InventoryBalance[]
  sourceMovements      InventoryMovement[]     @relation("MovementSourceWarehouse")
  destinationMovements InventoryMovement[]     @relation("MovementDestinationWarehouse")
  reservations         InventoryReservation[]
  blocks               InventoryBlock[]
  countSessions        InventoryCountSession[]
  countLines           InventoryCountLine[]
  stockSnapshotLines   InventoryStockSnapshotLine[]
  defaultForItems      InventoryItem[]         @relation("InventoryItemDefaultWarehouse")

  @@index([status])
}

model InventoryLocation {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  warehouseId     String                  @db.Uuid
  code            String
  name            String
  status          InventoryLocationStatus @default(ACTIVE)
  /// Físico, quarentena ou produção.
  locationType    InventoryLocationType   @default(PHYSICAL)
  /// Único local padrão ativo por almoxarifado (garantido em serviço + índice parcial).
  isDefault       Boolean                 @default(false)
  /// Hierarquia opcional (ex.: corredor → estante → posição).
  parentLocationId String?                @db.Uuid
  /// Endereçamento: corredor / estante / posição (quando modelado).
  aisle           String?
  shelf           String?
  position        String?
  notes           String?
  createdAt       DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  createdByUserId String?
  updatedByUserId String?

  warehouse            InventoryWarehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parentLocation       InventoryLocation?     @relation("InventoryLocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  childLocations       InventoryLocation[]    @relation("InventoryLocationHierarchy")
  balances             InventoryBalance[]
  sourceMovements      InventoryMovement[]    @relation("MovementSourceLocation")
  destinationMovements InventoryMovement[]    @relation("MovementDestinationLocation")
  reservations         InventoryReservation[]
  blocks               InventoryBlock[]
  countLines           InventoryCountLine[]
  stockSnapshotLines   InventoryStockSnapshotLine[]
  defaultForItems      InventoryItem[]        @relation("InventoryItemDefaultLocation")

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([status])
  @@index([locationType])
  @@index([parentLocationId])
  @@index([isDefault])
}

/// Movimento imutável (ledger). Sem updatedAt de negócio — correção só via REVERSAL.
model InventoryMovement {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId                    String                      @db.Uuid
  sourceWarehouseId         String?                     @db.Uuid
  destinationWarehouseId    String?                     @db.Uuid
  sourceLocationId          String?                     @db.Uuid
  destinationLocationId     String?                     @db.Uuid
  movementType              InventoryMovementType
  quantity                  Decimal                     @db.Decimal(20, 6)
  /// Unidade oficial do fato (cópia imutável no lançamento).
  unit                      String
  reason                    String
  notes                     String?
  responsibleUserId         String?
  createdByUserId           String?
  movementDate              DateTime                    @default(now()) @db.Timestamptz(6)
  originType                InventoryMovementOriginType @default(MANUAL)
  originId                  String?
  documentNumber            String?
  /// Referência de evidência (doc/path/URL) — opcional enquanto não há store de anexos de estoque.
  evidenceRef               String?
  costCenterId              String?                     @db.Uuid
  financialCostCenterId     String?                     @db.Uuid
  purchaseOrderId           String?                     @db.Uuid
  purchaseOrderCode         String?
  salesOrderId              String?                     @db.Uuid
  salesOrderCode            String?
  productionOrderId         String?                     @db.Uuid
  productionOrderCode       String?
  bomId                     String?                     @db.Uuid
  productId                 String?                     @db.Uuid
  /// Snapshot do vínculo oficial de MP no momento do fato (não atualiza se Material mudar).
  materialId                String?                     @db.Uuid
  materialCodeSnapshot      String?
  materialDescriptionSnapshot String?
  nfeId                     String?
  nfeNumber                 String?
  /// Rastreabilidade operacional (lote / série / validade).
  lotNumber                 String?
  serialNumber              String?
  expirationDate            DateTime?                   @db.Timestamptz(6)
  previousPhysicalBalance   Decimal                     @db.Decimal(20, 6)
  nextPhysicalBalance       Decimal                     @db.Decimal(20, 6)
  previousReservedBalance   Decimal                     @default(0) @db.Decimal(20, 6)
  nextReservedBalance       Decimal                     @default(0) @db.Decimal(20, 6)
  previousBlockedBalance    Decimal                     @default(0) @db.Decimal(20, 6)
  nextBlockedBalance        Decimal                     @default(0) @db.Decimal(20, 6)
  previousQuarantineBalance Decimal                     @default(0) @db.Decimal(20, 6)
  nextQuarantineBalance     Decimal                     @default(0) @db.Decimal(20, 6)
  previousAvailableBalance  Decimal                     @db.Decimal(20, 6)
  nextAvailableBalance      Decimal                     @db.Decimal(20, 6)
  /// Custo unitário informativo (não fiscal) no momento do fato.
  unitCost                  Decimal?                    @db.Decimal(20, 6)
  /// Chave de idempotência explícita (alternativa a originType+originId).
  idempotencyKey            String?
  reversedMovementId        String?                     @db.Uuid
  reservationId             String?                     @db.Uuid
  blockId                   String?                     @db.Uuid
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)

  item                 InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceWarehouse      InventoryWarehouse?   @relation("MovementSourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  destinationWarehouse InventoryWarehouse?   @relation("MovementDestinationWarehouse", fields: [destinationWarehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sourceLocation       InventoryLocation?    @relation("MovementSourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  destinationLocation  InventoryLocation?    @relation("MovementDestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  costCenter           CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reversedMovement     InventoryMovement?    @relation("MovementReversal", fields: [reversedMovementId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reversalMovements    InventoryMovement[]   @relation("MovementReversal")
  reservation          InventoryReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  block                InventoryBlock?       @relation(fields: [blockId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  countLine            InventoryCountLine?
  stockSnapshotLines   InventoryStockSnapshotLine[]

  @@unique([reversedMovementId])
  @@index([itemId])
  @@index([movementType])
  @@index([movementDate])
  @@index([sourceWarehouseId])
  @@index([destinationWarehouseId])
  @@index([costCenterId])
  @@index([originType, originId])
  @@index([salesOrderId])
  @@index([purchaseOrderId])
  @@index([reservationId])
  @@index([blockId])
  @@index([materialId])
  @@index([lotNumber])
  @@index([createdByUserId])
  @@index([createdAt])
}

/// Saldo materializado — projeção do ledger; nunca fonte editável direta.
model InventoryBalance {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId             String    @db.Uuid
  warehouseId        String    @db.Uuid
  locationId         String?   @db.Uuid
  /// Chave de escopo: "{warehouseId}" ou "{warehouseId}:{locationId}" — evita ambiguidade de UNIQUE com null.
  balanceKey         String
  physicalQuantity   Decimal   @default(0) @db.Decimal(20, 6)
  reservedQuantity   Decimal   @default(0) @db.Decimal(20, 6)
  blockedQuantity    Decimal   @default(0) @db.Decimal(20, 6)
  quarantineQuantity Decimal   @default(0) @db.Decimal(20, 6)
  availableQuantity  Decimal   @default(0) @db.Decimal(20, 6)
  averageCost        Decimal?  @db.Decimal(20, 6)
  totalValue         Decimal?  @db.Decimal(20, 2)
  lastMovementAt     DateTime?
  /// Último movimento que materializou este saldo (rastreio ledger → saldo).
  lastMovementId     String?   @db.Uuid
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  item      InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse InventoryWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location  InventoryLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([itemId, balanceKey])
  @@index([warehouseId])
  @@index([locationId])
  @@index([availableQuantity])
  @@index([lastMovementId])
}

model InventoryReservation {
  id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId           String                      @db.Uuid
  warehouseId      String                      @db.Uuid
  locationId       String?                     @db.Uuid
  quantity         Decimal                     @db.Decimal(20, 6)
  reservationType  InventoryReservationType
  status           InventoryReservationStatus  @default(ACTIVE)
  reason           String
  originType       InventoryMovementOriginType @default(MANUAL)
  originId         String?
  /// Responsável pela reserva (pode diferir do criador técnico).
  responsibleUserId String?
  /// Validade opcional da reserva.
  expiresAt        DateTime?                   @db.Timestamptz(6)
  createdByUserId  String?
  canceledByUserId String?
  createdAt        DateTime                    @default(now()) @db.Timestamptz(6)
  canceledAt       DateTime?                   @db.Timestamptz(6)
  notes            String?

  item      InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse InventoryWarehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location  InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  movements InventoryMovement[]

  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@index([reservationType])
  @@index([createdByUserId])
  @@index([responsibleUserId])
  @@index([expiresAt])
  @@index([createdAt])
}

/// Bloqueio tipado (qualidade/auditoria) — espelha reserva; saldo bloqueado só via movimentos BLOCK/UNBLOCK.
model InventoryBlock {
  id              String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId          String                      @db.Uuid
  warehouseId     String                      @db.Uuid
  locationId      String?                     @db.Uuid
  quantity        Decimal                     @db.Decimal(20, 6)
  reasonType      InventoryBlockReasonType    @default(MANUAL)
  status          InventoryBlockStatus        @default(ACTIVE)
  reason          String
  originType      InventoryMovementOriginType @default(MANUAL)
  originId        String?
  responsibleUserId String?
  createdByUserId String?
  releasedByUserId String?
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  releasedAt      DateTime?                   @db.Timestamptz(6)
  notes           String?

  item      InventoryItem       @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse InventoryWarehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location  InventoryLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  movements InventoryMovement[]

  @@index([itemId])
  @@index([warehouseId])
  @@index([status])
  @@index([reasonType])
  @@index([createdByUserId])
  @@index([responsibleUserId])
  @@index([createdAt])
}

/// Snapshot pontual de saldos (auditoria / recálculo a partir do ledger). Não substitui InventoryBalance.
model InventoryStockSnapshot {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  asOfAt          DateTime                     @db.Timestamptz(6)
  source          InventoryStockSnapshotSource @default(RECALCULATION)
  reason          String?
  createdByUserId String?
  createdByUserName String?
  createdAt       DateTime                     @default(now()) @db.Timestamptz(6)

  lines InventoryStockSnapshotLine[]

  @@index([asOfAt])
  @@index([source])
  @@index([createdByUserId])
  @@index([createdAt])
}

model InventoryStockSnapshotLine {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshotId         String   @db.Uuid
  itemId             String   @db.Uuid
  warehouseId        String   @db.Uuid
  locationId         String?  @db.Uuid
  balanceKey         String
  physicalQuantity   Decimal  @db.Decimal(20, 6)
  reservedQuantity   Decimal  @default(0) @db.Decimal(20, 6)
  blockedQuantity    Decimal  @default(0) @db.Decimal(20, 6)
  quarantineQuantity Decimal  @default(0) @db.Decimal(20, 6)
  availableQuantity  Decimal  @db.Decimal(20, 6)
  /// Unidade oficial congelada no snapshot.
  unit               String
  materialId         String?  @db.Uuid
  materialCodeSnapshot String?
  lastMovementId     String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  snapshot    InventoryStockSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item        InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse   InventoryWarehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location    InventoryLocation?     @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lastMovement InventoryMovement?    @relation(fields: [lastMovementId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([snapshotId])
  @@index([itemId, balanceKey])
  @@index([warehouseId])
  @@index([lastMovementId])
}

model InventoryCountSession {
  id                String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                      @unique
  warehouseId       String                      @db.Uuid
  status            InventoryCountSessionStatus @default(OPEN)
  responsibleUserId String?
  approvedByUserId  String?
  startedAt         DateTime?
  finishedAt        DateTime?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  warehouse InventoryWarehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  lines     InventoryCountLine[]

  @@index([warehouseId])
  @@index([status])
}

model InventoryCountLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String   @db.Uuid
  itemId              String   @db.Uuid
  warehouseId         String   @db.Uuid
  locationId          String?  @db.Uuid
  systemQuantity      Decimal  @db.Decimal(20, 6)
  countedQuantity     Decimal? @db.Decimal(20, 6)
  differenceQuantity  Decimal? @db.Decimal(20, 6)
  differencePercent   Decimal? @db.Decimal(10, 4)
  justification       String?
  generatedMovementId String?  @unique @db.Uuid
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  session           InventoryCountSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item              InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warehouse         InventoryWarehouse    @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  location          InventoryLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  generatedMovement InventoryMovement?    @relation(fields: [generatedMovementId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([sessionId])
  @@index([itemId])
  @@index([warehouseId])
}

model InventoryAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  userId     String?
  userName   String?
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Domínio aditivo de Compras SC (OP-13) — cotação, negociação, PO, recebimento.
// Não muta Material / FinancialSupplier / AP / estoque Nomus.
// Preço: initial* imutável + rodadas append-only + awarded*/final* só na adjudicação.
// InventoryMovement.purchaseOrderId permanece soft até orquestração futura.
// ---------------------------------------------------------------------------

enum PurchaseQuotationStatus {
  RASCUNHO
  ENVIADA
  EM_ANALISE
  ADJUDICADA
  CANCELADA
  EXPIRADA
}

enum PurchaseQuotationSupplierStatus {
  CONVIDADO
  RESPONDIDO
  DESCARTADO
  VENCEDOR
  RECUSADO
}

enum PurchaseQuotationOfferStatus {
  RASCUNHO
  RECEBIDA
  DESCARTADA
  VENCEDORA
}

enum PurchaseNegotiationRoundStatus {
  ABERTA
  FECHADA
  CANCELADA
}

enum PurchaseNegotiationActor {
  BUYER
  SUPPLIER
}

enum PurchaseApprovalTargetType {
  REQUEST
  QUOTATION
  PURCHASE_ORDER
  RECEIPT
}

enum PurchaseApprovalStatus {
  PENDENTE
  APROVADA
  REJEITADA
  CANCELADA
}

enum PurchaseQuotationAwardStatus {
  PENDENTE_APROVACAO
  APROVADA
  REJEITADA
  CANCELADA
}

enum PurchaseQuotationAwardMode {
  SINGLE
  SPLIT
}

enum PurchaseQuotationAwardHistoryAction {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PurchaseOrderStatus {
  RASCUNHO
  EMITIDO
  CONFIRMADO
  PARCIALMENTE_RECEBIDO
  RECEBIDO
  CANCELADO
  ENCERRADO
}

enum PurchaseReceiptStatus {
  RASCUNHO
  EM_CONFERENCIA
  DIVERGENTE
  APROVADO
  ESTORNADO
  CANCELADO
}

enum PurchaseEvidenceEntityType {
  REQUEST
  QUOTATION
  QUOTATION_SUPPLIER
  OFFER
  NEGOTIATION_ROUND
  /// Confirmação final da negociação / aceite.
  CONFIRMATION
  APPROVAL
  PURCHASE_ORDER
  RECEIPT
}

enum PurchaseEvidenceType {
  PDF
  IMAGE
  SPREADSHEET
  EMAIL
  PROPOSAL
  OTHER
}

enum PurchaseEvidenceHistoryAction {
  UPLOADED
  REPLACED
  SOFT_DELETED
  LOCKED
  UNLOCKED
  DOWNLOAD
}

/// Cotação SC (RFQ) — distinta de MaterialMarketQuote (MI).
model PurchaseQuotation {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                  @unique
  purchaseRequestId String?                 @db.Uuid
  status            PurchaseQuotationStatus @default(RASCUNHO)
  title             String?
  currency          String                  @default("BRL")
  neededByDate      DateTime?               @db.Date
  expiresAt         DateTime?               @db.Timestamptz(6)
  justification     String?
  notes             String?
  requestedByUserId String?
  awardedAt         DateTime?               @db.Timestamptz(6)
  awardedByUserId   String?
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  purchaseRequest PurchaseRequest?             @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items           PurchaseQuotationItem[]
  suppliers       PurchaseQuotationSupplier[]
  offers          PurchaseQuotationOffer[]
  rounds          PurchaseNegotiationRound[]
  approvals       PurchaseApproval[]           @relation("PurchaseApprovalQuotation")
  awards          PurchaseQuotationAward[]
  purchaseOrders  PurchaseOrder[]

  @@index([status])
  @@index([purchaseRequestId])
  @@index([expiresAt])
  @@index([createdAt])
}

/// Itens solicitados na cotação (demanda) — snapshot de MP oficial.
model PurchaseQuotationItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId           String   @db.Uuid
  purchaseRequestItemId String?  @db.Uuid
  lineNumber            Int
  materialId            String?  @db.Uuid
  materialCodeSnapshot  String?
  materialDescriptionSnapshot String?
  materialUnitSnapshot  String?
  description           String
  quantity              Decimal  @db.Decimal(20, 6)
  unit                  String
  notes                 String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  quotation           PurchaseQuotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseRequestItem PurchaseRequestItem?      @relation(fields: [purchaseRequestItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  material            Material?                 @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  offerItems          PurchaseQuotationOfferItem[]
  purchaseOrderItems  PurchaseOrderItem[]
  awardAllocations    PurchaseQuotationAwardAllocation[]

  @@unique([quotationId, lineNumber])
  @@index([quotationId])
  @@index([materialId])
  @@index([purchaseRequestItemId])
}

/// Fornecedor convidado na cotação — ID oficial FinancialSupplier + snapshots.
model PurchaseQuotationSupplier {
  id                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId                String                         @db.Uuid
  supplierId                 String                         @db.Uuid
  status                     PurchaseQuotationSupplierStatus @default(CONVIDADO)
  supplierDisplayNameSnapshot String
  supplierDocumentSnapshot   String?
  invitedAt                  DateTime                       @default(now()) @db.Timestamptz(6)
  respondedAt                DateTime?                      @db.Timestamptz(6)
  notes                      String?
  createdAt                  DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)

  quotation PurchaseQuotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier  FinancialSupplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  offers    PurchaseQuotationOffer[]

  @@unique([quotationId, supplierId])
  @@index([quotationId])
  @@index([supplierId])
  @@index([status])
}

/// Cotação por fornecedor (oferta). Condições iniciais ≠ finais adjudicadas.
model PurchaseQuotationOffer {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId             String                      @db.Uuid
  quotationSupplierId     String                      @db.Uuid
  status                  PurchaseQuotationOfferStatus @default(RASCUNHO)
  currency                String                      @default("BRL")
  /// Condições da primeira resposta — não sobrescrever na negociação.
  initialPaymentTerms     String?
  initialDeliveryTerms    String?
  initialFreightValue     Decimal?                    @db.Decimal(20, 6)
  initialNonRecoverableTaxes Decimal?                 @db.Decimal(20, 6)
  initialExpenses         Decimal?                    @db.Decimal(20, 6)
  initialDiscounts        Decimal?                    @db.Decimal(20, 6)
  initialMinOrderQty      Decimal?                    @db.Decimal(20, 6)
  initialValidityDate     DateTime?                   @db.Date
  initialLeadTimeDays     Int?
  /// Proposta comercial recebida (anexo/registro) — distinta de adjudicação.
  proposalReceived        Boolean                     @default(false)
  proposalReceivedAt      DateTime?                   @db.Timestamptz(6)
  proposalReceivedNotes   String?
  /// Condições adjudicadas — preenchidas só na adjudicação (cópia da rodada vencedora).
  awardedPaymentTerms     String?
  awardedDeliveryTerms    String?
  awardedFreightValue     Decimal?                    @db.Decimal(20, 6)
  awardedValidityDate     DateTime?                   @db.Date
  awardedLeadTimeDays     Int?
  awardedAt               DateTime?                   @db.Timestamptz(6)
  submittedAt             DateTime?                   @db.Timestamptz(6)
  notes                   String?
  /// Escolha humana do vencedor — nunca auto pelo menor preço (OP-18).
  selectionJustification  String?
  selectedAt              DateTime?                   @db.Timestamptz(6)
  selectedByUserId        String?
  selectedByUserName      String?
  createdAt               DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  quotation         PurchaseQuotation           @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotationSupplier PurchaseQuotationSupplier   @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  items             PurchaseQuotationOfferItem[]
  purchaseOrders    PurchaseOrder[]
  awardAllocations  PurchaseQuotationAwardAllocation[]
  awardRejections   PurchaseQuotationAwardRejection[]

  @@unique([quotationId, quotationSupplierId])
  @@index([quotationId])
  @@index([quotationSupplierId])
  @@index([status])
}

/// Item da oferta: preço inicial imutável + awarded* separado; histórico nas rodadas.
model PurchaseQuotationOfferItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId            String   @db.Uuid
  quotationItemId    String   @db.Uuid
  /// Preço unitário da primeira resposta — imutável após RECEBIDA / início de negociação.
  initialUnitPrice   Decimal  @db.Decimal(20, 6)
  initialQuantity    Decimal? @db.Decimal(20, 6)
  initialLeadTimeDays Int?
  initialFreightValue Decimal? @db.Decimal(20, 6)
  initialNonRecoverableTaxes Decimal? @db.Decimal(20, 6)
  initialExpenses    Decimal? @db.Decimal(20, 6)
  initialDiscounts   Decimal? @db.Decimal(20, 6)
  initialMinOrderQty Decimal? @db.Decimal(20, 6)
  initialNotes       String?
  /// Preço/qtd adjudicados — nunca sobrescrevem initial*; preenchidos só na adjudicação.
  awardedUnitPrice   Decimal? @db.Decimal(20, 6)
  awardedQuantity    Decimal? @db.Decimal(20, 6)
  awardedLeadTimeDays Int?
  awardedFreightValue Decimal? @db.Decimal(20, 6)
  awardedAt          DateTime? @db.Timestamptz(6)
  /// Rodada de origem do preço adjudicado (rastreio).
  awardedRoundLineId String?  @unique @db.Uuid
  notes              String?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  offer            PurchaseQuotationOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotationItem    PurchaseQuotationItem         @relation(fields: [quotationItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  roundLines       PurchaseNegotiationRoundLine[]
  awardedRoundLine PurchaseNegotiationRoundLine? @relation("OfferItemAwardedRoundLine", fields: [awardedRoundLineId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  awardAllocations PurchaseQuotationAwardAllocation[]

  @@unique([offerId, quotationItemId])
  @@index([offerId])
  @@index([quotationItemId])
}

/// Rodada de negociação — cabeçalho append-friendly (número monotônico por cotação).
model PurchaseNegotiationRound {
  id                   String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId          String                         @db.Uuid
  roundNumber          Int
  status               PurchaseNegotiationRoundStatus @default(ABERTA)
  openedAt             DateTime                       @default(now()) @db.Timestamptz(6)
  closedAt             DateTime?                      @db.Timestamptz(6)
  openedByUserId       String?
  closedByUserId       String?
  /// Relato do comprador nesta rodada.
  buyerReport          String?
  /// Responsável (nome exibido; ID em openedByUserId).
  responsibleUserName  String?
  notes                String?
  createdAt            DateTime                       @default(now()) @db.Timestamptz(6)

  quotation PurchaseQuotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lines     PurchaseNegotiationRoundLine[]
  awardsAsFinalRound PurchaseQuotationAward[] @relation("AwardFinalRound")

  @@unique([quotationId, roundNumber])
  @@index([quotationId])
  @@index([status])
}

/// Proposta de preço/condição na rodada — append-only (sem updatedAt).
/// previous* = snapshot do estado anterior; campos sem prefixo = novos valores.
model PurchaseNegotiationRoundLine {
  id                           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId                      String                   @db.Uuid
  offerItemId                  String                   @db.Uuid
  unitPrice                    Decimal                  @db.Decimal(20, 6)
  quantity                     Decimal?                 @db.Decimal(20, 6)
  leadTimeDays                 Int?
  freightValue                 Decimal?                 @db.Decimal(20, 6)
  nonRecoverableTaxes          Decimal?                 @db.Decimal(20, 6)
  expenses                     Decimal?                 @db.Decimal(20, 6)
  discounts                    Decimal?                 @db.Decimal(20, 6)
  minOrderQty                  Decimal?                 @db.Decimal(20, 6)
  /// CIF | FOB | OTHER — CIF não entra no custo comparável do comprador.
  freightIncoterm              String?
  paymentTerms                 String?
  deliveryTerms                String?
  previousUnitPrice            Decimal?                 @db.Decimal(20, 6)
  previousQuantity             Decimal?                 @db.Decimal(20, 6)
  previousLeadTimeDays         Int?
  previousFreightValue         Decimal?                 @db.Decimal(20, 6)
  previousNonRecoverableTaxes  Decimal?                 @db.Decimal(20, 6)
  previousExpenses             Decimal?                 @db.Decimal(20, 6)
  previousDiscounts            Decimal?                 @db.Decimal(20, 6)
  previousMinOrderQty          Decimal?                 @db.Decimal(20, 6)
  previousPaymentTerms         String?
  previousDeliveryTerms        String?
  previousFreightIncoterm      String?
  proposedBy                   PurchaseNegotiationActor
  notes                        String?
  createdAt                    DateTime                 @default(now()) @db.Timestamptz(6)
  createdByUserId              String?

  round                   PurchaseNegotiationRound    @relation(fields: [roundId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offerItem               PurchaseQuotationOfferItem  @relation(fields: [offerItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  awardedForOfferItem     PurchaseQuotationOfferItem? @relation("OfferItemAwardedRoundLine")

  @@unique([roundId, offerItemId])
  @@index([roundId])
  @@index([offerItemId])
  @@index([createdAt])
}

/// Aprovação formal (cotação / PO / recebimento).
model PurchaseApproval {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType        PurchaseApprovalTargetType
  status            PurchaseApprovalStatus   @default(PENDENTE)
  purchaseRequestId String?                  @db.Uuid
  quotationId       String?                  @db.Uuid
  purchaseOrderId   String?                  @db.Uuid
  receiptId         String?                  @db.Uuid
  sequence          Int                      @default(1)
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?                @db.Timestamptz(6)
  reason            String?
  notes             String?
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  purchaseRequest PurchaseRequest?   @relation("PurchaseApprovalRequest", fields: [purchaseRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotation       PurchaseQuotation? @relation("PurchaseApprovalQuotation", fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrder   PurchaseOrder?     @relation("PurchaseApprovalPurchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  receipt         PurchaseReceipt?   @relation("PurchaseApprovalReceipt", fields: [receiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotationAward  PurchaseQuotationAward? @relation("AwardPurchaseApproval")

  @@index([targetType, status])
  @@index([purchaseRequestId])
  @@index([quotationId])
  @@index([purchaseOrderId])
  @@index([receiptId])
  @@index([createdAt])
}

/// Pacote formal de adjudicação (OP-19) — escolha + aprovação; sem PO/recebimento.
model PurchaseQuotationAward {
  id                         String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId                String                      @db.Uuid
  status                     PurchaseQuotationAwardStatus @default(PENDENTE_APROVACAO)
  mode                       PurchaseQuotationAwardMode  @default(SINGLE)
  finalRoundId               String?                     @db.Uuid
  justification              String
  responsibleUserId          String?
  responsibleUserName        String?
  approverUserId             String?
  approverUserName           String?
  submittedAt                DateTime                    @default(now()) @db.Timestamptz(6)
  decidedAt                  DateTime?                   @db.Timestamptz(6)
  decisionReason             String?
  currency                   String                      @default("BRL")
  initialComparableTotal     Decimal?                    @db.Decimal(20, 6)
  awardedComparableTotal     Decimal?                    @db.Decimal(20, 6)
  totalGain                  Decimal?                    @db.Decimal(20, 6)
  percentGain                Decimal?                    @db.Decimal(20, 6)
  evidenceCountSnapshot      Int                         @default(0)
  usedEvidenceException      Boolean                     @default(false)
  commercialConditionsJson   Json?
  notes                      String?
  approvalId                 String?                     @unique @db.Uuid
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  quotation   PurchaseQuotation                 @relation(fields: [quotationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  finalRound  PurchaseNegotiationRound?         @relation("AwardFinalRound", fields: [finalRoundId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  approval    PurchaseApproval?                 @relation("AwardPurchaseApproval", fields: [approvalId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  allocations PurchaseQuotationAwardAllocation[]
  rejections  PurchaseQuotationAwardRejection[]
  history     PurchaseQuotationAwardHistoryEvent[]

  @@index([quotationId])
  @@index([status])
  @@index([finalRoundId])
  @@index([submittedAt])
}

model PurchaseQuotationAwardAllocation {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId            String   @db.Uuid
  offerId            String   @db.Uuid
  offerItemId        String   @db.Uuid
  quotationItemId    String   @db.Uuid
  supplierId         String   @db.Uuid
  supplierNameSnapshot String
  quantityAwarded    Decimal  @db.Decimal(20, 6)
  unitPriceAwarded   Decimal  @db.Decimal(20, 6)
  lineTotalAwarded   Decimal  @db.Decimal(20, 6)
  roundLineId        String?  @db.Uuid
  paymentTermsSnapshot String?
  deliveryTermsSnapshot String?
  freightValueSnapshot Decimal? @db.Decimal(20, 6)
  leadTimeDaysSnapshot Int?
  validityDateSnapshot DateTime? @db.Date
  createdAt          DateTime @default(now()) @db.Timestamptz(6)

  award         PurchaseQuotationAward      @relation(fields: [awardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offer         PurchaseQuotationOffer      @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  offerItem     PurchaseQuotationOfferItem  @relation(fields: [offerItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  quotationItem PurchaseQuotationItem       @relation(fields: [quotationItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([awardId])
  @@index([offerId])
  @@index([offerItemId])
  @@index([quotationItemId])
  @@unique([awardId, offerItemId])
}

model PurchaseQuotationAwardRejection {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId              String   @db.Uuid
  offerId              String   @db.Uuid
  quotationSupplierId  String   @db.Uuid
  supplierId           String   @db.Uuid
  supplierNameSnapshot String
  reason               String
  createdAt            DateTime @default(now()) @db.Timestamptz(6)

  award PurchaseQuotationAward @relation(fields: [awardId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offer PurchaseQuotationOffer @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([awardId, offerId])
  @@index([awardId])
  @@index([offerId])
}

model PurchaseQuotationAwardHistoryEvent {
  id        String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  awardId   String                             @db.Uuid
  action    PurchaseQuotationAwardHistoryAction
  reason    String?
  userId    String?
  userName  String?
  metaJson  Json?
  createdAt DateTime                           @default(now()) @db.Timestamptz(6)

  award PurchaseQuotationAward @relation(fields: [awardId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([awardId, createdAt])
  @@index([action])
}

/// Pedido de compra formal — preços congelados no emit; não movimenta estoque sozinho.
model PurchaseOrder {
  id                         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String              @unique
  status                     PurchaseOrderStatus @default(RASCUNHO)
  purchaseRequestId          String?             @db.Uuid
  quotationId                String?             @db.Uuid
  awardedOfferId             String?             @db.Uuid
  supplierId                 String              @db.Uuid
  supplierDisplayNameSnapshot String
  supplierDocumentSnapshot   String?
  currency                   String              @default("BRL")
  paymentTermsSnapshot       String?
  deliveryTermsSnapshot      String?
  freightValueSnapshot       Decimal?            @db.Decimal(20, 6)
  totalAmountSnapshot        Decimal?            @db.Decimal(20, 6)
  expectedDeliveryDate       DateTime?           @db.Date
  issuedAt                   DateTime?           @db.Timestamptz(6)
  confirmedAt                DateTime?           @db.Timestamptz(6)
  issuedByUserId             String?
  notes                      String?
  createdAt                  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  purchaseRequest PurchaseRequest?      @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotation       PurchaseQuotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  awardedOffer    PurchaseQuotationOffer? @relation(fields: [awardedOfferId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  supplier        FinancialSupplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items           PurchaseOrderItem[]
  receipts        PurchaseReceipt[]
  approvals       PurchaseApproval[]    @relation("PurchaseApprovalPurchaseOrder")

  @@index([status])
  @@index([supplierId])
  @@index([purchaseRequestId])
  @@index([quotationId])
  @@index([issuedAt])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseOrderId       String   @db.Uuid
  lineNumber            Int
  purchaseRequestItemId String?  @db.Uuid
  quotationItemId       String?  @db.Uuid
  materialId            String?  @db.Uuid
  materialCodeSnapshot  String?
  materialDescriptionSnapshot String?
  materialUnitSnapshot  String?
  description           String
  quantityOrdered       Decimal  @db.Decimal(20, 6)
  unit                  String
  /// Preço unitário congelado na emissão do PO (cópia do awarded da oferta).
  unitPriceSnapshot     Decimal  @db.Decimal(20, 6)
  lineTotalSnapshot     Decimal  @db.Decimal(20, 6)
  /// Soft link futuro ao item logístico local.
  inventoryItemId       String?  @db.Uuid
  notes                 String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  purchaseOrder       PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseRequestItem PurchaseRequestItem?   @relation(fields: [purchaseRequestItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  quotationItem       PurchaseQuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  material            Material?              @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  receiptItems        PurchaseReceiptItem[]

  @@unique([purchaseOrderId, lineNumber])
  @@index([purchaseOrderId])
  @@index([materialId])
  @@index([inventoryItemId])
  @@index([quotationItemId])
}

/// Recebimento parcial/total — vínculo futuro a InventoryMovement via soft IDs.
model PurchaseReceipt {
  id                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                  String                @unique
  purchaseOrderId       String                @db.Uuid
  status                PurchaseReceiptStatus @default(RASCUNHO)
  receivedAt            DateTime?             @db.Timestamptz(6)
  /// Soft: almoxarifado destino (InventoryWarehouse.id) — sem FK rígida nesta fase.
  warehouseId           String?               @db.Uuid
  warehouseCodeSnapshot String?
  nfeNumber             String?
  nfeId                 String?
  notes                 String?
  approvedAt            DateTime?             @db.Timestamptz(6)
  approvedByUserId      String?
  reversedAt            DateTime?             @db.Timestamptz(6)
  /// Soft link futuro ao movimento PURCHASE_ENTRY gerado (InventoryMovement.id).
  inventoryMovementId   String?               @unique @db.Uuid
  /// Soft link futuro ao REVERSAL correspondente.
  reversalMovementId    String?               @unique @db.Uuid
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items         PurchaseReceiptItem[]
  approvals     PurchaseApproval[]    @relation("PurchaseApprovalReceipt")

  @@index([purchaseOrderId])
  @@index([status])
  @@index([receivedAt])
  @@index([warehouseId])
  @@index([createdAt])
}

model PurchaseReceiptItem {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  receiptId             String   @db.Uuid
  purchaseOrderItemId   String   @db.Uuid
  materialId            String?  @db.Uuid
  materialCodeSnapshot  String?
  materialDescriptionSnapshot String?
  quantityReceived      Decimal  @db.Decimal(20, 6)
  quantityAccepted      Decimal  @db.Decimal(20, 6)
  quantityRejected      Decimal  @default(0) @db.Decimal(20, 6)
  unit                  String
  unitCostSnapshot      Decimal? @db.Decimal(20, 6)
  /// Soft link futuro a movimento de linha (se postagem por linha).
  inventoryMovementId   String?  @db.Uuid
  notes                 String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  receipt           PurchaseReceipt   @relation(fields: [receiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  material          Material?         @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([receiptId, purchaseOrderItemId])
  @@index([receiptId])
  @@index([purchaseOrderItemId])
  @@index([materialId])
  @@index([inventoryMovementId])
}

/// Evidências / anexos polimórficos do domínio de Compras SC.
model PurchaseEvidence {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType       PurchaseEvidenceEntityType
  entityId         String                    @db.Uuid
  fileName         String
  originalFileName String
  mimeType         String
  fileSize         Int
  storageKey       String
  /// SHA-256 do conteúdo (identificação/integridade).
  contentHash      String?
  evidenceType     PurchaseEvidenceType      @default(OTHER)
  /// Descrição operacional do anexo.
  description      String?
  notes            String?
  uploadedBy       String?
  uploadedByName   String?
  uploadedAt       DateTime                  @default(now()) @db.Timestamptz(6)
  /// Soft-delete / substituição com auditoria (sem apagar silenciosamente).
  deletedAt        DateTime?                 @db.Timestamptz(6)
  deletedBy        String?
  deleteReason     String?
  /// Evidência anterior que esta substitui (cadeia de histórico).
  replacesId       String?                   @db.Uuid
  lockedAt         DateTime?                 @db.Timestamptz(6)
  lockedReason     String?

  replaces      PurchaseEvidence?              @relation("PurchaseEvidenceReplace", fields: [replacesId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacedBy    PurchaseEvidence[]             @relation("PurchaseEvidenceReplace")
  historyEvents PurchaseEvidenceHistoryEvent[]

  @@index([entityType, entityId])
  @@index([uploadedAt])
  @@index([storageKey])
  @@index([contentHash])
  @@index([deletedAt])
  @@index([replacesId])
}

/// Histórico append-only de evidências de Compras SC.
model PurchaseEvidenceHistoryEvent {
  id          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenceId  String                        @db.Uuid
  action      PurchaseEvidenceHistoryAction
  reason      String?
  userId      String?
  userName    String?
  metaJson    Json?
  createdAt   DateTime                      @default(now()) @db.Timestamptz(6)

  evidence PurchaseEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([evidenceId, createdAt])
  @@index([action])
}

// ---------------------------------------------------------------------------
// Módulo Comissões — camada aditiva isolada (referências Nomus por ID externo).
// ---------------------------------------------------------------------------

enum CommissionPersonType {
  SELLER
  REPRESENTATIVE
  MANAGER
  OTHER
}

enum CommissionPersonSource {
  NOMUS
  MANUAL
}

enum CommissionRuleBeneficiaryType {
  SELLER
  REPRESENTATIVE
  FIXED_PERSON
}

enum CommissionRuleCalculationType {
  FIXED_PERCENT
  COMMERCIAL_PRICE_TIER
}

enum CommissionRuleBaseType {
  SALES_ORDER_ITEM_NET
  OUTPUT_DOCUMENT_ITEM_NET
  RECEIVABLE_AMOUNT
}

enum CommissionReleaseRule {
  SALES_ORDER_CREATED
  OUTPUT_DOCUMENT_CREATED
  FIRST_RECEIVABLE_PAID
  EACH_RECEIVABLE_PAID
}

enum CommissionCalculationRunMode {
  FORECAST
  CONFIRMATION
  RELEASE
  FULL_RECALC
}

enum CommissionCalculationRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum CommissionRecordSource {
  INDUSCOST_CALCULATED
}

enum CommissionRecordOriginStage {
  SALES_ORDER
  OUTPUT_DOCUMENT
}

enum CommissionRecordStatus {
  FORECAST_FROM_ORDER
  WAITING_NFE
  SUPERSEDED_BY_OUTPUT_DOCUMENT
  CONFIRMED_BY_OUTPUT_DOCUMENT
  WAITING_RECEIVABLE
  WAITING_PAYMENT
  PARTIALLY_RELEASED
  RELEASED
  PAID_PARTIAL
  PAID_TOTAL
  CANCELLED
  REVERSED
  ERROR
}

enum CommissionPaymentScheduleSource {
  SALES_ORDER_INSTALLMENT
  ACCOUNTS_RECEIVABLE
}

enum CommissionPaymentScheduleStatus {
  FORECAST
  ACTIVE
  SUPERSEDED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REVIEW
}

enum CommissionPaymentBatchStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum CommissionPaymentBatchItemStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

enum CommissionAuditIssueSeverity {
  INFO
  WARNING
  CRITICAL
}

enum CommissionAuditIssueType {
  ORDER_WITHOUT_SELLER
  ORDER_WITHOUT_REPRESENTATIVE
  NO_COMMISSION_RULE
  ORDER_WITHOUT_NFE
  NFE_WITHOUT_OUTPUT_DOCUMENT
  NFE_WITHOUT_RECEIVABLE
  OUTPUT_DOCUMENT_WITHOUT_ORDER_MATCH
  RECEIVABLE_WITHOUT_NFE
  CANCELLED_NFE_WITH_ACTIVE_COMMISSION
  RECEIVED_WITHOUT_RELEASE
  PAID_WITHOUT_RELEASE
  DIVERGENT_AMOUNT
  MANUAL_REVIEW_REQUIRED
  NO_COMMERCIAL_PRICE_TABLE
  BELOW_MINIMUM_COMMERCIAL_TABLE_PRICE
  OUT_OF_TABLE_PRICE_COMMISSION
  MISSING_OFFICIAL_PRODUCT_COST
  INVALID_COMMERCIAL_PRICE_RANGE
  NO_COMMISSION_TABLE_RATE
}

enum CommissionCustomerExclusionRuleStatus {
  ACTIVE
  INACTIVE
}

enum CommissionPersonAliasStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum CommissionPersonAliasSource {
  NOMUS_ORDER
  NOMUS_NFE
  NOMUS_AR
  COMMISSION_RECORD
  MANUAL
  IMPORT
  OTHER
}

enum CommissionMonthlyClosingStatus {
  DRAFT
  PREVIEWED
  CLOSED
  CANCELLED
  REPROCESSED
}

enum CommissionMonthlyClosingSource {
  RECEIPT_BASED
}

enum CommissionReceiptLedgerLineStatus {
  COMMISSIONABLE
  CUSTOMER_EXCLUDED
  GROUP_COMPANY_EXCLUDED
  NO_SALES_LINK
  NO_SCHEDULE
  NO_SELLER
  SELLER_UNRESOLVED
  NO_RULE
  STALE_SCHEDULE
  ZERO_AMOUNT
  ERROR
}

model CommissionPerson {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nomusPersonId Int?
  name          String
  type          CommissionPersonType
  source        CommissionPersonSource @default(MANUAL)
  email         String?
  document      String?
  active        Boolean                @default(true)
  notes         String?
  personId      String?                @db.Uuid
  createdAt     DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime               @default(now()) @updatedAt @db.Timestamptz(6)

  person               Person?                        @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  fixedCommissionRules CommissionRule[]               @relation("CommissionRuleFixedPerson")
  commissionRecords    CommissionRecord[]
  paymentBatches       CommissionPaymentBatch[]
  customerExceptions   CommissionCustomerException[]
  sellerAliases        CommissionPersonAlias[]
  receiptLedgerLines   CommissionReceiptLedgerLine[]  @relation("ReceiptLedgerCanonicalSeller")
  orderSnapshots       CommissionOrderSnapshot[]      @relation("OrderSnapshotCanonicalSeller")
  receivableSchedules  CommissionReceivableSchedule[] @relation("ReceivableScheduleCanonicalSeller")

  @@index([nomusPersonId])
  @@index([type])
  @@index([active])
  @@index([name])
  @@index([personId])
}

model CommissionPersonAlias {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionedPersonId String                      @db.Uuid
  source               CommissionPersonAliasSource @default(MANUAL)
  rawSellerId          Int?
  rawSellerName        String
  normalizedSellerName String
  status               CommissionPersonAliasStatus @default(ACTIVE)
  confidence           Decimal?                    @db.Decimal(5, 4)
  notes                String?
  createdBy            String?
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  commissionedPerson CommissionPerson @relation(fields: [commissionedPersonId], references: [id], onDelete: Cascade)

  @@index([commissionedPersonId])
  @@index([rawSellerId])
  @@index([normalizedSellerName])
  @@index([status])
  @@index([source, rawSellerId])
}

model CommissionRule {
  id                      String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  description             String?
  active                  Boolean                       @default(true)
  priority                Int                           @default(100)
  beneficiaryType         CommissionRuleBeneficiaryType
  calculationType         CommissionRuleCalculationType @default(FIXED_PERCENT)
  fixedCommissionPersonId String?                       @db.Uuid
  ratePercent             Decimal                       @db.Decimal(10, 4)
  baseType                CommissionRuleBaseType
  releaseRule             CommissionReleaseRule
  validFrom               DateTime?                     @db.Timestamptz(6)
  validTo                 DateTime?                     @db.Timestamptz(6)
  createdAt               DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                      @default(now()) @updatedAt @db.Timestamptz(6)

  fixedCommissionPerson CommissionPerson?             @relation("CommissionRuleFixedPerson", fields: [fixedCommissionPersonId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  conditions            CommissionRuleCondition[]
  receiptLedgerLines    CommissionReceiptLedgerLine[]

  orderItemSnapshots CommissionOrderItemSnapshot[]

  @@index([active])
  @@index([priority])
  @@index([beneficiaryType])
  @@index([validFrom, validTo])
}

model CommissionRuleCondition {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ruleId                     String   @db.Uuid
  companyExternalId          Int?
  customerExternalId         Int?
  customerUf                 String?
  nomusSellerId              Int?
  nomusRepresentativeId      Int?
  productExternalId          Int?
  productGroupExternalId     Int?
  priceTableExternalId       Int?
  paymentConditionExternalId Int?
  movementTypeExternalId     Int?
  minOrderAmount             Decimal? @db.Decimal(20, 2)
  maxOrderAmount             Decimal? @db.Decimal(20, 2)
  minDiscountPercent         Decimal? @db.Decimal(10, 4)
  maxDiscountPercent         Decimal? @db.Decimal(10, 4)
  createdAt                  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  rule CommissionRule @relation(fields: [ruleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ruleId])
  @@index([nomusSellerId])
  @@index([customerExternalId])
  @@index([productExternalId])
}

model CommissionCalculationRun {
  id                       String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodStart              DateTime                       @db.Timestamptz(6)
  periodEnd                DateTime                       @db.Timestamptz(6)
  mode                     CommissionCalculationRunMode
  status                   CommissionCalculationRunStatus @default(RUNNING)
  ordersEvaluated          Int                            @default(0)
  nfeEvaluated             Int                            @default(0)
  outputDocumentsEvaluated Int                            @default(0)
  receivablesEvaluated     Int                            @default(0)
  commissionsCreated       Int                            @default(0)
  commissionsUpdated       Int                            @default(0)
  commissionsSuperseded    Int                            @default(0)
  errorsCount              Int                            @default(0)
  summaryJson              Json?
  startedAt                DateTime                       @default(now()) @db.Timestamptz(6)
  finishedAt               DateTime?                      @db.Timestamptz(6)
  createdAt                DateTime                       @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                       @default(now()) @updatedAt @db.Timestamptz(6)

  commissionRecords CommissionRecord[]

  @@index([status])
  @@index([mode])
  @@index([periodStart, periodEnd])
  @@index([startedAt])
}

model CommissionRecord {
  id                        String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calculationRunId          String?                     @db.Uuid
  source                    CommissionRecordSource      @default(INDUSCOST_CALCULATED)
  originStage               CommissionRecordOriginStage
  status                    CommissionRecordStatus
  nomusOrderId              Int?
  orderCode                 String?
  nomusOrderItemId          Int?
  nomusProductId            Int?
  productCode               String?
  productName               String?
  nomusNfeId                Int?
  nfeNumber                 String?
  nomusOutputDocumentId     Int?
  nomusOutputDocumentItemId Int?
  commissionPersonId        String                      @db.Uuid
  nomusSellerId             Int?
  nomusRepresentativeId     Int?
  customerExternalId        Int?
  customerName              String?
  companyExternalId         Int?
  baseAmount                Decimal                     @db.Decimal(20, 2)
  ratePercent               Decimal                     @db.Decimal(10, 4)
  commissionAmount          Decimal                     @db.Decimal(20, 2)
  releasedAmount            Decimal                     @default(0) @db.Decimal(20, 2)
  paidAmount                Decimal                     @default(0) @db.Decimal(20, 2)
  balanceAmount             Decimal                     @default(0) @db.Decimal(20, 2)
  releaseRule               CommissionReleaseRule
  calculationHash           String                      @unique
  metadataJson              Json?
  calculatedAt              DateTime                    @default(now()) @db.Timestamptz(6)
  confirmedAt               DateTime?                   @db.Timestamptz(6)
  releasedAt                DateTime?                   @db.Timestamptz(6)
  paidAt                    DateTime?                   @db.Timestamptz(6)
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  calculationRun     CommissionCalculationRun?     @relation(fields: [calculationRunId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  commissionPerson   CommissionPerson              @relation(fields: [commissionPersonId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  paymentSchedules   CommissionPaymentSchedule[]
  paymentBatchItems  CommissionPaymentBatchItem[]
  receiptLedgerLines CommissionReceiptLedgerLine[]

  @@index([orderCode])
  @@index([nomusOrderId])
  @@index([nomusNfeId])
  @@index([commissionPersonId])
  @@index([status])
  @@index([originStage])
  @@index([calculatedAt])
  @@index([nomusSellerId])
  @@index([customerExternalId])
}

model CommissionPaymentSchedule {
  id                       String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commissionRecordId       String                          @db.Uuid
  source                   CommissionPaymentScheduleSource
  status                   CommissionPaymentScheduleStatus @default(FORECAST)
  nomusOrderId             Int?
  nomusNfeId               Int?
  nomusReceivableId        Int?
  installmentNumber        Int?
  dueDate                  DateTime?                       @db.Timestamptz(6)
  expectedAmount           Decimal?                        @db.Decimal(20, 2)
  receivableAmount         Decimal?                        @db.Decimal(20, 2)
