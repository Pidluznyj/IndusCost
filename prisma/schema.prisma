  model             String
  modelYear         Int?
  manufactureYear   Int?
  color             String?
  vehicleType       String?
  fuelType          String?
  origin            FleetVehicleOrigin   @default(OWNED)
  status            FleetVehicleStatus   @default(AVAILABLE)
  ownershipType     String?
  currentKm         Decimal              @default(0) @db.Decimal(20, 6)
  initialKm         Decimal              @default(0) @db.Decimal(20, 6)
  unit              String?
  costCenter        String?
  responsibleUserId String?              @db.Uuid
  notes             String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime             @default(now()) @updatedAt @db.Timestamptz(6)
