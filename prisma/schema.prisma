/// Modo de materialização da conciliação de carteira (script manual; sem cron nesta etapa).
enum PortfolioReconciliationRunMode {
  preview
  apply
  manual
}

enum PortfolioReconciliationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

/// Fonte da previsão de caixa na camada paralela (não oficial).
enum PortfolioReconciliationForecastSource {
  RECEIVABLE
  NFE
  ORDER
  UNRESOLVED
}

enum PortfolioReconciliationConfidenceLevel {
  HIGH
  MEDIUM
  LOW
  BLOCKED
}

/// Metadados de uma materialização da Conciliação de Carteira (camada paralela / auditoria).
/// Não altera Fluxo de Caixa, Contas a Receber, Faturamento nem Comissões.
model PortfolioReconciliationRun {
  id String @id @default(uuid())

  startedAt  DateTime?
  finishedAt DateTime?
  status     PortfolioReconciliationRunStatus @default(PENDING)
  mode       PortfolioReconciliationRunMode

  fromDate DateTime?
  toDate   DateTime?

  customerExternalId Int?
  filtersJson        Json?
  summaryJson        Json?
  errorMessage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facts PortfolioReconciliationFact[]

  @@index([status])
  @@index([mode])
  @@index([startedAt])
  @@index([fromDate, toDate])
  @@index([customerExternalId])
  @@index([createdAt])
}

/// Fato materializado de conciliação Pedido × NF × Documento de Estoque × CR × previsão.
/// Camada paralela para auditoria/comparação por run — não é fonte oficial do financeiro.
model PortfolioReconciliationFact {
  id String @id @default(uuid())

  runId String
  run   PortfolioReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  customerId           String?
  customerExternalId   Int?
  customerNameSnapshot String?

  salesOrderId             String?
  externalSalesOrderId     Int?
  orderCode                String?
  orderIssueDate           DateTime?
  expectedDeliveryDate     DateTime?
  salesOrderItemId         String?
  externalSalesOrderItemId Int?
  externalProductId        Int?
  productSkuSnapshot       String?
  productNameSnapshot      String?

  orderQuantity  Decimal? @db.Decimal(20, 6)
  orderUnitPrice Decimal? @db.Decimal(20, 6)
  orderItemValue Decimal? @db.Decimal(20, 6)

  nomusNfeId     String?
  nfeExternalId  Int?
  nfeNumber      String?
  nfeSerie       String?
  nfeKey         String?
  nfeProcessedAt DateTime?
  nfeHeaderValue Decimal?  @db.Decimal(20, 6)

  stockDocumentId             String?
  stockDocumentExternalId     Int?
  stockDocumentItemId         String?
  stockDocumentItemExternalId Int?
  stockDocumentDate           DateTime?
  stockQuantity               Decimal?  @db.Decimal(20, 6)
  stockUnitValue              Decimal?  @db.Decimal(20, 6)
  stockItemValue              Decimal?  @db.Decimal(20, 6)

  allocatedQuantity                     Decimal? @db.Decimal(20, 6)
  allocatedValueByOrderPrice            Decimal? @db.Decimal(20, 6)
  allocatedValueByStockPrice            Decimal? @db.Decimal(20, 6)
  remainingOrderQuantityAfterAllocation Decimal? @db.Decimal(20, 6)
  remainingOrderValueAfterAllocation    Decimal? @db.Decimal(20, 6)
  priceDifferenceUnit                   Decimal? @db.Decimal(20, 6)
  priceDifferenceTotal                  Decimal? @db.Decimal(20, 6)

  receivableIdsJson    Json?
  receivableTotalValue Decimal? @db.Decimal(20, 6)
  receivedValue        Decimal? @db.Decimal(20, 6)
  openReceivableValue  Decimal? @db.Decimal(20, 6)
  dueDatesJson         Json?
  settlementDatesJson  Json?

  forecastSource  PortfolioReconciliationForecastSource  @default(UNRESOLVED)
  forecastDate    DateTime?
  forecastValue   Decimal?                               @db.Decimal(20, 6)
  confidenceLevel PortfolioReconciliationConfidenceLevel @default(LOW)
  /// Status dominante da linha (ex.: ORDER_ONLY, ITEM_ALLOCATED, PRICE_MISMATCH).
  status          String?
  alertsJson      Json?
  traceJson       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([runId])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
  @@index([customerExternalId])
  @@index([externalSalesOrderId])
  @@index([orderCode])
  @@index([nfeExternalId])
  @@index([stockDocumentExternalId])
  @@index([externalProductId])
  @@index([forecastDate])
  @@index([status])
  @@index([confidenceLevel])
  @@index([forecastSource])
}

/// Calendário de pagamento por cliente (camada Conciliação de Carteira).
/// Isolado do cadastro oficial de Customer e do Fluxo/AR/Faturamento/Comissões.
model PortfolioCustomerPaymentRule {
  id String @id @default(uuid())

  customerExternalId   Int     @unique
  customerNameSnapshot String?

  /// Dias do mês permitidos para pagamento, ex.: [10, 20, 30].
  allowedDaysJson Json

  defaultTermDays      Int     @default(0)
  moveToNextAllowedDay Boolean @default(true)
  isActive             Boolean @default(true)
  notes                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([customerExternalId])
}

/// NF-e Nomus sincronizada via `/rest/nfes` — fonte oficial futura do Financeiro > Faturamento.
model NomusNfe {
  id String @id @default(uuid())

  externalId Int @unique

  chave  String?
  numero String?
  serie  String?

  status       Int?
  tipoOperacao Int?
  tipoEmissao  Int?
  finalidade   Int?
  isFornecedor Int?
  ambiente     Int?
  cnpjEmitente String?
  protocolo    String?
  recibo       String?

  dataProcessamento DateTime?
  horaProcessamento String?

  xmlRaw                    String? @db.Text
  xmlCancelamento           String? @db.Text
  justificativaCancelamento String? @db.Text

  xmlNatOp       String?
  xmlDhEmi       DateTime?
  xmlTpNF        Int?
  xmlDestCnpjCpf String?
  xmlVProd       Decimal?  @db.Decimal(20, 2)
  xmlVDesc       Decimal?  @db.Decimal(20, 2)
  xmlVNF         Decimal?  @db.Decimal(20, 2)
  valorLiquido   Decimal?  @db.Decimal(20, 2)

  billingClassification NomusNfeBillingClassification?
  isFiscalBilling       Boolean                        @default(false)
  isMarketSale          Boolean                        @default(false)

  xmlQualityAlert String?

  rawPayload  Json
  payloadHash String

  syncedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fiscalSummary NomusNfeFiscalSummary?
  taxLines      NomusNfeTaxLine[]

  @@index([dataProcessamento])
  @@index([xmlDhEmi])
  @@index([status])
  @@index([billingClassification])
  @@index([isMarketSale])
  @@index([numero])
  @@index([xmlDestCnpjCpf])
  @@index([syncedAt])
  @@index([payloadHash])
}

/// Resumo fiscal 1:1 da NF-e (totais oficiais do XML — camada A / destacado).
/// Não representa apuração, pagamento nem alocação gerencial.
model NomusNfeFiscalSummary {
  id         String   @id @default(uuid())
  nomusNfeId String   @unique
  nomusNfe   NomusNfe @relation(fields: [nomusNfeId], references: [id], onDelete: Cascade)

  parserVersion String
  /// XML | MISSING | PARTIAL
  source        String
  xmlHash       String?
  parsedAt      DateTime

  /// Espelha status Nomus cancelado (documento ainda pode ter tributos destacados).
  isCancelled Boolean @default(false)
  /// ide/finNFe quando presente (1=normal, 2=complementar, 3=ajuste, 4=devolução).
  finalidade  Int?
  tpNF        Int?

  vProd      Decimal? @db.Decimal(20, 2)
  vDesc      Decimal? @db.Decimal(20, 2)
  vFrete     Decimal? @db.Decimal(20, 2)
  vSeg       Decimal? @db.Decimal(20, 2)
  vOutro     Decimal? @db.Decimal(20, 2)
  vII        Decimal? @db.Decimal(20, 2)
  vIPI       Decimal? @db.Decimal(20, 2)
  vIPIDevol  Decimal? @db.Decimal(20, 2)
  vBC        Decimal? @db.Decimal(20, 2)
  vICMS      Decimal? @db.Decimal(20, 2)
  vICMSDeson Decimal? @db.Decimal(20, 2)
  vBCST      Decimal? @db.Decimal(20, 2)
  vST        Decimal? @db.Decimal(20, 2)
  vFCP       Decimal? @db.Decimal(20, 2)
  vFCPST     Decimal? @db.Decimal(20, 2)
  vFCPSTRet  Decimal? @db.Decimal(20, 2)
  vPIS       Decimal? @db.Decimal(20, 2)
  vCOFINS    Decimal? @db.Decimal(20, 2)
  vISS       Decimal? @db.Decimal(20, 2)
  vTotTrib   Decimal? @db.Decimal(20, 2)
  vNF        Decimal? @db.Decimal(20, 2)

  /// Totais futuros (IBS/CBS/IS etc.) sem migration por tag.
  extensibleTotals Json?

  /// Gap residual após componentes conhecidos (auditoria; não é saldo financeiro).
  highlightedResidual Decimal? @db.Decimal(20, 2)
  qualityAlert        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxLines NomusNfeTaxLine[]

  @@index([parserVersion])
  @@index([parsedAt])
  @@index([isCancelled])
}

/// Linha de tributo oficial (HEADER = ICMSTot; ITEM = det/imposto).
/// Consumidores não devem somar HEADER+ITEM do mesmo taxType.
model NomusNfeTaxLine {
  id         String                @id @default(uuid())
  nomusNfeId String
  summaryId  String
  nomusNfe   NomusNfe              @relation(fields: [nomusNfeId], references: [id], onDelete: Cascade)
  summary    NomusNfeFiscalSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)

  /// Chave estável: H:IPI | I:1:ICMS
  lineKey    String
  taxType    String
  /// HEADER | ITEM
  scope      String
  itemNumber Int?

  baseAmount Decimal? @db.Decimal(20, 4)
  rate       Decimal? @db.Decimal(12, 6)
  amount     Decimal? @db.Decimal(20, 4)

  cst   String?
  csosn String?
  cfop  String?
  ncm   String?

  /// Metadados limitados (grupo ICMS, paths extras).
  metadata   Json?
  source     String
  sourcePath String?
  parsedAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nomusNfeId, lineKey])
  @@index([nomusNfeId, scope, taxType])
  @@index([summaryId])
  @@index([taxType])
}

// —— Camadas B/C/D — apuração, guias de recolhimento, alocação gerencial ——
// Destacados da NF (camada A) NÃO são sinônimos de apurado/pago.
// Pagamento oficial hospeda-se em NomusAccountsPayable quando vinculado.

enum FiscalJurisdiction {
  FEDERAL
  STATE
  MUNICIPAL
  REFORM
}

enum FiscalApurationStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum FiscalApurationLineNature {
  DEBIT
  CREDIT
  RETENTION
  COMPENSATION
  INTEREST
  FINE
}

enum FiscalGuideType {
  DARF
  GNRE
  DAS
  DAE
  GPS
  STATE_GUIDE
  MUNICIPAL_GUIDE
  OTHER
}

enum FiscalGuideStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  REVERSED
}

enum FiscalAllocationMethod {
  PRO_RATA_HIGHLIGHTED
  DIRECT_GUIDE_NFE
  MANUAL
}

/// Período de apuração fiscal (camada B) — consolidado por competência, não por NF.
model FiscalApurationPeriod {
  id String @id @default(uuid())

  companyName  String?
  jurisdiction FiscalJurisdiction
  uf           String?
  periodStart  DateTime              @db.Date
  periodEnd    DateTime              @db.Date
  status       FiscalApurationStatus @default(OPEN)
  notes        String?
  /// MANUAL | IMPORT
  source       String                @default("MANUAL")

  closedAt        DateTime?
  closedByUserId  String?
  createdByUserId String?
  createdByName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines  FiscalApurationLine[]
  guides FiscalPaymentGuide[]

  @@index([periodStart, periodEnd])
  @@index([jurisdiction, status])
  @@index([uf])
  @@index([companyName])
}

/// Linha de apuração (débito/crédito/compensação/juros/multa).
model FiscalApurationLine {
  id       String                @id @default(uuid())
  periodId String
  period   FiscalApurationPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  taxType             String
  nature              FiscalApurationLineNature
  revenueCode         String?
  assessedAmount      Decimal                   @default(0) @db.Decimal(20, 2)
  creditsAmount       Decimal                   @default(0) @db.Decimal(20, 2)
  compensationsAmount Decimal                   @default(0) @db.Decimal(20, 2)
  interestAmount      Decimal                   @default(0) @db.Decimal(20, 2)
  fineAmount          Decimal                   @default(0) @db.Decimal(20, 2)
  /// Devido líquido da linha (apurado − crédito − compensação + juros + multa).
  amountDue           Decimal                   @default(0) @db.Decimal(20, 2)
  notes               String?
  source              String                    @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodId, taxType])
  @@index([nature])
  @@index([revenueCode])
}

/// Guia / documento de arrecadação (camada C) — recolhimento.
/// Opcionalmente vinculada a NomusAccountsPayable.externalId (hospedeiro oficial do pago).
model FiscalPaymentGuide {
  id String @id @default(uuid())

  periodId String?
  period   FiscalApurationPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  taxType      String
  jurisdiction FiscalJurisdiction
  revenueCode  String?
  guideType    FiscalGuideType
  guideNumber  String?
  barcode      String?

  periodStart DateTime  @db.Date
  periodEnd   DateTime  @db.Date
  dueDate     DateTime? @db.Date

  assessedAmount      Decimal @default(0) @db.Decimal(20, 2)
  creditsAmount       Decimal @default(0) @db.Decimal(20, 2)
  compensationsAmount Decimal @default(0) @db.Decimal(20, 2)
  interestAmount      Decimal @default(0) @db.Decimal(20, 2)
  fineAmount          Decimal @default(0) @db.Decimal(20, 2)
  amountDue           Decimal @default(0) @db.Decimal(20, 2)
  amountPaid          Decimal @default(0) @db.Decimal(20, 2)
  /// Saldo em aberto da guia (amountDue − amountPaid), nunca confundir com residual de NF.
  balanceDue          Decimal @default(0) @db.Decimal(20, 2)

  paidAt DateTime?
  status FiscalGuideStatus @default(DRAFT)

  paymentAccount            String?
  /// FK lógica → NomusAccountsPayable.externalId (sem constraint: espelho Nomus).
  accountsPayableExternalId Int?
  costCenterId              String?

  /// Chave de não-duplicação (guideType|guideNumber|revenueCode|periodStart|periodEnd).
  dedupeKey String? @unique

  /// MANUAL | IMPORT | AP_LINK
  source String  @default("MANUAL")
  notes  String?

  cancelledAt       DateTime?
  cancelledByUserId String?
  createdByUserId   String?
  createdByName     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proofs      FiscalPaymentProof[]
  allocations FiscalAllocation[]

  @@index([status, dueDate])
  @@index([guideType, guideNumber])
  @@index([taxType])
  @@index([accountsPayableExternalId])
  @@index([periodStart, periodEnd])
  @@index([periodId])
}

/// Comprovante / anexo de pagamento da guia.
model FiscalPaymentProof {
  id      String             @id @default(uuid())
  guideId String
  guide   FiscalPaymentGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  fileName         String
  originalFileName String
  mimeType         String
  fileSize         Int
  storageKey       String
  notes            String?
  uploadedBy       String?
  uploadedAt       DateTime @default(now())

  @@index([guideId, uploadedAt(sort: Desc)])
}

/// Alocação gerencial do recolhimento a pedido/NF (camada D).
/// Nunca apresentar como pagamento oficial específico da NF.
model FiscalAllocation {
  id      String             @id @default(uuid())
  guideId String
  guide   FiscalPaymentGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)

  salesOrderId String?
  nomusNfeId   String?

  taxType          String
  allocatedAmount  Decimal                @db.Decimal(20, 2)
  allocationMethod FiscalAllocationMethod
  allocationBase   Decimal?               @db.Decimal(20, 2)
  periodStart      DateTime?              @db.Date
  periodEnd        DateTime?              @db.Date
  calculatedAt     DateTime               @default(now())
  version          Int                    @default(1)
  manualOverride   Boolean                @default(false)
  notes            String?

  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([guideId])
  @@index([salesOrderId])
  @@index([nomusNfeId])
  @@index([taxType])
  @@index([allocationMethod])
}

/// Auditoria de mutações em apuração / guias / alocações.
model FiscalSettlementAuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

enum NomusOptionalPricingSelectionMode {
