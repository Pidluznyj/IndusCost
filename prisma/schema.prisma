/// Job/snapshot da revalidação read-only do painel auto-apply BOM (preview controlado).
model NomusAutoApplyDashboardSnapshot {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status                  String    @default("RUNNING")
  startedAt               DateTime  @default(now()) @db.Timestamptz(6)
  finishedAt              DateTime? @db.Timestamptz(6)
  generatedAt             DateTime? @db.Timestamptz(6)
  totalProducts           Int       @default(0)
  eligibleProducts        Int       @default(0)
  processedProducts       Int       @default(0)
  revalidatedProductCount Int       @default(0)
  revalidationErrorCount  Int       @default(0)
  currentParentCode       String?
  resultJson              Json?
  errorMessage            String?
  createdByUserId         String?   @db.Uuid
  createdAt               DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status])
  @@index([startedAt])
  @@index([generatedAt])
}

enum EngineeringChangeEntityType {
  PRODUCT
  PRODUCT_BOM
  MATERIAL
  ROUTING
  PRICE_INPUT
}

enum EngineeringChangeOrigin {
  NOMUS_SYNC
  NOMUS_ENGINEERING_APPLY
  MANUAL_EDIT
  LOCAL_EXCEPTION
}

/// Log antes/depois de cada alteração de engenharia (produto, linha BOM, etc.).
model EngineeringChangeLog {
  id           String                      @id @default(uuid())
  entityType   EngineeringChangeEntityType
  entityId     String?
  productId    String?                     @db.Uuid
  productSku   String?
  sourceSystem String?
  changeOrigin EngineeringChangeOrigin
  fieldName    String?
  oldValue     String?
  newValue     String?
  oldValueJson Json?
  newValueJson Json?
  changedBy    String?
  changedAt    DateTime                    @default(now())
  runId        String?
  planHash     String?
  reason       String?
  createdAt    DateTime                    @default(now())
