// —— Projetos (orçamentos técnicos / simulações) ——

enum ProjectType {
  NEW_PRODUCT
  NEW_COMPONENT
  MOLD
  PRODUCT_CHANGE
  PRODUCT_WITH_NEW_COMPONENT
  FULL_DEVELOPMENT
  QUICK_ESTIMATE
}

enum ProjectStatus {
  DRAFT
  TECHNICAL_ANALYSIS
  WAITING_QUOTATION
  WAITING_INTERNAL_APPROVAL
  SENT_TO_CUSTOMER
  NEGOTIATION
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum ProjectSimulatedItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_PRODUCT
  PACKAGING
  SERVICE
  MOLD
  TOOLING
  OUTSOURCED_PROCESS
  OTHER
}

enum ProjectStructureSourceType {
  EXISTING_PRODUCT
  EXISTING_MATERIAL
  SIMULATED_ITEM
  MANUAL
}

enum ProjectStructureLineType {
  RAW_MATERIAL
  COMPONENT
  PACKAGING
  SERVICE
  PROCESS
  MOLD_AMORTIZATION
  OTHER
}

enum ProjectMoldChargeMode {
  CHARGED_SEPARATELY
  AMORTIZED_IN_PRODUCT
  PARTIALLY_ABSORBED
  INTERNAL_INVESTMENT
}

enum ProjectMoldOwnership {
  CUSTOMER
  COMPANY
  SHARED
  UNDEFINED
}

enum ProjectCostAmortizationSourceType {
  MOLD
  OTHER_COST
}

enum ProjectCostAmortizationTargetType {
  OFFICIAL_PRODUCT
  OFFICIAL_COMPONENT
  SIMULATION
  LEGACY
}

enum ProjectCostAmortizationStatus {
  NOT_CONFIGURED
  INCOMPLETE
  EXCESS
  DISTRIBUTED
  NO_ELIGIBLE_ITEMS
}

model Project {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                Int           @unique @default(autoincrement())
  code                  String        @unique
  title                 String
  customerName          String
  customerDocument      String?
  description           String?
  projectType           ProjectType
  status                ProjectStatus @default(DRAFT)
  commercialOwner       String?
  technicalOwner        String?
  expectedMonthlyVolume Decimal?      @db.Decimal(20, 6)
  targetPrice           Decimal?      @db.Decimal(20, 6)
  targetMarginPercent   Decimal?      @db.Decimal(10, 6)
  notes                 String?
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  versions          ProjectVersion[]
  simulatedProducts ProjectSimulatedProduct[]
  simulatedItems    ProjectSimulatedItem[]
  structureLines    ProjectStructureLine[]
  molds             ProjectMold[]
  costAmortizations ProjectCostAmortization[]
  pricingConfig     ProjectPricingConfig?
  pricingItems      ProjectPricingItem[]

  @@index([status])
  @@index([projectType])
  @@index([customerName])
  @@index([updatedAt])
}

enum ProjectPricingItemStatus {
  NO_COST
  PENDING
  CALCULATED
  ERROR
}

model ProjectPricingConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String   @unique @db.Uuid
  fiscalRuleId         String?  @db.Uuid
  defaultMarginPercent Decimal? @db.Decimal(10, 6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fiscalRule TaxRule? @relation(fields: [fiscalRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items      ProjectPricingItem[]

  @@index([fiscalRuleId])
}

model ProjectPricingItem {
  id                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                    String                     @db.Uuid
  configId                     String                     @db.Uuid
  targetItemId                 String
  targetItemType               ProjectCostAmortizationTargetType
  targetDescriptionSnapshot    String
  fiscalRuleId                 String?                    @db.Uuid
  fiscalRuleNameSnapshot       String?
  costBaseUnitSnapshot         Decimal                    @default(0) @db.Decimal(20, 6)
  amortizationUnitCostSnapshot Decimal                    @default(0) @db.Decimal(20, 6)
  finalUnitCostSnapshot        Decimal                    @default(0) @db.Decimal(20, 6)
  taxPercentSnapshot           Decimal                    @default(0) @db.Decimal(10, 6)
  targetMarginPercent          Decimal                    @default(0) @db.Decimal(10, 6)
  suggestedPrice               Decimal?                   @db.Decimal(20, 6)
  taxAmount                    Decimal?                   @db.Decimal(20, 6)
  marginAmount                 Decimal?                   @db.Decimal(20, 6)
  status                       ProjectPricingItemStatus   @default(PENDING)
  createdAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  config     ProjectPricingConfig @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fiscalRule TaxRule?             @relation("ProjectPricingItemFiscalRule", fields: [fiscalRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([projectId, targetItemId])
  @@index([projectId])
  @@index([configId])
  @@index([targetItemId])
}

model ProjectVersion {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String        @db.Uuid
  versionNumber          Int
  title                  String?
  status                 ProjectStatus @default(DRAFT)
  assumptionsJson        String?
  totalEstimatedCost     Decimal?      @db.Decimal(20, 6)
  totalMoldCost          Decimal?      @db.Decimal(20, 6)
  totalAmortizedMoldCost Decimal?      @db.Decimal(20, 6)
  unitCost               Decimal?      @db.Decimal(20, 6)
  suggestedPrice         Decimal?      @db.Decimal(20, 6)
  marginPercent          Decimal?      @db.Decimal(10, 6)
  markupPercent          Decimal?      @db.Decimal(10, 6)
  expectedVolume         Decimal?      @db.Decimal(20, 6)
  notes                  String?
  isCurrent              Boolean       @default(false)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  simulatedProducts ProjectSimulatedProduct[]
  simulatedItems    ProjectSimulatedItem[]
  structureLines    ProjectStructureLine[]
  molds             ProjectMold[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([isCurrent])
}

model ProjectSimulatedProduct {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String    @db.Uuid
  versionId       String    @db.Uuid
  provisionalCode String?
  description     String
  unit            String    @default("UN")
  estimatedWeight Decimal?  @db.Decimal(20, 6)
  expectedVolume  Decimal?  @db.Decimal(20, 6)
  batchSize       Decimal?  @db.Decimal(20, 6)
  notes           String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        ProjectVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  structureLines ProjectStructureLine[]

  @@index([projectId])
  @@index([versionId])
}

model ProjectSimulatedItem {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                 String                   @db.Uuid
  versionId                 String                   @db.Uuid
  provisionalCode           String?
  description               String
  itemType                  ProjectSimulatedItemType
  unit                      String                   @default("UN")
  estimatedUnitCost         Decimal?                 @db.Decimal(20, 6)
  quotedUnitCost            Decimal?                 @db.Decimal(20, 6)
  supplierName              String?
  leadTimeDays              Int?
  estimatedWeight           Decimal?                 @db.Decimal(20, 6)
  lossPercent               Decimal?                 @default(0) @db.Decimal(10, 6)
  requiresQuotation         Boolean                  @default(false)
  requiresEngineeringReview Boolean                  @default(false)
  canBecomeOfficial         Boolean                  @default(true)
  notes                     String?
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        ProjectVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  structureLines ProjectStructureLine[]

  @@index([projectId])
  @@index([versionId])
  @@index([itemType])
}

model ProjectStructureLine {
  id                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                    String                     @db.Uuid
  versionId                    String                     @db.Uuid
  simulatedProductId           String?                    @db.Uuid
  parentLineId                 String?                    @db.Uuid
  level                        Int?
  treePath                     String?
  snapshotRootProductId        String?                    @db.Uuid
  lineType                     ProjectStructureLineType
  sourceType                   ProjectStructureSourceType
  existingProductId            String?                    @db.Uuid
  existingMaterialId           String?                    @db.Uuid
  simulatedItemId              String?                    @db.Uuid
  sourceOfficialBomId          String?
  sourceOfficialRoutingId      String?
  descriptionSnapshot          String
  unitSnapshot                 String
  quantity                     Decimal                    @db.Decimal(20, 6)
  lossPercent                  Decimal?                   @default(0) @db.Decimal(10, 6)
  officialQuantitySnapshot     Decimal?                   @db.Decimal(20, 6)
  officialLossPercentSnapshot  Decimal?                   @db.Decimal(10, 6)
  officialUnitCostSnapshot     Decimal?                   @db.Decimal(20, 6)
  unitCostSnapshot             Decimal                    @db.Decimal(20, 6)
  totalCost                    Decimal                    @db.Decimal(20, 6)
  costSource                   String?
  isChangedFromOfficial        Boolean                    @default(false)
  isMissingCost                Boolean                    @default(false)
  countsInSimulatedProductCost Boolean                    @default(true)
  supplierNameSnapshot         String?
  notes                        String?
  sortOrder                    Int                        @default(0)
  createdAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version          ProjectVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  simulatedProduct ProjectSimulatedProduct? @relation(fields: [simulatedProductId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  parentLine       ProjectStructureLine?    @relation("StructureLineHierarchy", fields: [parentLineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  childLines       ProjectStructureLine[]   @relation("StructureLineHierarchy")
  existingProduct  Product?                 @relation(fields: [existingProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  existingMaterial Material?                @relation(fields: [existingMaterialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simulatedItem    ProjectSimulatedItem?    @relation(fields: [simulatedItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([projectId])
  @@index([versionId])
  @@index([simulatedProductId])
  @@index([parentLineId])
  @@index([snapshotRootProductId])
}

model ProjectMold {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String                @db.Uuid
  versionId              String                @db.Uuid
  name                   String
  moldType               String?
  cavities               Int?
  estimatedLifeCycles    Int?
  supplierName           String?
  constructionCost       Decimal               @default(0) @db.Decimal(20, 6)
  maintenanceCost        Decimal?              @db.Decimal(20, 6)
  changeCost             Decimal?              @db.Decimal(20, 6)
  leadTimeDays           Int?
  chargeMode             ProjectMoldChargeMode @default(CHARGED_SEPARATELY)
  amortizationQuantity   Decimal?              @db.Decimal(20, 6)
  amortizedCostPerUnit   Decimal?              @db.Decimal(20, 6)
  ownership              ProjectMoldOwnership  @default(UNDEFINED)
  notes                  String?
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
  @@index([versionId])
}

model ProjectCostAmortization {
  id                        String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                 String                            @db.Uuid
  sourceType                ProjectCostAmortizationSourceType
  sourceId                  String
  sourceBatchId             String?
  sourceDescriptionSnapshot String
  sourceTotalCostSnapshot   Decimal                           @db.Decimal(20, 6)
  passThroughPercent        Decimal                           @default(100) @db.Decimal(10, 6)
  passThroughAmount         Decimal                           @default(0) @db.Decimal(20, 6)
  absorbedAmount            Decimal                           @default(0) @db.Decimal(20, 6)
  status                    ProjectCostAmortizationStatus     @default(NOT_CONFIGURED)
  createdAt                 DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)

  project     Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  allocations ProjectCostAmortizationAllocation[]

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId])
  @@index([sourceType])
}

model ProjectCostAmortizationAllocation {
  id                          String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amortizationId              String                            @db.Uuid
  projectId                   String                            @db.Uuid
  targetItemType              ProjectCostAmortizationTargetType
  targetItemId                String
  targetSnapshotRootProductId String?                           @db.Uuid
  targetDescriptionSnapshot   String
  targetBaseUnitCostSnapshot  Decimal                           @default(0) @db.Decimal(20, 6)
  allocationPercent           Decimal                           @default(0) @db.Decimal(10, 6)
  allocatedAmount             Decimal                           @default(0) @db.Decimal(20, 6)
  amortizationQuantity        Decimal                           @default(1) @db.Decimal(20, 6)
  unitAmortizedCost           Decimal                           @default(0) @db.Decimal(20, 6)
  finalUnitCostSnapshot       Decimal                           @default(0) @db.Decimal(20, 6)
  createdAt                   DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)

  amortization ProjectCostAmortization @relation(fields: [amortizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([amortizationId])
  @@index([projectId])
  @@index([targetItemId])
}

// —— Financeiro: fornecedores consolidados e classificação gerencial AP ——
// Camada aditiva; NomusAccountsPayable permanece fonte read-only dos títulos.

enum FinancialSupplierSource {
  AUTO_SYNC
  MANUAL
  IMPORT
  NOMUS_BOOTSTRAP
}

enum FinancialSupplierStatus {
  ACTIVE
  NEEDS_REVIEW
  MERGED
  INACTIVE
}

enum FinancialCostCenterStatus {
  ACTIVE
  INACTIVE
}

enum CostCenterAllocationSource {
  AUTO_RULE
  MANUAL
  BATCH
}

/// Fornecedor consolidado para classificação gerencial de AP (não substitui personName/personCnpj no Nomus).
model FinancialSupplier {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName        String
  legalName          String?
  tradeName          String?
  document           String?
  normalizedDocument String?
  normalizedName     String?
  source             FinancialSupplierSource @default(NOMUS_BOOTSTRAP)
  status             FinancialSupplierStatus @default(ACTIVE)
  confidence         Decimal?                @db.Decimal(5, 2)
  firstSeenAt        DateTime?               @db.Timestamptz(6)
  lastSeenAt         DateTime?               @db.Timestamptz(6)
  titlesCount        Int                     @default(0)
  totalAmountSeen    Decimal                 @default(0) @db.Decimal(20, 2)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  aliases       FinancialSupplierAlias[]
  costCenterRules SupplierCostCenterRule[]
  allocations   AccountsPayableCostCenterAllocation[]

  @@index([normalizedDocument])
  @@index([normalizedName])
  @@index([status])
  @@index([displayName])
}

/// Fragmentos de identidade Nomus vinculados ao fornecedor consolidado.
model FinancialSupplierAlias {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId         String                  @db.Uuid
  source             FinancialSupplierSource @default(AUTO_SYNC)
  externalSupplierId Int?
  originalName       String?
  originalDocument   String?
  normalizedName     String?
  normalizedDocument String?
  firstSeenAt        DateTime?               @db.Timestamptz(6)
  lastSeenAt         DateTime?               @db.Timestamptz(6)
  titlesCount        Int                     @default(0)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  supplier FinancialSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([supplierId])
  @@index([externalSupplierId])
  @@index([normalizedDocument])
  @@index([normalizedName])
}

/// Centro de custo financeiro — separado de CostCenter (Compras).
model FinancialCostCenter {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                    @unique
  name              String
  description       String?
  parentId          String?                   @db.Uuid
  responsibleUserId String?
  responsibleName   String?
  status            FinancialCostCenterStatus @default(ACTIVE)
  color             String?
  icon              String?
  createdAt         DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)

  parent          FinancialCostCenter?                  @relation("FinancialCostCenterTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children        FinancialCostCenter[]                 @relation("FinancialCostCenterTree")
  costCenterRules SupplierCostCenterRule[]
  allocations     AccountsPayableCostCenterAllocation[]

  @@index([status])
  @@index([parentId])
}

/// Regra fornecedor → centro de custo (classificação automática futura).
model SupplierCostCenterRule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId      String   @db.Uuid
  costCenterId    String   @db.Uuid
  percentage      Decimal  @default(100) @db.Decimal(5, 2)
  priority        Int      @default(100)
  autoApply       Boolean  @default(true)
  isActive        Boolean  @default(true)
  company         String?
  notes           String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  supplier    FinancialSupplier                     @relation(fields: [supplierId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  costCenter  FinancialCostCenter                   @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  allocations AccountsPayableCostCenterAllocation[]

  @@index([supplierId, isActive])
  @@index([costCenterId])
  @@index([company])
  @@index([priority])
}

/// Alocação gerencial de centro de custo por título AP (accountsPayableId = NomusAccountsPayable.externalId).
model AccountsPayableCostCenterAllocation {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountsPayableId Int
  supplierId        String?                    @db.Uuid
  costCenterId      String                     @db.Uuid
  amount            Decimal?                   @db.Decimal(20, 2)
  percentage        Decimal                    @default(100) @db.Decimal(5, 2)
  source            CostCenterAllocationSource
  confidence        Decimal?                   @db.Decimal(5, 2)
  lockedManual      Boolean                    @default(false)
  ruleId            String?                    @db.Uuid
  notes             String?
  createdByUserId   String?
  createdByName     String?
  createdAt         DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  supplier   FinancialSupplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  costCenter FinancialCostCenter     @relation(fields: [costCenterId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  rule       SupplierCostCenterRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([accountsPayableId, costCenterId])
  @@index([accountsPayableId])
  @@index([supplierId])
  @@index([costCenterId])
  @@index([source])
  @@index([lockedManual])
}

/// Auditoria de mutações em fornecedores, centros de custo, regras e alocações.
model FinancialCostCenterAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String
  action     String
  beforeJson Json?
  afterJson  Json?
  userId     String?
  userName   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
