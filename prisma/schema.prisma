  @@index([parentCode])
  @@index([status])
  @@index([planHash])
  @@index([createdAt])
}

enum EngineeringChangeEntityType {
  PRODUCT
  PRODUCT_BOM
  MATERIAL
  ROUTING
  PRICE_INPUT
}

enum EngineeringChangeOrigin {
  NOMUS_SYNC
  NOMUS_ENGINEERING_APPLY
  MANUAL_EDIT
  LOCAL_EXCEPTION
}

/// Log antes/depois de cada alteração de engenharia (produto, linha BOM, etc.).
model EngineeringChangeLog {
  id            String                       @id @default(uuid())
  entityType    EngineeringChangeEntityType
  entityId      String?
  productId     String?                      @db.Uuid
  productSku    String?
  sourceSystem  String?
  changeOrigin  EngineeringChangeOrigin
  fieldName     String?
  oldValue      String?
  newValue      String?
  oldValueJson  Json?
  newValueJson  Json?
  changedBy     String?
  changedAt     DateTime                     @default(now())
  runId         String?
  planHash      String?
  reason        String?
  createdAt     DateTime                     @default(now())
  run           EngineeringSyncRun?          @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([productSku])
  @@index([entityType])
  @@index([changeOrigin])
  @@index([changedAt])
  @@index([runId])
}

