model ProposalItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId         String           @db.Uuid
  productId          String           @db.Uuid
  quantity           Decimal          @db.Decimal(20, 6)
  unit               String?
  unitCost           Decimal          @db.Decimal(20, 6)
  suggestedPrice     Decimal          @db.Decimal(20, 6)
  negotiatedPrice    Decimal          @db.Decimal(20, 6)
  discountPerc       Decimal          @default(0) @db.Decimal(10, 6)
  discountValue      Decimal          @default(0) @db.Decimal(20, 6)
  marginValue        Decimal          @db.Decimal(20, 6)
  marginPerc         Decimal          @db.Decimal(10, 6)
  taxesPerc          Decimal          @default(0) @db.Decimal(10, 6)
  taxesValue         Decimal          @default(0) @db.Decimal(20, 6)
  commissionPerc     Decimal          @default(0) @db.Decimal(10, 6)
  commissionValue    Decimal          @default(0) @db.Decimal(20, 6)
  freightValue       Decimal          @default(0) @db.Decimal(20, 6)
