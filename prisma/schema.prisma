  priority               Int?
  nextActionAt           DateTime?            @db.Timestamp(6)
  nextActionNote         String?
  sourceSystem           String?
  externalProposalId     Int?
  externalProposalCode   String?
  externalCustomerId     Int?
  externalSellerId       Int?
  externalCompanyId      Int?
  externalMovementTypeId Int?
  externalOpenedAt       DateTime?            @db.Timestamptz(6)
  externalRawPayload     Json?
  CommercialActivity     CommercialActivity[]
  Customer               Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
