/// Ordem de Produção Nomus (`/rest/ordens`) — stage oficial isolado.
/// Vínculo com Pedido/Item somente via itensPedido[].idPedido e itensPedido[].id (nunca por nome/produto/datas).
/// Não altera Pedido de Venda, NF-e, AR/AP, Fluxo, Comissões, Formação de Preço nem BOM.
/// Estado incremental: cursor em arquivo + IntegrationRun (sem SyncState dedicado).
model NomusProductionOrder {
  id String @id @default(uuid())

  /// ID Nomus da OP (`id`) — chave de upsert.
  externalId Int @unique

  name     String?
  status   String?
  tipo     String?
  priority String?

  externalProductId     Int?
  productCode           String?
  productDescription    String?
  productAdditionalInfo String?
  productConfigId       Int?
  productConfigCode     String?

  externalCompanyId Int?
  companyName       String?

  quantity    Decimal? @db.Decimal(20, 6)
  unit        String?
  stockSector String?

  /// Datas Nomus (quando presentes no payload). Ver docs/production-orders/date-field-mapping.md.
  openedAt       DateTime? /// ← dataHoraCriacao
  releasedAt     DateTime? /// ← dataHoraLiberacao
  plannedAt      DateTime? /// ← dataHoraInicialPlanejada
  deliveryAt     DateTime? /// ← dataHoraEntrega (NÃO é encerramento)
  closedAt       DateTime? /// só com campo oficial de encerramento; não inferir
  nomusUpdatedAt DateTime? /// ← dataHoraEdicao

  rawJson     Json
  payloadHash String

  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  lastChangedAt DateTime @default(now())
  syncedAt      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salesLinks NomusProductionOrderSalesLink[]

  @@index([status])
  @@index([tipo])
  @@index([priority])
  @@index([productCode])
  @@index([externalProductId])
  @@index([externalCompanyId])
  @@index([stockSector])
  @@index([openedAt])
  @@index([releasedAt])
  @@index([plannedAt])
  @@index([deliveryAt])
  @@index([closedAt])
  @@index([nomusUpdatedAt])
  @@index([syncedAt])
  @@index([lastSeenAt])
  @@index([lastChangedAt])
  @@index([payloadHash])
  @@index([name])
  @@index([openedAt, externalId])
  @@index([status, openedAt, externalId])
  @@index([tipo, openedAt, externalId])
}

/// Vínculo oficial OP ↔ Pedido de Venda / item (itensPedido do payload `/rest/ordens`).
/// Permite várias OPs no mesmo item e vários itens na mesma OP.
/// FKs locais opcionais: dados históricos podem existir só com IDs externos Nomus.
model NomusProductionOrderSalesLink {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   NomusProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  /// Denormalizado para unicidade estável sem join.
  productionOrderExternalId Int

  /// itensPedido[].idPedido → SalesOrder.externalSalesOrderId
  externalSalesOrderId     Int
  /// itensPedido[].id → SalesOrderItem.nomusItemExternalId
  externalSalesOrderItemId Int
  itemNumber               String?
  customerName             String?
  linkedQuantity           Decimal? @db.Decimal(20, 6)
  rawJson                  Json?

  salesOrderId     String?         @db.Uuid
  salesOrderItemId String?         @db.Uuid
  SalesOrder       SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  SalesOrderItem   SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  /// true enquanto o vínculo aparece no último payload da OP.
  isCurrent   Boolean   @default(true)
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  removedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([productionOrderExternalId, externalSalesOrderItemId])
  @@index([productionOrderId])
  @@index([externalSalesOrderId])
  @@index([externalSalesOrderItemId])
  @@index([salesOrderId])
  @@index([salesOrderItemId])
  @@index([isCurrent])
  @@index([removedAt])
  @@index([externalSalesOrderId, isCurrent])
  @@index([externalSalesOrderItemId, isCurrent])
}

