generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                 @unique
  name                 String
  acquisitionValue     Decimal                @db.Decimal(20, 6)
  residualValue        Decimal                @db.Decimal(20, 6)
  usefulLifeMonths     Int
  createdAt            DateTime?              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  MachineCostComponent MachineCostComponent[]
  ProductRouting       ProductRouting[]
}

model MachineCostComponent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId            String   @db.Uuid
  name                 String
  monthlyEstimatedCost Decimal  @db.Decimal(20, 6)
  isVariable           Boolean? @default(false)
  Machine              Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique
  baseSalary     Decimal          @db.Decimal(20, 6)
  monthlyHours   Int?             @default(220)
  createdAt      DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  Employee       Employee[]
  ProductRouting ProductRouting[]
}

/// Identidade canônica da pessoa física (hub fino).
/// Papéis de domínio (Employee, AppUser, CommissionPerson, …) permanecem nas tabelas próprias.
/// Unicidade de CPF/e-mail: índices de busca apenas; validação no service (sem UNIQUE no banco
/// até diagnóstico de duplicidades históricas — ver migration 20260715200000).
model Person {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Nome canônico exibido.
  displayName     String
  socialName      String?
  /// E-mail principal / corporativo (normalizado lowercase).
  corporateEmail  String?
  personalEmail   String?
  /// CPF somente dígitos (nullable). Sem UNIQUE de banco nesta etapa.
  cpfNormalized   String?
  phoneNormalized String?
  status          String    @default("ACTIVE")
  /// Origem da criação: MANUAL | EMPLOYEE | APP_USER | COMMISSION | SYSTEM | BACKFILL
  origin          String    @default("MANUAL")
  /// Auditoria leve (opcional). Sem cascade: se o usuário sumir, mantém histórico.
  createdByUserId String?   @db.Uuid
  inactivatedAt   DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  employees           Employee[]
  appUsers            AppUser[]
  commissionPeople    CommissionPerson[]
  fleetDrivers        FleetDriver[]
  /// Clientes PF cuja identidade é esta pessoa.
  customersAsIdentity Customer[]         @relation("CustomerIdentityPerson")
  /// Contatos cadastrais de clientes (tipicamente PJ) apontando para esta pessoa.
  customersAsContact  Customer[]         @relation("CustomerContactPerson")

  @@index([displayName])
  @@index([corporateEmail])
  @@index([personalEmail])
  @@index([cpfNormalized])
  @@index([phoneNormalized])
  @@index([status])
  @@index([origin])
  @@index([createdByUserId])
}

model Employee {
  id                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  roleId                       String                     @db.Uuid
  department                   String
  /// FK opcional ao departamento oficial RH (mantém `department` como rótulo/cache).
  departmentId                 String?                    @db.Uuid
  costCenter                   String
  /// FK opcional ao cadastro oficial financeiro (mantém `costCenter` como rótulo legado/cache).
  costCenterId                 String?                    @db.Uuid
  classification               String
  salary                       Decimal                    @db.Decimal(20, 6)
  monthlyHours                 Int
  productivity                 Decimal?                   @default(100.00) @db.Decimal(10, 6)
  status                       String?                    @default("ACTIVE")
  socialName                   String?
  /// E-mail corporativo do vínculo profissional (opcional).
  /// Normalizado: trim + lowercase. Unicidade CI via índice SQL
  /// `Employee_corporateEmail_lower_uidx` (partial WHERE NOT NULL).
  /// Não é o e-mail de login (`AppUser.email`); vínculo de usuário é explícito.
  corporateEmail               String?
  cpf                          String?
  rg                           String?
  birthDate                    DateTime?                  @db.Timestamptz(6)
  phone                        String?
  personalEmail                String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  admissionDate                DateTime?                  @db.Timestamptz(6)
  terminationDate              DateTime?                  @db.Timestamptz(6)
  contractType                 String?
  managerName                  String?
  /// Gestor = outro Employee (ativos na seleção; histórico preserva inativos).
  managerId                    String?                    @db.Uuid
  /// Identidade canônica (Person). Opcional — legado sem vínculo continua válido.
  personId                     String?                    @db.Uuid
  professionalNotes            String?
  address                      String?
  adminNotes                   String?
  shirtSize                    String?
  pantsSize                    String?
  jacketSize                   String?
  gloveSize                    String?
  shoeSize                     String?
  epiNotes                     String?
  createdAt                    DateTime?                  @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)
  Role                         Role                       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  financialCostCenter          FinancialCostCenter?       @relation(fields: [costCenterId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  orgDepartment                HrDepartment?              @relation("EmployeeOrgDepartment", fields: [departmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  manager                      Employee?                  @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  directReports                Employee[]                 @relation("EmployeeManager")
  person                       Person?                    @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  EmployeePayrollComponent     EmployeePayrollComponent[]
  /// Conta de acesso do sistema (Configurações → Usuários), quando vinculada.
  appUser                      AppUser?
  ledDirectorates              HrDirectorate[]            @relation("HrDirectorateLeader")
  ledDepartments               HrDepartment[]             @relation("HrDepartmentLeader")

  @@unique([personId])
  @@index([costCenterId])
  @@index([departmentId])
  @@index([managerId])
}

/// Diretoria organizacional (RH) — agrupa departamentos e exige líder responsável.
/// Pode opcionalmente reportar a outra diretoria (`parentDirectorateId`), formando hierarquia.
model HrDirectorate {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                String?        @unique
  name                String         @unique
  status              String         @default("ACTIVE")
  leaderEmployeeId    String         @db.Uuid
  parentDirectorateId String?        @db.Uuid
  notes               String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @default(now()) @updatedAt @db.Timestamptz(6)

  leader            Employee        @relation("HrDirectorateLeader", fields: [leaderEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  parentDirectorate HrDirectorate?  @relation("HrDirectorateHierarchy", fields: [parentDirectorateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  childDirectorates HrDirectorate[] @relation("HrDirectorateHierarchy")
  departments       HrDepartment[]

  @@index([status])
  @@index([leaderEmployeeId])
  @@index([parentDirectorateId])
}

/// Departamento oficial (RH) — sempre vinculado a uma diretoria e com líder designado.
model HrDepartment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String?  @unique
  name             String
  status           String   @default("ACTIVE")
  directorateId    String   @db.Uuid
  leaderEmployeeId String   @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  directorate HrDirectorate @relation(fields: [directorateId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  leader      Employee      @relation("HrDepartmentLeader", fields: [leaderEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  employees   Employee[]    @relation("EmployeeOrgDepartment")

  @@unique([directorateId, name])
  @@index([status])
  @@index([directorateId])
  @@index([leaderEmployeeId])
}

model PayrollComponent {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String                     @unique
  type            String
  calculationType String
  value           Decimal                    @db.Decimal(20, 6)
  createdAt       DateTime?                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)
  employees       EmployeePayrollComponent[]
}

model EmployeePayrollComponent {
  employeeId         String           @db.Uuid
  payrollComponentId String           @db.Uuid
  Employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PayrollComponent   PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([employeeId, payrollComponentId])
}

model Material {
  id                            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                          String                       @unique
  description                   String
  unit                          String
  category                      String
  supplier                      String?
  currentCost                   Decimal                      @db.Decimal(20, 6)
  averageCost                   Decimal                      @db.Decimal(20, 6)
  standardCost                  Decimal                      @db.Decimal(20, 6)
  freight                       Decimal?                     @default(0) @db.Decimal(20, 6)
  standardLoss                  Decimal?                     @default(0) @db.Decimal(10, 6)
  conversionFactor              Decimal?                     @default(1) @db.Decimal(20, 6)
  status                        String?                      @default("ACTIVE")
  isMarketMonitored             Boolean                      @default(false)
  marketCriticality             MaterialMarketCriticality?
  marketMonitoringFrequencyDays Int?
  marketNotes                   String?
  createdAt                     DateTime?                    @default(now()) @db.Timestamptz(6)
  updatedAt                     DateTime?                    @default(now()) @updatedAt @db.Timestamptz(6)
  MaterialPriceHistory          MaterialPriceHistory[]
  MaterialMarketQuote           MaterialMarketQuote[]
  MaterialOfficialQuoteAudit    MaterialOfficialQuoteAudit[]
  MaterialMarketAuditEvent      MaterialMarketAuditEvent[]
  MaterialMarketAlert           MaterialMarketAlert[]
  MaterialMarketAlertConfig     MaterialMarketAlertConfig?
  MaterialMarketPurchaseLink    MaterialMarketPurchaseLink[]
  ProductBOM                    ProductBOM[]
  PurchaseRequestItem           PurchaseRequestItem[]
  ProjectStructureLine          ProjectStructureLine[]
  MaterialCostTableItem         MaterialCostTableItem[]
  /// Itens logísticos locais (SC) — vínculo read-only ao cadastro oficial de MP.
  InventoryItem                 InventoryItem[]
  /// Domínio aditivo de Compras SC — linhas referenciam MP oficial (read-only).
  PurchaseQuotationItem         PurchaseQuotationItem[]
  PurchaseOrderItem             PurchaseOrderItem[]
  PurchaseReceiptItem           PurchaseReceiptItem[]
}

enum MaterialMarketCriticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model MaterialPriceHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId    String    @db.Uuid
  price         Decimal   @db.Decimal(20, 6)
  freight       Decimal?  @default(0) @db.Decimal(20, 6)
  effectiveDate DateTime? @default(now()) @db.Timestamptz(6)
  Material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

enum MaterialMarketQuoteStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MaterialMarketQuoteOfficialStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  OFFICIAL
  REPLACED
}

enum MaterialOfficialQuoteAuditAction {
  SUBMITTED
  APPROVED
  REJECTED
  SET_OFFICIAL
  REPLACED
}

enum MaterialMarketQuoteExchangeOrigin {
  BCB_PTAX
  MANUAL
}

enum MaterialMarketQuotePtaxFetchStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum MaterialMarketQuoteReliabilityLevel {
  MANUAL
  BAIXA
  MEDIA
  ALTA
}

enum MaterialMarketQuoteAttachmentType {
  PDF
  IMAGE
  SPREADSHEET
  EMAIL
  PROPOSAL
  OTHER
}

/// Cotação manual de mercado — append-only; nunca sobrescreve histórico.
model MaterialMarketQuote {
  id                          String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId                  String                               @db.Uuid
  supplierId                  String?                              @db.Uuid
  supplierName                String?
  quoteDate                   DateTime                             @db.Date
  price                       Decimal                              @db.Decimal(20, 6)
  currency                    String                               @default("BRL")
  unit                        String
  origin                      String?
  manufacturer                String?
  freightValue                Decimal?                             @db.Decimal(20, 6)
  taxValue                    Decimal?                             @db.Decimal(20, 6)
  netPrice                    Decimal                              @db.Decimal(20, 6)
  paymentTerms                String?
  proposalValidityDate        DateTime?                            @db.Date
  notes                       String?
  status                      MaterialMarketQuoteStatus            @default(ACTIVE)
  exchangeOrigin              MaterialMarketQuoteExchangeOrigin?
  ptaxVenda                   Decimal?                             @db.Decimal(20, 6)
  ptaxReferenceDate           DateTime?                            @db.Date
  ptaxFetchStatus             MaterialMarketQuotePtaxFetchStatus?
  ptaxFetchFailureReason      String?
  priceBrl                    Decimal?                             @db.Decimal(20, 6)
  netPriceBrl                 Decimal?                             @db.Decimal(20, 6)
  manualExchangeJustification String?
  manualExchangeBy            String?
  manualExchangeAt            DateTime?                            @db.Timestamptz(6)
  isOfficialReference         Boolean                              @default(false)
  officialStatus              MaterialMarketQuoteOfficialStatus    @default(DRAFT)
  rejectionReason             String?
  submittedForApprovalBy      String?
  submittedForApprovalAt      DateTime?                            @db.Timestamptz(6)
  approvedBy                  String?
  approvedAt                  DateTime?                            @db.Timestamptz(6)
  setOfficialBy               String?
  setOfficialAt               DateTime?                            @db.Timestamptz(6)
  reliabilityLevel            MaterialMarketQuoteReliabilityLevel?
  reliabilitySuggestedLevel   MaterialMarketQuoteReliabilityLevel?
  reliabilityOverrideReason   String?
  reliabilitySetBy            String?
  reliabilitySetAt            DateTime?                            @db.Timestamptz(6)
  suggestedReliabilityLevel   MaterialMarketQuoteReliabilityLevel?
  createdBy                   String?
  updatedBy                   String?
  createdAt                   DateTime                             @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                             @default(now()) @updatedAt @db.Timestamptz(6)

  Material          Material                        @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  FinancialSupplier FinancialSupplier?              @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  Attachments       MaterialMarketQuoteAttachment[]
  AuditLogs         MaterialMarketQuoteAuditLog[]
  purchaseLinks     MaterialMarketPurchaseLink[]

  @@index([materialId, quoteDate(sort: Desc)])
  @@index([materialId, isOfficialReference])
  @@index([materialId, officialStatus])
  @@index([supplierId])
}

/// Vínculo cotação de mercado → compra real (manual; PO formal opcional sem FK rígida).
/// Fórmula: estimatedSavings = (referenceUnitPriceBrl - negotiatedPrice) × quantityPurchased
/// referenceUnitPriceBrl: netPriceBrl da cotação, senão netPrice (BRL), senão currentCost do material.
model MaterialMarketPurchaseLink {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId            String   @db.Uuid
  quoteId               String   @db.Uuid
  /// ID opcional de pedido externo — sem FK (não há módulo PurchaseOrder formal).
  purchaseOrderId       String?  @db.Uuid
  purchaseOrderNumber   String?
  supplierName          String
  quantityPurchased     Decimal  @db.Decimal(20, 6)
  /// Preço unitário negociado em BRL (mesma base que netPriceBrl da cotação).
  negotiatedPrice       Decimal  @db.Decimal(20, 6)
  purchaseDate          DateTime @db.Date
  choiceReason          String?
  /// Economia obtida em BRL.
  estimatedSavings      Decimal  @db.Decimal(20, 6)
  referenceUnitPriceBrl Decimal  @db.Decimal(20, 6)
  currency              String   @default("BRL")
  createdBy             String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)

  Material Material            @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Quote    MaterialMarketQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([materialId, purchaseDate(sort: Desc)])
  @@index([quoteId])
  @@index([purchaseOrderId])
}

/// Anexo de evidência vinculado a uma cotação de mercado.
model MaterialMarketQuoteAttachment {
  id                        String                               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId                   String                               @db.Uuid
  fileName                  String
  originalFileName          String
  mimeType                  String
  fileSize                  Int
  attachmentType            MaterialMarketQuoteAttachmentType
  storageKey                String
  suggestedReliabilityLevel MaterialMarketQuoteReliabilityLevel?
  notes                     String?
  uploadedBy                String?
  uploadedAt                DateTime                             @default(now()) @db.Timestamptz(6)

  MaterialMarketQuote MaterialMarketQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quoteId, uploadedAt(sort: Desc)])
}

/// Trilha de auditoria de cotações de mercado (anexos e eventos relacionados).
model MaterialMarketQuoteAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId    String   @db.Uuid
  entityType String
  entityId   String?  @db.Uuid
  action     String
  details    String?
  userId     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  MaterialMarketQuote MaterialMarketQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([quoteId, createdAt(sort: Desc)])
}

/// Auditoria de governança da cotação oficial por matéria-prima.
model MaterialOfficialQuoteAudit {
  id              String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId      String                           @db.Uuid
  quoteId         String                           @db.Uuid
  action          MaterialOfficialQuoteAuditAction
  previousQuoteId String?                          @db.Uuid
  newQuoteId      String?                          @db.Uuid
  changedBy       String?
  changedAt       DateTime                         @default(now()) @db.Timestamptz(6)
  reason          String?
  rejectionReason String?

  Material Material @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([materialId])
  @@index([quoteId])
  @@index([changedAt])
}

enum MaterialMarketAuditEntityType {
  QUOTE
  ALERT_CONFIG
  OFFICIAL_QUOTE
  APPROVAL
  GLOBAL_CONFIG
  PURCHASE_LINK
}

enum MaterialMarketAuditEventType {
  CREATED
  UPDATED
  PRICE_CHANGED
  SUPPLIER_CHANGED
  EXCHANGE_CHANGED
  STATUS_CHANGED
  APPROVED
  REJECTED
  SET_OFFICIAL
  REPLACED
  CONFIG_CHANGED
  SUBMITTED_FOR_APPROVAL
  MONITORING_CHANGED
  ALERT_STATUS_CHANGED
  PURCHASE_LINKED
}

/// Trilha unificada de auditoria — Inteligência de Mercado (append-only).
model MaterialMarketAuditEvent {
  id         String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId String?                       @db.Uuid
  entityType MaterialMarketAuditEntityType
  entityId   String?
  eventType  MaterialMarketAuditEventType
  userId     String?
  userName   String?
  occurredAt DateTime                      @default(now()) @db.Timestamptz(6)
  reason     String?
  beforeJson Json?
  afterJson  Json?
  metadata   Json?

  Material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([materialId, occurredAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([eventType])
}

enum MaterialMarketAlertType {
  PRICE_UP_PCT
  PRICE_DOWN_PCT
  BREAK_MAX
  BREAK_MIN
  NO_RECENT_QUOTE
  SUPPLIER_ABOVE_AVG
  SAVINGS_OPPORTUNITY
}

enum MaterialMarketAlertStatus {
  OPEN
  READ
  RESOLVED
}

enum MaterialMarketAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Alerta de mercado por matéria-prima — append-only por evento; alertas OPEN do mesmo tipo são atualizados.
model MaterialMarketAlert {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId  String                      @db.Uuid
  alertType   MaterialMarketAlertType
  status      MaterialMarketAlertStatus   @default(OPEN)
  title       String
  message     String
  severity    MaterialMarketAlertSeverity
  metadata    Json?
  triggeredAt DateTime                    @default(now()) @db.Timestamptz(6)
  readAt      DateTime?                   @db.Timestamptz(6)
  resolvedAt  DateTime?                   @db.Timestamptz(6)
  readBy      String?
  resolvedBy  String?
  createdAt   DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                    @default(now()) @updatedAt @db.Timestamptz(6)

  Material Material @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([materialId, status])
  @@index([materialId, alertType, status])
  @@index([status, triggeredAt(sort: Desc)])
}

enum MaterialMarketAlertConfigScope {
  GLOBAL
  MATERIAL
}

/// Configuração global de limiares de alertas (singleton — id fixo "GLOBAL").
model MaterialMarketAlertGlobalConfig {
  id                   String   @id @default("GLOBAL")
  risePercentThreshold Decimal  @default(10) @db.Decimal(10, 2)
  fallPercentThreshold Decimal  @default(10) @db.Decimal(10, 2)
  daysWithoutQuote     Int      @default(90)
  alertsEnabled        Boolean  @default(true)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy            String?
}

/// Override de limiares por matéria-prima — campos nulos herdam a configuração global.
model MaterialMarketAlertConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId           String   @unique @db.Uuid
  risePercentThreshold Decimal? @db.Decimal(10, 2)
  fallPercentThreshold Decimal? @db.Decimal(10, 2)
  daysWithoutQuote     Int?
  alertsEnabled        Boolean?
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy            String?

  Material Material @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// Auditoria de alterações em configurações de alertas de mercado.
model MaterialMarketAlertConfigAudit {
  id         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope      MaterialMarketAlertConfigScope
  materialId String?                        @db.Uuid
  beforeJson Json?
  afterJson  Json?
  updatedBy  String?
  createdAt  DateTime                       @default(now()) @db.Timestamptz(6)

  @@index([scope, createdAt(sort: Desc)])
  @@index([materialId, createdAt(sort: Desc)])
}

enum CommodityType {
  BRENT
}

enum CommoditySnapshotStatus {
  SUCCESS
  FAILED
}

/// Snapshot de cotação de commodity (ex.: Brent) — append-only; cada coleta cria nova linha.
///
/// Slots agendados (America/Sao_Paulo):
///   - MORNING_EARLY    → 07:00 (nova agenda 2026-07)
///   - MORNING_LATE     → 11:00 (nova agenda 2026-07)
///   - AFTERNOON_EARLY  → 14:00 (nova agenda 2026-07)
///   - AFTERNOON_LATE   → 16:00 (nova agenda 2026-07)
///   - MORNING          → 09:00 (legado 2026-07; mantido para linhas históricas)
///   - AFTERNOON        → 15:30 (legado 2026-07; mantido para linhas históricas)
enum CommodityCollectionSlot {
  MORNING
  AFTERNOON
  MORNING_EARLY
  MORNING_LATE
  AFTERNOON_EARLY
  AFTERNOON_LATE
}

enum CommodityCollectionTrigger {
  SCHEDULED
  MANUAL
}

model CommoditySnapshot {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commodityType         CommodityType
  priceUSD              Decimal?                   @db.Decimal(20, 6)
  quoteDate             DateTime                   @db.Date
  scheduledSlot         CommodityCollectionSlot
  collectedAt           DateTime                   @default(now()) @db.Timestamptz(6)
  source                String?
  status                CommoditySnapshotStatus
  errorMessage          String?
  variationFromPrevious Decimal?                   @db.Decimal(10, 6)
  trigger               CommodityCollectionTrigger @default(SCHEDULED)

  @@index([commodityType, quoteDate(sort: Desc), scheduledSlot])
  @@index([commodityType, status, collectedAt(sort: Desc)])
