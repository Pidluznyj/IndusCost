// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Cadastros Base ---

model Machine {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique
  name             String
  acquisitionValue Decimal  @db.Decimal(18, 2)
  residualValue    Decimal  @db.Decimal(18, 2)
  usefulLifeMonths Int
  MachineCostComponent MachineCostComponent[]
  ProductRouting       ProductRouting[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MachineCostComponent {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId           String   @db.Uuid
  Machine             Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  name                String
  monthlyEstimatedCost Decimal  @db.Decimal(18, 2)
  isVariable          Boolean  @default(false)
}

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String   @unique
  baseSalary     Decimal  @db.Decimal(18, 2)
  monthlyHours   Int      @default(220)
  Employee       Employee[]
  ProductRouting ProductRouting[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Employee {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  roleId         String   @db.Uuid
  Role           Role     @relation(fields: [roleId], references: [id])
  department     String
  costCenter     String
  classification String
  salary         Decimal  @db.Decimal(18, 2)
  monthlyHours   Int
  productivity   Decimal  @default(100) @db.Decimal(5, 2)
  status         String   @default("ACTIVE")
  EmployeePayrollComponent EmployeePayrollComponent[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PayrollComponent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @unique
  type            String
  calculationType String
  value           Decimal  @db.Decimal(18, 2)
  employees       EmployeePayrollComponent[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmployeePayrollComponent {
  employeeId       String   @db.Uuid
  Employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollComponentId String @db.Uuid
  PayrollComponent PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade)

  @@id([employeeId, payrollComponentId])
}

// --- Suprimentos ---

model Material {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique
  description      String
  unit             String
  category         String
  supplier         String?
  currentCost      Decimal  @db.Decimal(18, 2)
  averageCost      Decimal  @db.Decimal(18, 2)
  standardCost     Decimal  @db.Decimal(18, 2)
  freight          Decimal  @default(0) @db.Decimal(18, 2)
  standardLoss     Decimal  @default(0) @db.Decimal(5, 2)
  conversionFactor Decimal  @default(1) @db.Decimal(10, 4)
  status           String   @default("ACTIVE")
  MaterialPriceHistory MaterialPriceHistory[]
  ProductBOM           ProductBOM[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MaterialPriceHistory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId   String   @db.Uuid
  Material     Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  price        Decimal  @db.Decimal(18, 2)
  freight      Decimal  @default(0) @db.Decimal(18, 2)
  effectiveDate DateTime @default(now())
}

// --- Engenharia ---

enum ItemType {
  PRODUCT
  COMPONENT
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku            String   @unique
  name           String
  description    String?
  type           ItemType @default(PRODUCT)
  version        String   @default("1.0.0")
  status         String   @default("ACTIVE")
  defaultLotSize Decimal  @default(1) @db.Decimal(18, 2)
  
  // BOM as Parent
  ProductBOM           ProductBOM[] @relation("ParentProduct")
  // BOM as Child (for components)
  UsedInBOM            ProductBOM[] @relation("ChildProduct")
  
  ProductRouting       ProductRouting[]
  CostCalculationLog   CostCalculationLog[]
  ProductPricing       ProductPricing[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProductBOM {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @db.Uuid
  ParentProduct  Product  @relation("ParentProduct", fields: [productId], references: [id], onDelete: Cascade)
  
  materialId     String?  @db.Uuid
  Material       Material? @relation(fields: [materialId], references: [id])
  
  childProductId String?  @db.Uuid
  ChildProduct   Product? @relation("ChildProduct", fields: [childProductId], references: [id])
  
  quantity       Decimal  @db.Decimal(18, 4)
  lossPercentage Decimal  @default(0) @db.Decimal(5, 2)
  notes          String?
}

model ProductRouting {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @db.Uuid
  Product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sequence          Int
  description       String?
  machineId         String   @db.Uuid
  Machine           Machine  @relation(fields: [machineId], references: [id])
  roleId            String   @db.Uuid
  Role              Role     @relation(fields: [roleId], references: [id])
  setupTimeMin      Decimal  @default(0) @db.Decimal(10, 2)
  operationTimeMin  Decimal  @default(0) @db.Decimal(10, 2)
  efficiencyExpected Decimal  @default(100) @db.Decimal(5, 2)
  notes             String?
}

// --- Custos Indiretos e OPEX ---

model IndirectCost {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description       String
  category          String
  monthlyValue      Decimal  @db.Decimal(18, 2)
  costCenter        String?
  allocationCriteria String
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --- Módulo Tributário ---

model TaxRule {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String         @unique
  description String?
  operation   String
  status      String         @default("ACTIVE")
  TaxComponent   TaxComponent[]
  ProductPricing ProductPricing[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model TaxComponent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxRuleId   String   @db.Uuid
  TaxRule     TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)
  name        String
  percentage  Decimal  @db.Decimal(5, 2)
  isRecoverable Boolean @default(false)
  baseType    String   @default("GROSS_PRICE")
}

// --- Formação de Preço ---

model ProductPricing {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String   @db.Uuid
  Product           Product  @relation(fields: [productId], references: [id])
  taxRuleId         String   @db.Uuid
  TaxRule           TaxRule  @relation(fields: [taxRuleId], references: [id])
  desiredMargin     Decimal  @default(15.0) @db.Decimal(5, 2)
  commission        Decimal  @default(0.0) @db.Decimal(5, 2)
  freightOut        Decimal  @default(0.0) @db.Decimal(18, 2)
  otherVariables    Decimal  @default(0.0) @db.Decimal(5, 2)
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, taxRuleId])
}

// --- Módulo de Simulações ---

model Simulation {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  description       String?
  productId         String   @db.Uuid
  taxRuleId         String   @db.Uuid
  materialAdj       Decimal  @default(0) @db.Decimal(5, 2)
  laborAdj          Decimal  @default(0) @db.Decimal(5, 2)
  indirectAdj       Decimal  @default(0) @db.Decimal(5, 2)
  efficiencyAdj     Decimal  @default(0) @db.Decimal(5, 2)
  marginAdj         Decimal  @default(0) @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// --- Histórico de Cálculos ---

model CostCalculationLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String   @db.Uuid
  Product        Product  @relation(fields: [productId], references: [id])
  calculatedAt   DateTime @default(now())
  versionTag     String?
  totalCiu       Decimal  @db.Decimal(18, 2)
  totalCfc       Decimal  @db.Decimal(18, 2)
  totalCgt       Decimal  @db.Decimal(18, 2)
  suggestedPrice Decimal  @db.Decimal(18, 2)
  inputSnapshot  String
}
