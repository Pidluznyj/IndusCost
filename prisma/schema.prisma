  progressProductionOrder Decimal  @default(0) @db.Decimal(10, 2)
  progressProduced        Decimal? @db.Decimal(10, 2)
  progressDocumented      Decimal  @default(0) @db.Decimal(10, 2)
  progressInvoiced        Decimal  @default(0) @db.Decimal(10, 2)
  progressShipped         Decimal  @default(0) @db.Decimal(10, 2)
