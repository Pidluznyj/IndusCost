model FleetIncident {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId            String              @db.Uuid
  driverId             String?             @db.Uuid
  reservationId        String?             @db.Uuid
  incidentType         String
  incidentDate         DateTime            @db.Timestamptz(6)
  location             String?
  description          String
  severity             String              @default("MEDIA")
  status               FleetIncidentStatus @default(OPEN)
  insuranceClaimNumber String?
  deductibleValue      Decimal?            @db.Decimal(20, 6)
  blocksVehicle        Boolean             @default(false)
  notes                String?
  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  vehicle     FleetVehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  driver      FleetDriver?      @relation(fields: [driverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservation FleetReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attachments FleetAttachment[]

  @@index([vehicleId])
  @@index([status])
  @@index([incidentDate])
}

model FleetAttachment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vehicleId      String?  @db.Uuid
  contractId     String?  @db.Uuid
  documentId     String?  @db.Uuid
  maintenanceId  String?  @db.Uuid
  fineId         String?  @db.Uuid
  incidentId     String?  @db.Uuid
  reservationId  String?  @db.Uuid
  attachmentType String
  fileName       String
  fileUrl        String
  uploadedBy     String?
  uploadedAt     DateTime @default(now()) @db.Timestamptz(6)
  notes          String?

  vehicle     FleetVehicle?         @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract    FleetVehicleContract? @relation(fields: [contractId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  document    FleetVehicleDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  maintenance FleetMaintenance?     @relation(fields: [maintenanceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fine        FleetFine?            @relation(fields: [fineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  incident    FleetIncident?        @relation(fields: [incidentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reservation FleetReservation?     @relation(fields: [reservationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vehicleId])
}

model FleetAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String
  entityId   String   @db.Uuid
  action     String
  oldValue   String?
  newValue   String?
  reason     String?
  userId     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model FleetSettings {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// —— Projetos (orçamentos técnicos / simulações) ——

enum ProjectType {
  NEW_PRODUCT
  NEW_COMPONENT
  MOLD
  PRODUCT_CHANGE
  PRODUCT_WITH_NEW_COMPONENT
  FULL_DEVELOPMENT
  QUICK_ESTIMATE
}

enum ProjectStatus {
  DRAFT
  TECHNICAL_ANALYSIS
  WAITING_QUOTATION
  WAITING_INTERNAL_APPROVAL
  SENT_TO_CUSTOMER
  NEGOTIATION
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

enum ProjectSimulatedItemType {
  RAW_MATERIAL
  COMPONENT
  FINISHED_PRODUCT
  PACKAGING
  SERVICE
  MOLD
  TOOLING
  OUTSOURCED_PROCESS
  OTHER
}

enum ProjectStructureSourceType {
  EXISTING_PRODUCT
  EXISTING_MATERIAL
  SIMULATED_ITEM
  MANUAL
}

enum ProjectStructureLineType {
  RAW_MATERIAL
  COMPONENT
  PACKAGING
  SERVICE
  PROCESS
  MOLD_AMORTIZATION
  OTHER
}

enum ProjectMoldChargeMode {
  CHARGED_SEPARATELY
  AMORTIZED_IN_PRODUCT
  PARTIALLY_ABSORBED
  INTERNAL_INVESTMENT
}

enum ProjectMoldOwnership {
  CUSTOMER
  COMPANY
  SHARED
  UNDEFINED
}

enum ProjectCostAmortizationSourceType {
  MOLD
  OTHER_COST
}

enum ProjectCostAmortizationTargetType {
  OFFICIAL_PRODUCT
  OFFICIAL_COMPONENT
  SIMULATION
  LEGACY
}

enum ProjectCostAmortizationStatus {
  NOT_CONFIGURED
  INCOMPLETE
  EXCESS
  DISTRIBUTED
  NO_ELIGIBLE_ITEMS
}

/// Where per-item amortization enters commercial economics:
/// COST — adds to unit cost (margin may apply on amortized cost).
/// FINAL_PRICE — pass-through add-on after product price (no product margin on recovery).
enum ProjectAmortizationApplicationMode {
  COST
  FINAL_PRICE
}

model Project {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                Int           @unique @default(autoincrement())
  code                  String        @unique
  title                 String
  customerName          String
  customerDocument      String?
  description           String?
  projectType           ProjectType
  status                ProjectStatus @default(DRAFT)
  commercialOwner       String?
  technicalOwner        String?
  expectedMonthlyVolume Decimal?      @db.Decimal(20, 6)
  targetPrice           Decimal?      @db.Decimal(20, 6)
  targetMarginPercent   Decimal?      @db.Decimal(10, 6)
  notes                 String?
  createdAt             DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  versions            ProjectVersion[]
  simulatedProducts   ProjectSimulatedProduct[]
  simulatedItems      ProjectSimulatedItem[]
  structureLines      ProjectStructureLine[]
  molds               ProjectMold[]
  costAmortizations   ProjectCostAmortization[]
  pricingConfig       ProjectPricingConfig?
  pricingItems        ProjectPricingItem[]
  clientProposalItems ProjectClientProposalItem[]
  purchaseRequests    PurchaseRequest[]

  @@index([status])
  @@index([projectType])
  @@index([customerName])
  @@index([updatedAt])
}

enum ProjectPricingItemStatus {
  NO_COST
  PENDING
  CALCULATED
  ERROR
}

model ProjectPricingConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String   @unique @db.Uuid
  fiscalRuleId         String?  @db.Uuid
  defaultMarginPercent Decimal? @db.Decimal(10, 6)
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fiscalRule TaxRule?             @relation(fields: [fiscalRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items      ProjectPricingItem[]

  @@index([fiscalRuleId])
}

model ProjectPricingItem {
  id                                String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                         String                            @db.Uuid
  configId                          String                            @db.Uuid
  targetItemId                      String
  targetItemType                    ProjectCostAmortizationTargetType
  targetDescriptionSnapshot         String
  fiscalRuleId                      String?                           @db.Uuid
  fiscalRuleNameSnapshot            String?
  costBaseUnitSnapshot              Decimal                           @default(0) @db.Decimal(20, 6)
  amortizationUnitCostSnapshot      Decimal                           @default(0) @db.Decimal(20, 6)
  finalUnitCostSnapshot             Decimal                           @default(0) @db.Decimal(20, 6)
  taxPercentSnapshot                Decimal                           @default(0) @db.Decimal(10, 6)
  targetMarginPercent               Decimal                           @default(0) @db.Decimal(10, 6)
  suggestedPrice                    Decimal?                          @db.Decimal(20, 6)
  suggestedPriceWithoutAmortization Decimal?                          @db.Decimal(20, 6)
  /// Preço unitário acordado com o cliente (proposta). Null = usar sugerido c/ amortização.
  agreedCustomerPrice               Decimal?                          @db.Decimal(20, 6)
  taxAmountWithoutAmortization      Decimal?                          @db.Decimal(20, 6)
  marginAmountWithoutAmortization   Decimal?                          @db.Decimal(20, 6)
  taxAmount                         Decimal?                          @db.Decimal(20, 6)
  marginAmount                      Decimal?                          @db.Decimal(20, 6)
  status                            ProjectPricingItemStatus          @default(PENDING)
  createdAt                         DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                         DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)

  project    Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  config     ProjectPricingConfig @relation(fields: [configId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fiscalRule TaxRule?             @relation("ProjectPricingItemFiscalRule", fields: [fiscalRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([projectId, targetItemId])
  @@index([projectId])
  @@index([configId])
  @@index([targetItemId])
}

model ProjectClientProposalItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String   @db.Uuid
  targetItemId   String
  quantityPerSet Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId, targetItemId])
  @@index([projectId])
}

model ProjectVersion {
  id                     String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId              String        @db.Uuid
  versionNumber          Int
  title                  String?
  status                 ProjectStatus @default(DRAFT)
  assumptionsJson        String?
  totalEstimatedCost     Decimal?      @db.Decimal(20, 6)
  totalMoldCost          Decimal?      @db.Decimal(20, 6)
  totalAmortizedMoldCost Decimal?      @db.Decimal(20, 6)
  unitCost               Decimal?      @db.Decimal(20, 6)
  suggestedPrice         Decimal?      @db.Decimal(20, 6)
  marginPercent          Decimal?      @db.Decimal(10, 6)
  markupPercent          Decimal?      @db.Decimal(10, 6)
  expectedVolume         Decimal?      @db.Decimal(20, 6)
  notes                  String?
  isCurrent              Boolean       @default(false)
  createdAt              DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  project           Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  simulatedProducts ProjectSimulatedProduct[]
  simulatedItems    ProjectSimulatedItem[]
  structureLines    ProjectStructureLine[]
  molds             ProjectMold[]

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([isCurrent])
}

model ProjectSimulatedProduct {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId       String   @db.Uuid
  versionId       String   @db.Uuid
  provisionalCode String?
  description     String
  unit            String   @default("UN")
  estimatedWeight Decimal? @db.Decimal(20, 6)
  expectedVolume  Decimal? @db.Decimal(20, 6)
  batchSize       Decimal? @db.Decimal(20, 6)
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        ProjectVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  structureLines ProjectStructureLine[]

  @@index([projectId])
  @@index([versionId])
}

model ProjectSimulatedItem {
  id                        String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                 String                   @db.Uuid
  versionId                 String                   @db.Uuid
  provisionalCode           String?
  description               String
  itemType                  ProjectSimulatedItemType
  unit                      String                   @default("UN")
  estimatedUnitCost         Decimal?                 @db.Decimal(20, 6)
  quotedUnitCost            Decimal?                 @db.Decimal(20, 6)
  supplierName              String?
  leadTimeDays              Int?
  estimatedWeight           Decimal?                 @db.Decimal(20, 6)
  lossPercent               Decimal?                 @default(0) @db.Decimal(10, 6)
  requiresQuotation         Boolean                  @default(false)
  requiresEngineeringReview Boolean                  @default(false)
  canBecomeOfficial         Boolean                  @default(true)
  notes                     String?
  createdAt                 DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)

  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version        ProjectVersion         @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  structureLines ProjectStructureLine[]

  @@index([projectId])
  @@index([versionId])
  @@index([itemType])
}

model ProjectStructureLine {
  id                           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                    String                     @db.Uuid
  versionId                    String                     @db.Uuid
  simulatedProductId           String?                    @db.Uuid
  parentLineId                 String?                    @db.Uuid
  level                        Int?
  treePath                     String?
  snapshotRootProductId        String?                    @db.Uuid
  lineType                     ProjectStructureLineType
  sourceType                   ProjectStructureSourceType
  existingProductId            String?                    @db.Uuid
  existingMaterialId           String?                    @db.Uuid
  simulatedItemId              String?                    @db.Uuid
  sourceOfficialBomId          String?
  sourceOfficialRoutingId      String?
  descriptionSnapshot          String
  unitSnapshot                 String
  quantity                     Decimal                    @db.Decimal(20, 6)
  lossPercent                  Decimal?                   @default(0) @db.Decimal(10, 6)
  officialQuantitySnapshot     Decimal?                   @db.Decimal(20, 6)
  officialLossPercentSnapshot  Decimal?                   @db.Decimal(10, 6)
  officialUnitCostSnapshot     Decimal?                   @db.Decimal(20, 6)
  unitCostSnapshot             Decimal                    @db.Decimal(20, 6)
  totalCost                    Decimal                    @db.Decimal(20, 6)
  costSource                   String?
  isChangedFromOfficial        Boolean                    @default(false)
  isMissingCost                Boolean                    @default(false)
  countsInSimulatedProductCost Boolean                    @default(true)
  supplierNameSnapshot         String?
  notes                        String?
  sortOrder                    Int                        @default(0)
  createdAt                    DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version          ProjectVersion           @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  simulatedProduct ProjectSimulatedProduct? @relation(fields: [simulatedProductId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  parentLine       ProjectStructureLine?    @relation("StructureLineHierarchy", fields: [parentLineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  childLines       ProjectStructureLine[]   @relation("StructureLineHierarchy")
  existingProduct  Product?                 @relation(fields: [existingProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  existingMaterial Material?                @relation(fields: [existingMaterialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  simulatedItem    ProjectSimulatedItem?    @relation(fields: [simulatedItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([projectId])
  @@index([versionId])
  @@index([simulatedProductId])
  @@index([parentLineId])
  @@index([snapshotRootProductId])
}

model ProjectMold {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String                @db.Uuid
  versionId            String                @db.Uuid
  name                 String
  moldType             String?
  cavities             Int?
  estimatedLifeCycles  Int?
  supplierName         String?
  constructionCost     Decimal               @default(0) @db.Decimal(20, 6)
  maintenanceCost      Decimal?              @db.Decimal(20, 6)
  changeCost           Decimal?              @db.Decimal(20, 6)
  leadTimeDays         Int?
  chargeMode           ProjectMoldChargeMode @default(CHARGED_SEPARATELY)
  amortizationQuantity Decimal?              @db.Decimal(20, 6)
  amortizedCostPerUnit Decimal?              @db.Decimal(20, 6)
  ownership            ProjectMoldOwnership  @default(UNDEFINED)
  notes                String?
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @default(now()) @updatedAt @db.Timestamptz(6)

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  version ProjectVersion @relation(fields: [versionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
  @@index([versionId])
}

model ProjectCostAmortization {
  id                        String                            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                 String                            @db.Uuid
  sourceType                ProjectCostAmortizationSourceType
  sourceId                  String
  sourceBatchId             String?
  sourceDescriptionSnapshot String
  sourceTotalCostSnapshot   Decimal                           @db.Decimal(20, 6)
  passThroughPercent        Decimal                           @default(100) @db.Decimal(10, 6)
  passThroughAmount         Decimal                           @default(0) @db.Decimal(20, 6)
  absorbedAmount            Decimal                           @default(0) @db.Decimal(20, 6)
  status                    ProjectCostAmortizationStatus     @default(NOT_CONFIGURED)
  createdAt                 DateTime                          @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                          @default(now()) @updatedAt @db.Timestamptz(6)

  project     Project                             @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  allocations ProjectCostAmortizationAllocation[]

  @@unique([projectId, sourceType, sourceId])
  @@index([projectId])
  @@index([sourceType])
}

model ProjectCostAmortizationAllocation {
  id                          String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  amortizationId              String                             @db.Uuid
  projectId                   String                             @db.Uuid
  targetItemType              ProjectCostAmortizationTargetType
  targetItemId                String
  targetSnapshotRootProductId String?                            @db.Uuid
  targetDescriptionSnapshot   String
  targetBaseUnitCostSnapshot  Decimal                            @default(0) @db.Decimal(20, 6)
  allocationPercent           Decimal                            @default(0) @db.Decimal(10, 6)
  allocatedAmount             Decimal                            @default(0) @db.Decimal(20, 6)
  amortizationQuantity        Decimal                            @default(1) @db.Decimal(20, 6)
  /// Calculated amortization per unit (allocatedAmount / qty). Always stored for audit.
  unitAmortizedCost           Decimal                            @default(0) @db.Decimal(20, 6)
  /// COST (default) or FINAL_PRICE — where the unit amortization applies commercially.
  applicationMode             ProjectAmortizationApplicationMode @default(COST)
  /// Portion that enters item unit cost (equals unitAmortizedCost for COST; 0 for FINAL_PRICE).
  costComponentUnit           Decimal                            @default(0) @db.Decimal(20, 6)
  /// Portion added after product price formation (0 for COST; equals unitAmortizedCost for FINAL_PRICE).
  priceAddOnUnit              Decimal                            @default(0) @db.Decimal(20, 6)
  /// Final unit cost for costing/pricing base (base + costComponentUnit). Never includes FINAL_PRICE add-on.
  finalUnitCostSnapshot       Decimal                            @default(0) @db.Decimal(20, 6)
  createdAt                   DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                           @default(now()) @updatedAt @db.Timestamptz(6)

  amortization ProjectCostAmortization @relation(fields: [amortizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([amortizationId])
  @@index([projectId])
  @@index([targetItemId])
}

// —— Financeiro: fornecedores consolidados e classificação gerencial AP ——
// Camada aditiva; NomusAccountsPayable permanece fonte read-only dos títulos.

enum FinancialSupplierSource {
  AUTO_SYNC
  MANUAL
  IMPORT
  NOMUS_BOOTSTRAP
}

enum FinancialSupplierStatus {
  ACTIVE
  NEEDS_REVIEW
  MERGED
  INACTIVE
}

enum FinancialCostCenterStatus {
  ACTIVE
  INACTIVE
}

enum CostCenterAllocationSource {
  AUTO_RULE
  MANUAL
  BATCH
}

enum FinancialCostCenterClassificationRuleType {
  SUPPLIER
  NOMUS_CLASSIFICATION
  DESCRIPTION_CONTAINS
  DOCUMENT_CONTAINS
  KEYWORDS
  NO_SUPPLIER
  FINANCIAL_NATURE
  MANUAL
  COMPOSITE
}

/// Fornecedor consolidado para classificação gerencial de AP (não substitui personName/personCnpj no Nomus).
model FinancialSupplier {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  displayName        String
  legalName          String?
  tradeName          String?
  document           String?
  normalizedDocument String?
  normalizedName     String?
  source             FinancialSupplierSource @default(NOMUS_BOOTSTRAP)
  status             FinancialSupplierStatus @default(ACTIVE)
  confidence         Decimal?                @db.Decimal(5, 2)
  firstSeenAt        DateTime?               @db.Timestamptz(6)
  lastSeenAt         DateTime?               @db.Timestamptz(6)
  titlesCount        Int                     @default(0)
  totalAmountSeen    Decimal                 @default(0) @db.Decimal(20, 2)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  aliases              FinancialSupplierAlias[]
  costCenterRules      SupplierCostCenterRule[]
  classificationRules  FinancialCostCenterClassificationRule[]
  allocations          AccountsPayableCostCenterAllocation[]
  materialMarketQuotes MaterialMarketQuote[]
  serviceTerminations  SupplierServiceTermination[]
  /// Compras SC — convites/ofertas/PO usam ID oficial (sem cadastro paralelo).
  purchaseQuotationSuppliers PurchaseQuotationSupplier[]
  purchaseOrders             PurchaseOrder[]

  @@index([normalizedDocument])
  @@index([normalizedName])
  @@index([status])
  @@index([displayName])
}

/// Encerramento / distrato civil de prestação de serviço PJ (não é rescisão CLT).
enum SupplierServiceTerminationStatus {
  DRAFT
  AWAITING_SIGNATURE
  SIGNED_AWAITING_PAYMENT
  PAID_AND_SETTLED
  CANCELED
  /// Legado — migrado para PAID_AND_SETTLED / SIGNED_AWAITING_PAYMENT.
  FINALIZED
}

enum SupplierServiceTerminationCalcMode {
  WORKED_MONTHS
  WORKED_DAYS
}

enum SupplierServiceTerminationModality {
  MUTUAL_AGREEMENT
  CONTRACTOR_INITIATIVE
  CONTRACTED_INITIATIVE
}

enum SupplierServiceTerminationCommissionTreatment {
  NONE_PENDING
  HAS_PENDING
  NEGOTIATED_INCLUDED
}

enum SupplierServiceTerminationNoticeOrigin {
  CONTRACT_CLAUSE
  AGREEMENT
  OTHER
}

model SupplierServiceTermination {
  id                        String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  supplierId                String                             @db.Uuid
  personName                String
  personDocument            String?
  serviceRole               String?
  contractStartDate         DateTime                           @db.Date
  contractEndDate           DateTime                           @db.Date
  monthlyServiceAmount      Decimal                            @db.Decimal(20, 2)
  /// Dias médios considerados no mês (parâmetro interno de cálculo).
  averageWorkedDaysPerMonth Decimal                            @default(30) @db.Decimal(8, 2)
  /// Horas por dia (parâmetro interno — não impresso no distrato).
  hoursPerDay               Decimal                            @default(8) @db.Decimal(8, 2)
  monthlyHours              Decimal                            @db.Decimal(12, 2)
  hourlyServiceAmount       Decimal                            @db.Decimal(20, 4)
  dailyServiceAmount        Decimal                            @db.Decimal(20, 4)
  restDaysPerYear           Decimal                            @default(20) @db.Decimal(8, 2)
  calculationMode           SupplierServiceTerminationCalcMode @default(WORKED_MONTHS)
  workedMonths              Decimal                            @db.Decimal(10, 4)
  workedDays                Int                                @default(0)
  proportionalRestDays      Decimal                            @db.Decimal(12, 4)
  proportionalRestAmount    Decimal                            @db.Decimal(20, 2)
  /// Dias/serviços adicionais no período do encerramento (cálculo interno).
  extraWorkedDays           Int                                @default(0)
  extraWorkedAmount         Decimal                            @default(0) @db.Decimal(20, 2)
  /// Compensação/valor negociado de encerramento (cálculo interno).
  noticePenaltyAmount       Decimal                            @default(0) @db.Decimal(20, 2)
  commissionReportId        String?
  commissionReportTotal     Decimal                            @default(0) @db.Decimal(20, 2)
  otherCredits              Decimal                            @default(0) @db.Decimal(20, 2)
  otherDiscounts            Decimal                            @default(0) @db.Decimal(20, 2)
  totalTerminationAmount    Decimal                            @db.Decimal(20, 2)
  status                    SupplierServiceTerminationStatus   @default(DRAFT)
  notes                     String?
  adjustmentNotes           String?
  createdById               String?
  createdByName             String?
  finalizedById             String?
  finalizedByName           String?
  finalizedAt               DateTime?                          @db.Timestamptz(6)
  createdAt                 DateTime                           @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                           @default(now()) @updatedAt @db.Timestamptz(6)

