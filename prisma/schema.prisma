  @@index([expiresAt])
  @@index([revokedAt])
}

/// Tipo hierárquico do catálogo relacional de permissões (MENU → SUBMENU → TAB → ACTION).
/// Complementa o catálogo em código (`PERMISSION_CATALOG`); não substitui AppUser.permissions[] ainda.
enum PermissionResourceType {
  MENU
  SUBMENU
  TAB
  ACTION
}

model PermissionResource {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key             String                   @unique
  label           String
  description     String?
  type            PermissionResourceType
  parentKey       String?
  module          String
  sortOrder       Int                      @default(0)
  isSystem        Boolean                  @default(true)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(6)
  parent          PermissionResource?      @relation("PermissionResourceHierarchy", fields: [parentKey], references: [key], onDelete: Restrict, onUpdate: Cascade)
  children        PermissionResource[]     @relation("PermissionResourceHierarchy")
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([type])
  @@index([module])
  @@index([parentKey])
  @@index([isActive])
  @@index([sortOrder])
}

model RolePermission {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role        AppUserRole
  resourceKey String
  canView     Boolean            @default(false)
  canExecute  Boolean            @default(false)
  canManage   Boolean            @default(false)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  resource    PermissionResource @relation(fields: [resourceKey], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([role, resourceKey])
  @@index([role])
  @@index([resourceKey])
}

model UserPermissionOverride {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String             @db.Uuid
  resourceKey String
  canView     Boolean?
  canExecute  Boolean?
  canManage   Boolean?
  reason      String?
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  user        AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resource    PermissionResource @relation(fields: [resourceKey], references: [key], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, resourceKey])
  @@index([userId])
  @@index([resourceKey])
}

/// Auditoria de mudanças de ACL (não existe AppUserChangeLog genérico; domain AuditLogs não cobrem permissões).
