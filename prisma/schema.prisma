generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Machine {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                 @unique
  name                 String
  acquisitionValue     Decimal                @db.Decimal(20, 6)
  residualValue        Decimal                @db.Decimal(20, 6)
  usefulLifeMonths     Int
  createdAt            DateTime?              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  MachineCostComponent MachineCostComponent[]
  ProductRouting       ProductRouting[]
}

model MachineCostComponent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId            String   @db.Uuid
  name                 String
  monthlyEstimatedCost Decimal  @db.Decimal(20, 6)
  isVariable           Boolean? @default(false)
  Machine              Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique
  baseSalary     Decimal          @db.Decimal(20, 6)
  monthlyHours   Int?             @default(220)
  createdAt      DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  Employee       Employee[]
  ProductRouting ProductRouting[]
}

model Employee {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  roleId                   String                     @db.Uuid
  department               String
  costCenter               String
  classification           String
  salary                   Decimal                    @db.Decimal(20, 6)
  monthlyHours             Int
  productivity             Decimal?                   @default(100.00) @db.Decimal(10, 6)
  status                         String?                    @default("ACTIVE")
  socialName                     String?
  cpf                            String?
  rg                             String?
  birthDate                      DateTime?                  @db.Timestamptz(6)
  phone                          String?
  personalEmail                  String?
  emergencyContactName           String?
  emergencyContactPhone          String?
  emergencyContactRelationship   String?
  admissionDate                  DateTime?                  @db.Timestamptz(6)
  terminationDate                DateTime?                  @db.Timestamptz(6)
  contractType                   String?
  managerName                    String?
  professionalNotes              String?
  address                        String?
  adminNotes                     String?
  shirtSize                      String?
  pantsSize                      String?
  jacketSize                     String?
  gloveSize                      String?
  shoeSize                       String?
  epiNotes                       String?
  createdAt                      DateTime?                  @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)
  Role                     Role                       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  EmployeePayrollComponent EmployeePayrollComponent[]
}

model PayrollComponent {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String                     @unique
  type            String
  calculationType String
  value           Decimal                    @db.Decimal(20, 6)
  createdAt       DateTime?                  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)
  employees       EmployeePayrollComponent[]
}

model EmployeePayrollComponent {
  employeeId         String           @db.Uuid
  payrollComponentId String           @db.Uuid
  Employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  PayrollComponent   PayrollComponent @relation(fields: [payrollComponentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([employeeId, payrollComponentId])
}

model Material {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                 String                 @unique
  description          String
  unit                 String
  category             String
  supplier             String?
  currentCost          Decimal                @db.Decimal(20, 6)
  averageCost          Decimal                @db.Decimal(20, 6)
  standardCost         Decimal                @db.Decimal(20, 6)
  freight              Decimal?               @default(0) @db.Decimal(20, 6)
  standardLoss         Decimal?               @default(0) @db.Decimal(10, 6)
  conversionFactor     Decimal?               @default(1) @db.Decimal(20, 6)
  status               String?                @default("ACTIVE")
  createdAt            DateTime?              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  MaterialPriceHistory MaterialPriceHistory[]
  ProductBOM           ProductBOM[]
  PurchaseRequestItem  PurchaseRequestItem[]
}

model MaterialPriceHistory {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId    String    @db.Uuid
  price         Decimal   @db.Decimal(20, 6)
  freight       Decimal?  @default(0) @db.Decimal(20, 6)
  effectiveDate DateTime? @default(now()) @db.Timestamptz(6)
  Material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Product {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sku                String               @unique
  name               String
  description        String?
  version            String?              @default("1.0.0")
  status             String?              @default("ACTIVE")
  defaultLotSize     Decimal?             @default(1) @db.Decimal(20, 6)
  createdAt          DateTime?            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  type               ItemType             @default(PRODUCT)
  cycleTimeSeconds   Decimal?             @db.Decimal(20, 6)
  cavities           Int?
  setupTimeMin       Decimal?             @db.Decimal(20, 6)
  efficiencyExpected Decimal?             @db.Decimal(10, 6)
  sourceSystem       String?
  sourceExternalId   String?
  isNomusControlled  Boolean              @default(false)
  lastNomusSyncAt    DateTime?            @db.Timestamptz(6)
  nomusPayloadHash   String?
  costingMode        ProductCostingMode   @default(OWN_PROCESS)
  CostCalculationLog CostCalculationLog[]
  UsedInBOM          ProductBOM[]         @relation("ChildProduct")
  ProductBOM         ProductBOM[]         @relation("ParentProduct")
  ProductPricing     ProductPricing[]
  ProductRouting     ProductRouting[]
  ProposalItem       ProposalItem[]
  SalesOrderItem     SalesOrderItem[]
  PriceTableItem     PriceTableItem[]

  @@index([type], map: "idx_Product_type")
  @@index([isNomusControlled], map: "idx_Product_isNomusControlled")
  @@index([sourceSystem], map: "idx_Product_sourceSystem")
  @@index([costingMode], map: "idx_Product_costingMode")
}

model ProductBOM {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String    @db.Uuid
  materialId         String?   @db.Uuid
  quantity           Decimal   @db.Decimal(20, 6)
  lossPercentage     Decimal?  @default(0) @db.Decimal(10, 6)
  notes              String?
  childProductId     String?   @db.Uuid
  sourceSystem       String?
  isNomusControlled  Boolean   @default(false)
  localException     Boolean   @default(false)
  lastNomusSyncAt    DateTime? @db.Timestamptz(6)
  nomusComponentCode String?
  ChildProduct       Product?  @relation("ChildProduct", fields: [childProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Material           Material? @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ParentProduct      Product   @relation("ParentProduct", fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([childProductId], map: "idx_ProductBOM_childProductId")
  @@index([productId], map: "idx_ProductBOM_productId")
  @@index([isNomusControlled], map: "idx_ProductBOM_isNomusControlled")
  @@index([localException], map: "idx_ProductBOM_localException")
}

model ProductRouting {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId          String   @db.Uuid
  sequence           Int
  description        String?
  machineId          String   @db.Uuid
  roleId             String   @db.Uuid
  setupTimeMin       Decimal? @default(0) @db.Decimal(20, 6)
  operationTimeMin   Decimal? @default(0) @db.Decimal(20, 6)
  efficiencyExpected Decimal? @default(100) @db.Decimal(10, 6)
  notes              String?
  cycleTimeSeconds   Decimal? @default(30) @db.Decimal(20, 6)
  cavities           Int?     @default(1)
  Machine            Machine  @relation(fields: [machineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Role               Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model IndirectCost {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  description        String
  category           String
  monthlyValue       Decimal   @db.Decimal(20, 6)
  costCenter         String?
  allocationCriteria String
  status             String?   @default("ACTIVE")
  createdAt          DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
}

model TaxRule {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @unique
  description    String?
  operation      String
  status         String?          @default("ACTIVE")
  createdAt      DateTime?        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  ProductPricing       ProductPricing[]
  TaxComponent         TaxComponent[]
  priceTableVersions   PriceTableVersion[] @relation("PriceTableVersionTaxRule")
}

model TaxComponent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taxRuleId     String   @db.Uuid
  name          String
  percentage    Decimal  @db.Decimal(10, 6)
  isRecoverable Boolean? @default(false)
  baseType      String?  @default("GROSS_PRICE")
  TaxRule       TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ProductPricing {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String    @db.Uuid
  taxRuleId      String    @db.Uuid
  desiredMargin  Decimal?  @default(15.0) @db.Decimal(10, 6)
  commission     Decimal?  @default(0.0) @db.Decimal(10, 6)
  freightOut     Decimal?  @default(0.0) @db.Decimal(20, 6)
  otherVariables Decimal?  @default(0.0) @db.Decimal(10, 6)
  status         String?   @default("ACTIVE")
  createdAt      DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
  Product        Product   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  TaxRule        TaxRule   @relation(fields: [taxRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, taxRuleId])
}

model Simulation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  productId     String    @db.Uuid
  taxRuleId     String    @db.Uuid
  materialAdj   Decimal?  @default(0) @db.Decimal(10, 6)
  laborAdj      Decimal?  @default(0) @db.Decimal(10, 6)
  indirectAdj   Decimal?  @default(0) @db.Decimal(10, 6)
  efficiencyAdj Decimal?  @default(0) @db.Decimal(10, 6)
  marginAdj     Decimal?  @default(0) @db.Decimal(10, 6)
  createdAt     DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)
}

model NewProductSimulation {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  status             NewProductSimulationStatus @default(SAVED)
  sourceSimulationId String?                    @db.Uuid
  productName        String
  productSku         String?
  notes              String?
  snapshot           Json
  savedAt            DateTime?                  @db.Timestamptz(6)
  createdBy          String?
  origin             String?
  createdAt          DateTime?                  @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime?                  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt], map: "idx_NewProductSimulation_status_createdAt")
}

model Customer {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName        String
  tradeName          String?
  taxId              String               @unique
  stateTaxId         String?
  contactName        String?
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  zipCode            String?
  country            String               @default("Brasil")
  segment            String?
  notes              String?
  status             String               @default("ACTIVE")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
  commercialNotes    String?
  relationshipStatus String?
  accountOwner       String?
  CommercialActivity CommercialActivity[]
  CrmCustomerProfile CrmCustomerProfile?
  proposals          Proposal[]
  salesOrders        SalesOrder[]
}

model Proposal {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number                 Int                  @unique @default(autoincrement())
  title                  String?
  customerId             String               @db.Uuid
  status                 ProposalStatus       @default(DRAFT)
  responsible            String?
  companyIssuer          String?
  validityDays           Int                  @default(15)
  paymentTerms           String?
  paymentMethod          String?
  deliveryTimeDays       Int?
  freightCondition       String?              @default("CIF")
  deliveryLocation       String?
  notes                  String?
  internalNotes          String?
  totalItems             Int                  @default(0)
  totalGrossValue        Decimal              @default(0) @db.Decimal(20, 6)
  totalDiscount          Decimal              @default(0) @db.Decimal(20, 6)
  totalNetValue          Decimal              @default(0) @db.Decimal(20, 6)
  totalCost              Decimal              @default(0) @db.Decimal(20, 6)
  totalMarginValue       Decimal              @default(0) @db.Decimal(20, 6)
  totalMarginPerc        Decimal              @default(0) @db.Decimal(10, 6)
  totalTaxes             Decimal              @default(0) @db.Decimal(20, 6)
  totalCommission        Decimal              @default(0) @db.Decimal(20, 6)
  totalFreight           Decimal              @default(0) @db.Decimal(20, 6)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt
  expectedCloseDate      DateTime?            @db.Timestamp(6)
  source                 String?
  lossReason             String?
  lossReasonDetail       String?
  probabilityPerc        Decimal?             @db.Decimal(5, 2)
  priority               Int?
  nextActionAt           DateTime?            @db.Timestamp(6)
  nextActionNote         String?
  sourceSystem           String?
  externalProposalId     Int?
  externalProposalCode   String?
  externalCustomerId     Int?
  externalSellerId       Int?
  externalCompanyId      Int?
  externalMovementTypeId Int?
  externalOpenedAt       DateTime?            @db.Timestamptz(6)
  externalRawPayload     Json?
  priceTableId           String?              @db.Uuid
  priceTableVersionId    String?              @db.Uuid
  priceTableCode         String?
  priceTableVersionNumber Int?
  priceSource            String?
  CommercialActivity     CommercialActivity[]
  Customer               Customer             @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items                  ProposalItem[]
  salesOrder             SalesOrder?

  @@unique([sourceSystem, externalProposalId])
  @@index([customerId])
  @@index([sourceSystem])
  @@index([externalProposalCode])
  @@index([expectedCloseDate])
  @@index([nextActionAt])
  @@index([priceTableId])
  @@index([priceTableVersionId])
  @@index([priceSource])
}

model ProposalItem {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId         String           @db.Uuid
  productId          String           @db.Uuid
  quantity           Decimal          @db.Decimal(20, 6)
  unit               String?
  unitCost           Decimal          @db.Decimal(20, 6)
  suggestedPrice     Decimal          @db.Decimal(20, 6)
  negotiatedPrice    Decimal          @db.Decimal(20, 6)
  discountPerc       Decimal          @default(0) @db.Decimal(10, 6)
  discountValue      Decimal          @default(0) @db.Decimal(20, 6)
  marginValue        Decimal          @db.Decimal(20, 6)
  marginPerc         Decimal          @db.Decimal(10, 6)
  taxesPerc          Decimal          @default(0) @db.Decimal(10, 6)
  taxesValue         Decimal          @default(0) @db.Decimal(20, 6)
  commissionPerc     Decimal          @default(0) @db.Decimal(10, 6)
  commissionValue    Decimal          @default(0) @db.Decimal(20, 6)
  freightValue       Decimal          @default(0) @db.Decimal(20, 6)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  externalItemId     Int?
  externalProductId  Int?
  externalItemStatus String?
  externalRawPayload  Json?
  priceTableItemId    String?          @db.Uuid
  priceSource         String?
  pricingSnapshotJson Json?
  priceTableId            String?          @db.Uuid
  priceTableVersionId     String?          @db.Uuid
  priceTableCode          String?
  priceTableVersionNumber Int?
  Product            Product          @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Proposal           Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salesOrderItems    SalesOrderItem[]

  @@unique([proposalId, externalItemId])
  @@index([productId])
  @@index([proposalId])
  @@index([externalProductId])
  @@index([priceTableItemId])
  @@index([priceSource])
  @@index([priceTableId])
  @@index([priceTableVersionId])
  @@index([priceTableCode])
}

/// Identidade visual global (linha única). Logos armazenados como Data URL em TEXT.
model BrandingSettings {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName               String?  @default("Lazarios Koppetel")
  slogan                    String?  @default("Soluções e qualidade em plásticos")
  primaryColor              String?  @default("#0EA5E9")
  secondaryColor            String?  @default("#1D4ED8")
  systemCompactLogoDataUrl  String?  @db.Text
  systemExpandedLogoDataUrl String?  @db.Text
  proposalLogoDataUrl       String?  @db.Text
  darkLogoDataUrl           String?  @db.Text
  faviconDataUrl            String?  @db.Text
  proposalCoverDataUrl      String?  @db.Text
  proposalSideImageDataUrl  String?  @db.Text
  watermarkDataUrl          String?  @db.Text
  createdAt                 DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model SalesOrder {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId             String?          @unique @db.Uuid
  sourceSystem           String?
  externalSalesOrderId   Int?
  externalSalesOrderCode String?
  orderCode              String           @unique
  customerId             String           @db.Uuid
  externalCustomerId     Int?
  responsible            String?
  externalSellerId       Int?
  companyIssuer          String?
  externalCompanyId      Int?
  status                 SalesOrderStatus @default(READY_TO_SEND)
  issueDate              DateTime         @default(now())
  expectedDeliveryDate   DateTime?
  paymentTerms           String?
  paymentMethod          String?
  freightCondition       String?
  deliveryLocation       String?
  notes                  String?
  internalNotes          String?
  totalItems             Int              @default(0)
  totalGrossValue        Decimal          @default(0) @db.Decimal(20, 6)
  totalDiscount          Decimal          @default(0) @db.Decimal(20, 6)
  totalNetValue          Decimal          @default(0) @db.Decimal(20, 6)
  totalCost              Decimal          @default(0) @db.Decimal(20, 6)
  totalMarginValue       Decimal          @default(0) @db.Decimal(20, 6)
  totalMarginPerc        Decimal          @default(0) @db.Decimal(10, 6)
  totalTaxes             Decimal          @default(0) @db.Decimal(20, 6)
  totalFreight           Decimal          @default(0) @db.Decimal(20, 6)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @default(now()) @updatedAt
  sentToNomusAt          DateTime?
  nomusRawResponse       Json?
  Customer               Customer         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Proposal               Proposal?        @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items                  SalesOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model SalesOrderItem {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId        String        @db.Uuid
  proposalItemId      String?       @db.Uuid
  productId           String        @db.Uuid
  externalProductId   Int?
  skuSnapshot         String
  productNameSnapshot String
  quantity            Decimal       @db.Decimal(20, 6)
  unit                String?
  unitCost            Decimal       @db.Decimal(20, 6)
  negotiatedPrice     Decimal       @db.Decimal(20, 6)
  totalNetValue       Decimal       @db.Decimal(20, 6)
  totalCost           Decimal       @db.Decimal(20, 6)
  marginValue         Decimal       @db.Decimal(20, 6)
  marginPerc          Decimal       @db.Decimal(10, 6)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @default(now()) @updatedAt
  Product             Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ProposalItem        ProposalItem? @relation(fields: [proposalItemId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  SalesOrder          SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([salesOrderId])
  @@index([proposalItemId])
  @@index([productId])
}

/// Tabela de preço comercial (catálogo; margem padrão para futuras publicações).
model PriceTable {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String              @unique
  name             String
  defaultMarginPct Decimal             @db.Decimal(10, 6)
  status           String              @default("ACTIVE")
  createdAt        DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  versions         PriceTableVersion[]
}

/// Versão congelada de uma tabela de preço (DRAFT / PUBLISHED / etc. como string).
model PriceTableVersion {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceTableId           String           @db.Uuid
  taxRuleId              String?          @db.Uuid
  versionNumber          Int
  status                 String           @default("DRAFT")
  generatedAt            DateTime?        @db.Timestamptz(6)
  publishedAt            DateTime?        @db.Timestamptz(6)
  effectiveFrom          DateTime?        @db.Timestamptz(6)
  effectiveTo            DateTime?        @db.Timestamptz(6)
  notes                  String?
  createdBy              String?
  approvedBy             String?
  generationSummaryJson  Json?
  commissionPerc         Decimal?         @db.Decimal(10, 6)
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  PriceTable             PriceTable       @relation(fields: [priceTableId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  TaxRule                TaxRule?         @relation("PriceTableVersionTaxRule", fields: [taxRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items                  PriceTableItem[]

  @@unique([priceTableId, versionNumber])
  @@index([priceTableId])
  @@index([taxRuleId])
  @@index([status])
}

/// Linha publicada de uma versão (snapshot gerado pelo motor atual — Fase 1 sem geração automática).
model PriceTableItem {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  priceTableVersionId   String            @db.Uuid
  productId             String            @db.Uuid
  sku                   String
  productName           String
  frozenTotalCost       Decimal           @db.Decimal(20, 6)
  frozenMaterialCost    Decimal           @default(0) @db.Decimal(20, 6)
  frozenHhCost          Decimal           @default(0) @db.Decimal(20, 6)
  frozenHmCost          Decimal           @default(0) @db.Decimal(20, 6)
  frozenTaxCost         Decimal           @default(0) @db.Decimal(20, 6)
  frozenOtherCost       Decimal           @default(0) @db.Decimal(20, 6)
  marginPct             Decimal           @db.Decimal(10, 6)
  salePrice             Decimal           @db.Decimal(20, 6)
  commissionPerc        Decimal           @default(0) @db.Decimal(10, 6)
  commissionValue       Decimal           @default(0) @db.Decimal(20, 6)
  costSnapshotJson      Json?
  formulaSnapshotJson   Json?
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
