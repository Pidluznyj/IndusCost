model AppUser {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  email                    String                   @unique
  passwordHash             String
  role                     AppUserRole              @default(VIEWER)
  permissions              String[]                 @default([])
  /// Incrementado a cada mutação de ACL (P21). Sessões com epoch desatualizado são invalidadas.
  permissionsVersion       Int                      @default(0)
  accessProfileId          String?                  @db.Uuid
  /// Vínculo obrigatório em novos cadastros → Pessoas / RH (`Employee`).
  employeeId               String?                  @unique @db.Uuid
  /// Identidade canônica (Person). Opcional — legado sem vínculo continua válido.
  personId                 String?                  @unique @db.Uuid
  isActive                 Boolean                  @default(true)
  externalSellerId         Int?
  /// IDs Nomus vinculáveis ao login (um usuário pode ter vários).
  externalSellerIds        Int[]                    @default([])
  sellerResponsibleName    String?
  lastLoginAt              DateTime?                @db.Timestamptz(6)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  accessProfile            AccessProfile?           @relation(fields: [accessProfileId], references: [id], onDelete: SetNull)
  employee                 Employee?                @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  person                   Person?                  @relation(fields: [personId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sessions                 AppSession[]
  permissionOverrides      UserPermissionOverride[]
  permissionAuditsAsActor  PermissionAuditLog[]     @relation("PermissionAuditActor")
  permissionAuditsAsTarget PermissionAuditLog[]     @relation("PermissionAuditTarget")

  @@index([role])
  @@index([isActive])
  @@index([externalSellerId])
  @@index([accessProfileId])
  @@index([employeeId])
  @@index([personId])
}

model AppSession {
