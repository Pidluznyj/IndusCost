  Proposal           Proposal         @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salesOrderItems    SalesOrderItem[]

  @@unique([proposalId, externalItemId])
  @@index([productId])
  @@index([proposalId])
  @@index([externalProductId])
}

model SalesOrder {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proposalId             String?          @unique @db.Uuid
  sourceSystem           String?
  externalSalesOrderId   Int?
  externalSalesOrderCode String?
  orderCode              String           @unique
  customerId             String           @db.Uuid
  externalCustomerId     Int?
  responsible            String?
  externalSellerId       Int?
  companyIssuer          String?
  externalCompanyId      Int?
  status                 SalesOrderStatus @default(READY_TO_SEND)
  issueDate              DateTime         @default(now())
  expectedDeliveryDate   DateTime?
  paymentTerms           String?
  paymentMethod          String?
  freightCondition       String?
  deliveryLocation       String?
  notes                  String?
  internalNotes          String?
  totalItems             Int              @default(0)
  totalGrossValue        Decimal          @default(0) @db.Decimal(20, 6)
  totalDiscount          Decimal          @default(0) @db.Decimal(20, 6)
  totalNetValue          Decimal          @default(0) @db.Decimal(20, 6)
  totalCost              Decimal          @default(0) @db.Decimal(20, 6)
  totalMarginValue       Decimal          @default(0) @db.Decimal(20, 6)
  totalMarginPerc        Decimal          @default(0) @db.Decimal(10, 6)
  totalTaxes             Decimal          @default(0) @db.Decimal(20, 6)
  totalFreight           Decimal          @default(0) @db.Decimal(20, 6)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @default(now()) @updatedAt
  sentToNomusAt          DateTime?
  nomusRawResponse       Json?
  Customer               Customer         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Proposal               Proposal?        @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  items                  SalesOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([issueDate])
}

model SalesOrderItem {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesOrderId        String        @db.Uuid
  proposalItemId      String?       @db.Uuid
  productId           String        @db.Uuid
  externalProductId   Int?
  skuSnapshot         String
  productNameSnapshot String
  quantity            Decimal       @db.Decimal(20, 6)
  unit                String?
  unitCost            Decimal       @db.Decimal(20, 6)
