/// Evento append-only do Fluxo de Pedidos (transições / materialização).
/// Sem updatedAt. Idempotência via dedupeKey única.
/// occurredAt = melhor evidência real; observedAt = quando o IndusCost observou.
model SalesOrderFlowEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  salesOrderId     String  @db.Uuid
  salesOrderItemId String? @db.Uuid

  eventType String
  fromStage String?
  toStage   String?

  /// Chave estável de deduplicação (única).
  dedupeKey String @unique

  /// Detalhes auditáveis sanitizados (sem payload bruto sensível).
  /// App usa o alias detailsJson na escrita do repository.
  payloadJson Json?
  actorId     String?

  occurredAt DateTime  @default(now()) @db.Timestamptz(6)
  /// Instantâneo em que o IndusCost observou/materializou o evento.
  observedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  salesOrder     SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([salesOrderId, occurredAt(sort: Desc)])
  @@index([salesOrderItemId])
  @@index([eventType])
  @@index([toStage])
  @@index([occurredAt])
  @@index([observedAt])
}

