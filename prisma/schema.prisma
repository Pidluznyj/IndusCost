  SUCCESS
  FAILED
  INCONCLUSIVE
}

/// SYNC-02 — execução tipada de sync Nomus para reconciliação de presença.
/// Complementa IntegrationRun (operacional genérico); não substitui syncers ainda.
model NomusSourceSyncRun {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType      NomusSourceSyncEntityType
  strategy        String
  /// Universo coberto (JSON canônico: kind, from, to, onlyPending, etc.).
  scope           Json
  startedAt       DateTime
  finishedAt      DateTime?
  status          NomusSourceSyncRunStatus  @default(RUNNING)
  /// Só SUCCESS + payloadComplete=true autoriza reconciliação de ausências.
  payloadComplete Boolean                   @default(false)

  pagesRead             Int @default(0)
  rowsRead              Int @default(0)
  createdCount          Int @default(0)
  updatedCount          Int @default(0)
  unchangedCount        Int @default(0)
  missingCandidateCount Int @default(0)
  missingConfirmedCount Int @default(0)
  reactivatedCount      Int @default(0)
  http429Count          Int @default(0)
  errors                Int @default(0)

  coveredFrom DateTime?
  coveredTo   DateTime?

  errorMessage String?
  summaryJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  salesOrdersLastSeen        SalesOrder[]              @relation("SalesOrderLastSourceSyncRun")
  accountsReceivableLastSeen NomusAccountsReceivable[] @relation("ArLastSourceSyncRun")
  accountsPayableLastSeen    NomusAccountsPayable[]    @relation("ApLastSourceSyncRun")

  @@index([entityType, status, startedAt])
  @@index([status])
  @@index([payloadComplete])
  @@index([startedAt])
  @@index([entityType, coveredFrom, coveredTo])
}

