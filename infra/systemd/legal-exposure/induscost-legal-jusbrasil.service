[Unit]
Description=IndusCost Exposure — Jusbrasil stale complement
Documentation=file:README.md

[Service]
Type=oneshot
WorkingDirectory=/opt/induscost
EnvironmentFile=-/opt/induscost/.env
ExecStart=/usr/bin/flock -n /run/induscost-legal-jusbrasil.lock /usr/bin/npm run legal-exposure:sync --prefix /opt/induscost -- --source=JUSBRASIL --mode=apply
Nice=10
