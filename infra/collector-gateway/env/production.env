# ─────────────────────────────────────────────────────────────────────────────
# IndusCost — gateway HTTPS do Stock Collector — PRODUÇÃO (host AWS)
#
# Único lugar onde o IP/hostname Tailscale e a porta da app de PRODUÇÃO ficam
# escritos. O instalador (scripts/install-collector-gateway.sh) lê este arquivo,
# renderiza o vhost Nginx, instala o drop-in do systemd e grava uma cópia em
# /etc/induscost/collector-gateway.env (lida pelo wait-for-tailscale no boot).
#
# Sem segredo aqui. Formato: KEY=valor, sem espaços, sem aspas.
# ─────────────────────────────────────────────────────────────────────────────

# Identificação do ambiente (aparece nos logs e no resumo do instalador).
COLLECTOR_ENV=production

# Hostname MagicDNS do host que termina o TLS (mesmo nome do certificado).
COLLECTOR_TAILSCALE_HOSTNAME=induscost-prod-saopaulo.tail31eb9e.ts.net

# IPv4 Tailscale do host. O Nginx faz bind SOMENTE neste endereço.
COLLECTOR_TAILSCALE_IP=100.85.97.124

# Porta local da aplicação Node NESTE host (produção roda em 0.0.0.0:3000 na AWS).
COLLECTOR_APP_PORT=3000

# Porta HTTPS do gateway (443 = URL dos QR Codes já impressos; não mudar).
COLLECTOR_HTTPS_PORT=443

# Certificado emitido por `tailscale cert <hostname>` neste host.
COLLECTOR_TLS_DIR=/etc/induscost/collector-tls

# Nome do vhost em /etc/nginx/sites-available e sites-enabled.
COLLECTOR_NGINX_SITE=induscost-collector-prod

# Quanto tempo o boot espera o Tailscale disponibilizar o IP antes de desistir.
COLLECTOR_TAILSCALE_WAIT_TIMEOUT=120
