# ─────────────────────────────────────────────────────────────────────────────
# IndusCost — gateway HTTPS do Stock Collector — HOMOLOGAÇÃO (servidor-01)
#
# *** CONFIGURAR ANTES DE USAR ***
# Os valores marcados CONFIGURE_ME NÃO estão confirmados no servidor-01.
# O instalador RECUSA executar (inclusive --dry-run) enquanto houver
# CONFIGURE_ME. Descubra no host e substitua (commit) antes de instalar:
#
#   sudo nginx -T | grep -E 'listen|server_name|ssl_certificate'   # vhost e TLS atuais
#   sudo grep -rl 'servidor-01.tail31eb9e.ts.net' /etc/nginx/       # caminho real do arquivo
#   ls -l /etc/nginx/tls /etc/induscost/collector-tls 2>/dev/null   # onde está o certificado
#
# Se o Collector HTTPS ainda não existir no servidor-01, NÃO invente: o
# certificado precisa ser emitido (`tailscale cert`) e o caminho do vhost
# decidido antes; o instalador cria o arquivo no caminho informado.
#
# Valores confirmados pela documentação vigente do projeto
# (docs/stock-collector-secure-ingress.md, infra/satisfaction-homolog/APLICAR.md):
#   hostname servidor-01.tail31eb9e.ts.net · IP 100.64.174.124 · app 127.0.0.1:3001
#   A :3000 do servidor-01 é o GATEWAY DE PRODUÇÃO — nunca aqui.
# ─────────────────────────────────────────────────────────────────────────────

COLLECTOR_ENV=homolog
COLLECTOR_TAILSCALE_HOSTNAME=servidor-01.tail31eb9e.ts.net
COLLECTOR_TAILSCALE_IP=100.64.174.124
COLLECTOR_APP_PORT=3001
COLLECTOR_HTTPS_PORT=443

# Diretório com servidor-01.tail31eb9e.ts.net.crt/.key — CONFIRMAR NO HOST.
COLLECTOR_TLS_DIR=CONFIGURE_ME

# Caminho REAL do vhost do Collector no servidor-01 — CONFIRMAR NO HOST.
# Ex.: /etc/nginx/conf.d/induscost-collector.conf
#      ou /etc/nginx/sites-available/induscost-collector-homolog (se já for assim lá)
COLLECTOR_NGINX_CONFIG_PATH=CONFIGURE_ME

COLLECTOR_TAILSCALE_WAIT_TIMEOUT=120
