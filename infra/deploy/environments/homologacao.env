# Ambiente de HOMOLOGAÇÃO (servidor-01) para infra/deploy/induscost-deploy-executor.sh.
# Instalado em /etc/induscost/deploy-executor-homologacao.env (root, 0600) por install-induscost-deploy.sh.
#
# Valores CONFIRMADOS pelo operador em 28/10/2026 (release 4cab35b5 instalado e saudável; executor antigo ativo) e em
# 29/10/2026 (usuário/binários do PostgreSQL 17, modo, política de subida, globs, verificações do executor antigo).
# A_COLETAR = não confirmado: o instalador e o executor recusam até ser preenchido. Nenhum valor abaixo foi deduzido;
# cada A_COLETAR restante diz por que falta e o comando (só leitura) que o revela — ver também infra/deploy/COLETA.md.
#
# O host tem DOIS clusters PostgreSQL: 12 em 5432 (socket padrão, banco teste_bi, backup diário 22h30 por
# induscost-db-backup.timer) e 17 em 5433 (socket /run/induscost-pg17). Tudo aqui aponta explicitamente para o 17;
# a biblioteca confere versão/porta/socket antes de qualquer ação (G7) e nunca toca os bancos protegidos.

IDS_ENV_NAME=homologacao

# --- executor antigo (substituído pelo wrapper; guardado byte a byte; --uninstall devolve) -----------------------
EXECUTOR_PATH=/usr/local/bin/deploy-induscost-homologacao
EXECUTOR_EXPECTED_SHA256=114c438fb993b1fcef99b04f9f255900a7c008cde3c142a458e26a8fb5697411   # sha256sum do executor antigo
LEGACY_WRAPPER_PATH=/usr/local/bin/induscost-deploy-homologacao    # comando do operador; repassa "$@" (confirmado 29/10)

# --- aplicação ----------------------------------------------------------------------------------------------------
APP=/opt/induscost-homolog/app
SERVICE=induscost-homolog.service
DB=teste_bi_homolog
HEALTH=http://127.0.0.1:3001/api/health
BACKUP_ROOT=/var/backups/induscost-homolog/deploys
LOCK=/run/lock/induscost-deploy-homologacao.lock

GIT_REMOTE=origin
DEFAULT_TARGET=origin/main

# --- PostgreSQL 17 (cluster explícito; G7) ---------------------------------------------------------------------------
IDS_PG_HOST=/run/induscost-pg17                            # diretório do socket (conferido contra unix_socket_directories)
IDS_PG_PORT=5433                                           # conferido contra SHOW port
IDS_PG_ADMIN_ROLE=pg17homolog                              # papel administrador (precisa ser superusuário)
IDS_PG_EXPECT_MAJOR=17                                     # conferido contra server_version_num e contra os clientes
IDS_PG_MAINT_DB=postgres                                   # banco de manutenção (conexões administrativas); conferido na conexão
IDS_PG_OS_USER=pg17homolog                                 # usuário do SO do cluster 17 (`runuser -u pg17homolog -- pg_dump`)
IDS_PG_BIN=/opt/postgresql-17/bin                          # psql, pg_dump, pg_restore, createdb do 17 (versão conferida)
# Bancos que a biblioteca jamais toca (nem backup, nem trava, nem rename): os outros do cluster 17 e o do cluster 12.
PROTECTED_DATABASES='teste_bi_homolog_prev teste_bi_cloud_standby teste_bi'

# --- modo do servidor e política de subida -----------------------------------------------------------------------------
MODE_FILE=none                                             # confirmado: não há arquivo de modo
EXPECTED_MODE=none
PRECUTOVER_DROPIN=none                                     # confirmado: sem drop-in de pré-cutover na homologação
PRECUTOVER_EXPECTED=none
START_SERVICE_POLICY=if-was-active                         # decisão do operador: religa só se estava ativo antes do deploy

# --- janela de manutenção seletiva (G1/G8) --------------------------------------------------------------------------------
# Só o que executa em /opt/induscost-homolog é pausado. Linhas de cron com /opt/induscost (legado, crontab do root) NÃO
# casam este caminho: ficam intocadas. A biblioteca recusa (52) se um glob casar algo fora desta instalação.
# Confirmado: a homologação não tem agendamentos próprios hoje. Os globs abaixo casam 0 arquivo/unidade (estado válido:
# a janela só trava o banco) e passam pela validação G8 a cada deploy: se um dia casarem algo, cada item precisa
# executar em /opt/induscost-homolog e nenhum pode ser protegido.
APP_MARK_PATTERN=/opt/induscost-homolog
CRON_GLOB='induscost-homolog*'                             # /etc/cron.d/induscost-homolog* (nenhum hoje)
UNIT_GLOB='induscost-homolog-*'                            # induscost-homolog-*.timer/.service (nenhum hoje); NÃO casa
                                                           # induscost-homolog.service (a aplicação) nem induscost-db-backup.*
# Unidades que nenhum glob pode casar, por nome exato ou padrão (o executor recusa antes de tocar em qualquer coisa):
# backup diário do PostgreSQL 12 e qualquer unidade do PostgreSQL (12 ou 17). Os nomes literais também são conferidos
# contra o UNIT_GLOB sem depender de systemctl (contrato estático).
PROTECTED_UNITS='induscost-db-backup.timer induscost-db-backup.service *postgres* *pg12* *pg17*'

# --- hooks: verificações do executor antigo, versionadas e SOMENTE LEITURA ------------------------------------------------
# infra/deploy/hooks/servidor01-checks.sh, instalado na release (MANIFEST) e referenciado como @release/... Política,
# prazos e códigos: docs/deploy/hooks-servidor01.md. O atualizador /usr/local/bin/update-induscost-homolog-egress
# (altera drop-in e reinicia a homologação) NUNCA é hook: o executor recusa listá-lo; o hook só confere o egress.
HOOKS_PRE_DEPLOY=@release/hooks/servidor01-checks.sh       # antes de parar o serviço; falha = nada alterado (saída 9)
HOOKS_POST_START=@release/hooks/servidor01-checks.sh       # depois do health OK; falha da produção = ALERTA (59, sem rollback)
HOOKS_POST_ROLLBACK=@release/hooks/servidor01-checks.sh    # depois de o rollback subir o serviço; só reporta
HOOKS_POST_START_FAILURE=rollback                          # falha comum (≠ ALERTA) de hook pós-subida: rollback | warn
HOOK_TIMEOUT=300                                           # prazo de cada hook; o hook recusa configuração cujo pior caso não caiba

# Verificações críticas (falha antes do deploy = recusa; depois = ALERTA). Valores confirmados em 29/10/2026.
HOOK_RUNTIME_ROLE_CMD=/usr/local/bin/induscost-runtime-role   # `get` precisa imprimir exatamente HOOK_RUNTIME_ROLE_EXPECTED
HOOK_RUNTIME_ROLE_EXPECTED=CLOUD_PRIMARY
HOOK_NGINX_SERVICE=nginx.service                           # Nginx ativo (gateway)
HOOK_GATEWAY_HEALTH=http://192.168.100.5:3000/api/health
HOOK_AWS_HEALTH=http://100.85.97.124:3000/api/health
HOOK_AWS_APP_DIR=/opt/induscost                            # checkout da produção na AWS (o SSH só roda git rev-parse nele)
# Pendentes: o executor antigo usa estes três, mas o contexto confirmado não traz o valor exato. Inventar seria pior que
# recusar: um destino SSH ou unidade errados dariam uma verificação falsa. Um único comando (só leitura) revela os três:
#   sudo grep -nE 'ssh|induscost-runtime-role|systemctl|is-active' /usr/local/bin/deploy-induscost-homologacao
HOOK_AWS_SSH_TARGET=A_COLETAR                              # destino do `ssh` do executor antigo (usuário@host ou alias do root)
HOOK_LOCAL_PROD_SERVICE=A_COLETAR                          # unidade da produção Node local que precisa estar desligada
HOOK_RUNTIME_ROLE_CHECK_ARGS=A_COLETAR                     # argumentos de `induscost-runtime-role check` no executor antigo;
                                                           # "none" se ele só compara a saída de `get` (já feito acima)

# Terceiros (intermitentes): só avisam por padrão; nenhum CNPJ é consultado (só alcance HTTP e cobertura do egress).
HOOK_CNPJ_URLS='https://brasilapi.com.br/ https://publica.cnpj.ws/'
HOOK_CNPJ_POLICY=warn                                      # warn | fail (fail: recusa antes do deploy, ALERTA depois)
HOOK_PROD_POST_POLICY=alert                                # alert (59, sem rollback) | rollback

# Prazos e novas tentativas (pior caso somado: conferido contra HOOK_TIMEOUT pelo próprio hook).
HOOK_HTTP_ATTEMPTS=3
HOOK_HTTP_TIMEOUT=10
HOOK_RETRY_DELAY=5
HOOK_SSH_ATTEMPTS=2
HOOK_SSH_TIMEOUT=10                                        # ConnectTimeout; o comando remoto tem teto de 2× (20 s)
HOOK_CNPJ_ATTEMPTS=2
HOOK_CNPJ_TIMEOUT=10
HOOK_COMMAND_TIMEOUT=10                                    # pior caso somado com estes valores: 245 s (255 s com `check`)

HEALTH_TRIES=60
HEALTH_INTERVAL=2
