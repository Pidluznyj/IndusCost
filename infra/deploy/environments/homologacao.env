# Ambiente de HOMOLOGAÇÃO (servidor-01) para infra/deploy/induscost-deploy-executor.sh.
# Instalado em /etc/induscost/deploy-executor-homologacao.env (root, 0600) por install-induscost-deploy.sh.
#
# Valores CONFIRMADOS pelo operador em 28/10/2026 (release 4cab35b5 instalado e saudável; executor antigo ativo).
# A_COLETAR = não confirmado: o instalador e o executor recusam até ser preenchido (comandos em infra/deploy/COLETA.md,
# seção Homologação). Nenhum valor abaixo foi deduzido: o que não foi visto está A_COLETAR.
#
# O host tem DOIS clusters PostgreSQL: 12 em 5432 (socket padrão, banco teste_bi, backup diário 22h30 por
# induscost-db-backup.timer) e 17 em 5433 (socket /run/induscost-pg17). Tudo aqui aponta explicitamente para o 17;
# a biblioteca confere versão/porta/socket antes de qualquer ação (G7) e nunca toca os bancos protegidos.

IDS_ENV_NAME=homologacao

# --- executor antigo (substituído pelo wrapper; guardado byte a byte; --uninstall devolve) -----------------------
EXECUTOR_PATH=/usr/local/bin/deploy-induscost-homologacao
EXECUTOR_EXPECTED_SHA256=114c438fb993b1fcef99b04f9f255900a7c008cde3c142a458e26a8fb5697411   # sha256sum do executor antigo
LEGACY_WRAPPER_PATH=/usr/local/bin/induscost-deploy-homologacao    # comando do operador; precisa chamar EXECUTOR_PATH

# --- aplicação ----------------------------------------------------------------------------------------------------
APP=/opt/induscost-homolog/app
SERVICE=induscost-homolog.service
DB=teste_bi_homolog
HEALTH=http://127.0.0.1:3001/api/health
BACKUP_ROOT=/var/backups/induscost-homolog/deploys
LOCK=/run/lock/induscost-deploy-homologacao.lock

GIT_REMOTE=origin
DEFAULT_TARGET=origin/main

# --- PostgreSQL 17 (cluster explícito; G7) ---------------------------------------------------------------------------
IDS_PG_HOST=/run/induscost-pg17                            # diretório do socket (conferido contra unix_socket_directories)
IDS_PG_PORT=5433                                           # conferido contra SHOW port
IDS_PG_ADMIN_ROLE=pg17homolog                              # papel administrador (precisa ser superusuário)
IDS_PG_EXPECT_MAJOR=17                                     # conferido contra server_version_num e contra os clientes
IDS_PG_MAINT_DB=postgres                                   # banco de manutenção (conexões administrativas); conferido na conexão
IDS_PG_OS_USER=A_COLETAR                                   # usuário do SO que roda o cluster 17 e autentica como pg17homolog pelo
                                                           # socket (dono dos backups; `runuser -u <ele> -- pg_dump`). COLETA H5
IDS_PG_BIN=A_COLETAR                                       # diretório dos binários 17 (psql, pg_dump, pg_restore, createdb). COLETA H5
# Bancos que a biblioteca jamais toca (nem backup, nem trava, nem rename): os outros do cluster 17 e o do cluster 12.
PROTECTED_DATABASES='teste_bi_homolog_prev teste_bi_cloud_standby teste_bi'

# --- modo do servidor e política de subida -----------------------------------------------------------------------------
MODE_FILE=A_COLETAR                                        # COLETA H6: ls -l /etc/induscost/; "none" se não existe arquivo de modo
EXPECTED_MODE=A_COLETAR                                    # conteúdo esperado de MODE_FILE, ou "none"
PRECUTOVER_DROPIN=A_COLETAR                                # COLETA H6: drop-ins de induscost-homolog.service.d/; "none" se não se aplica
PRECUTOVER_EXPECTED=A_COLETAR                              # present | absent | none
START_SERVICE_POLICY=A_COLETAR                             # DECISÃO do operador: if-was-active | always (o executor antigo não foi lido)

# --- janela de manutenção seletiva (G1/G8) --------------------------------------------------------------------------------
# Só o que executa em /opt/induscost-homolog é pausado. Linhas de cron com /opt/induscost (legado, crontab do root) NÃO
# casam este caminho: ficam intocadas. A biblioteca recusa (52) se um glob casar algo fora desta instalação.
APP_MARK_PATTERN=/opt/induscost-homolog
CRON_GLOB=A_COLETAR                                        # arquivos de /etc/cron.d SÓ desta homologação. COLETA H3 (ls -l /etc/cron.d)
UNIT_GLOB=A_COLETAR                                        # timers/serviços SÓ desta homologação, SEM sufixo .timer/.service (a
                                                           # biblioteca acrescenta). COLETA H3. NUNCA 'induscost-*': casaria
                                                           # induscost-db-backup.timer. Um único padrão, sem espaços.
# Unidades que nenhum glob pode casar (o executor recusa antes de tocar em qualquer coisa). O timer é fato
# confirmado; o nome do serviço que ele dispara é suposição (conferir com `systemctl show -p Unit
# induscost-db-backup.timer`, COLETA H3) — listar um nome a mais só acrescenta proteção.
PROTECTED_UNITS='induscost-db-backup.timer induscost-db-backup.service'

# --- hooks: o que o executor antigo faz além deste fluxo (saúde da AWS e do gateway, egress, BrasilAPI/cnpj.ws) -------------
# Listas de executáveis (caminho absoluto, do root, não graváveis por outros) separados por espaço, ou "none".
# Os comandos exatos saem do executor antigo (COLETA H1/H7); o executor versionado NÃO altera drop-ins, firewall nem
# egress — isso é dos próprios scripts (ex.: /usr/local/bin/update-induscost-homolog-egress), preservados como estão.
HOOKS_PRE_DEPLOY=A_COLETAR                                 # antes de parar o serviço; falha = nada alterado (saída 9)
HOOKS_POST_START=A_COLETAR                                 # depois do health OK; falha = rollback (HOOKS_POST_START_FAILURE)
HOOKS_POST_ROLLBACK=A_COLETAR                              # depois de o rollback subir o serviço; falha só avisa
HOOKS_POST_START_FAILURE=rollback                          # rollback | warn
HOOK_TIMEOUT=300

HEALTH_TRIES=60
HEALTH_INTERVAL=2
