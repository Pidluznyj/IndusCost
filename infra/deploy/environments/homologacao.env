# Ambiente de HOMOLOGAÇÃO (servidor-01) para infra/deploy/induscost-deploy-executor.sh.
# Instalado em /etc/induscost/deploy-executor-homologacao.env (root, 0600) por install-induscost-deploy.sh.
# O executor real `induscost-deploy-homologacao` NUNCA foi visto: tudo que não está documentado no repositório está
# como A_COLETAR e o executor recusa rodar até ser preenchido (ver infra/deploy/COLETA.md).

IDS_ENV_NAME=homologacao
EXECUTOR_PATH=A_COLETAR                                  # saída de: command -v induscost-deploy-homologacao

APP=/opt/induscost-homolog/app                           # docs/ (caminho da homologação usado nas entregas)
SERVICE=A_COLETAR
DB=teste_bi_homolog
HEALTH=A_COLETAR
BACKUP_ROOT=A_COLETAR
LOCK=/run/lock/induscost-deploy-homologacao.lock

GIT_REMOTE=origin
DEFAULT_TARGET=origin/main

MODE_FILE=A_COLETAR
EXPECTED_MODE=A_COLETAR                                  # "none" se a homologação não usa arquivo de modo
PRECUTOVER_DROPIN=A_COLETAR
PRECUTOVER_EXPECTED=A_COLETAR                            # present | absent | none
START_SERVICE_POLICY=A_COLETAR                           # if-was-active | always

APP_MARK_PATTERN=/opt/induscost-homolog
CRON_GLOB=A_COLETAR                                      # arquivos de /etc/cron.d só desta homologação
UNIT_GLOB=A_COLETAR                                      # timers/serviços só desta homologação

HEALTH_TRIES=60
HEALTH_INTERVAL=2
