# Ambiente de PRODUÇÃO (AWS, induscost-prod-saopaulo) para infra/deploy/induscost-deploy-executor.sh.
# Instalado em /etc/induscost/deploy-executor-producao.env (root, 0600) por install-induscost-deploy.sh.
# Valores conferidos no executor real (/usr/local/bin/deploy-induscost-producao, linhas 1–25 e 350–690 vistas em
# 26/10/2026). A_COLETAR = ainda não confirmado: o executor recusa rodar (ver infra/deploy/COLETA.md).

IDS_ENV_NAME=producao
EXECUTOR_PATH=/usr/local/bin/deploy-induscost-producao   # caminho do executor atual (vira o wrapper)

APP=/opt/induscost                                       # executor real, linha 4
SERVICE=induscost.service                                # linha 5
DB=teste_bi                                              # linha 7
HEALTH=http://127.0.0.1:3000/api/health                  # linha 8
BACKUP_ROOT=/var/backups/induscost-production/deploys    # linha 13
LOCK=/run/lock/deploy-induscost-producao.lock            # linha 14

GIT_REMOTE=origin
DEFAULT_TARGET=origin/main                               # linha 20 (--check usa origin/main)

# Modo do servidor (linhas 10–11). Conteúdo esperado de MODE_FILE e se o drop-in de pré-cutover deve existir.
# Use "none" para não conferir. O que o executor atual FAZ com eles (linhas 25–349) não foi visto.
MODE_FILE=/etc/induscost/deploy-mode
EXPECTED_MODE=A_COLETAR
PRECUTOVER_DROPIN=/etc/systemd/system/induscost.service.d/10-precutover-isolation.conf
PRECUTOVER_EXPECTED=A_COLETAR                            # present | absent | none

# Subir a aplicação ao fim do deploy/rollback: if-was-active (o rollback real só religa se estava ativa, linhas
# 515–522) ou always. Confirmar no trecho de deploy (linhas 620–666).
START_SERVICE_POLICY=A_COLETAR

# Janela de manutenção seletiva: só agendamentos do IndusCost.
APP_MARK_PATTERN=/opt/induscost                          # linhas de crontab fora de /etc/cron.d/induscost* que chamam o app
CRON_GLOB='induscost*'                                   # /etc/cron.d/induscost-production, induscost-nomus-purchase-orders
UNIT_GLOB='induscost-*'                                  # timers/serviços induscost-legal-* (infra/systemd/legal-exposure)

HEALTH_TRIES=60
HEALTH_INTERVAL=2
